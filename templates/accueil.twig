<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Brackito - Logiciel de gestion de tournois sportifs</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --primary-light: rgba(79, 70, 229, 0.1);
            --accent: #764ba2;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --info: #06b6d4;
            --bg-dark: #1f2937;
            --bg-light: #f9fafb;
            --text-muted: #6b7280;
            --border: #e5e7eb;
            --shadow-sm: 0 2px 4px rgba(0,0,0,0.08);
            --shadow-md: 0 4px 16px rgba(0,0,0,0.1);
            --shadow-lg: 0 20px 50px rgba(79,70,229,0.18);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'DM Sans', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* Blobs */
        .bg-blobs { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
        .blob { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.3; animation: floatBlob linear infinite; }
        .blob-1 { width: 600px; height: 600px; background: #818cf8; top: -200px; left: -150px; animation-duration: 20s; }
        .blob-2 { width: 400px; height: 400px; background: #c084fc; bottom: -100px; right: -80px; animation-duration: 25s; animation-direction: reverse; }
        .blob-3 { width: 300px; height: 300px; background: #60a5fa; top: 50%; left: 55%; animation-duration: 17s; }

        @keyframes floatBlob {
            0%   { transform: translate(0,0) scale(1); }
            33%  { transform: translate(40px,-30px) scale(1.05); }
            66%  { transform: translate(-20px,40px) scale(0.95); }
            100% { transform: translate(0,0) scale(1); }
        }

        /* Sport icons */
        .sport-icons { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
        .sport-icon { position: absolute; font-size: 1.4rem; opacity: 0.1; color: white; animation: driftIcon linear infinite; }

        @keyframes driftIcon {
            0%   { transform: translateY(0) rotate(0deg); opacity: 0.07; }
            50%  { opacity: 0.16; }
            100% { transform: translateY(-30px) rotate(20deg); opacity: 0.07; }
        }

        /* Header */
        .site-header {
            position: fixed; top: 0; left: 0; width: 100%; z-index: 100;
            padding: 0 24px; height: 70px; display: flex; align-items: center;
            background: rgba(255,255,255,0.12);
            backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255,255,255,0.2);
            transition: background 0.3s, box-shadow 0.3s;
        }
        .site-header.scrolled { background: rgba(255,255,255,0.97); box-shadow: var(--shadow-md); }
        .site-header.scrolled .header-tagline { color: var(--text-muted); }
        .site-header.scrolled .btn-nav-outline { border-color: var(--primary); color: var(--primary); background: transparent; }
        .site-header.scrolled .btn-nav-outline:hover { background: var(--primary); color: white; }

        .header-inner { display: flex; justify-content: space-between; align-items: center; width: 100%; max-width: 1400px; margin: 0 auto; }

        .header-brand { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; }
        .header-logo { 
        height: 38px; 
        width: auto; 
        filter: drop-shadow(0 2px 6px rgba(0,0,0,0.2)); 
        transition: filter 0.3s; 
        border-radius:5px;
        }
        .site-header.scrolled .header-logo { filter: none; }
        .header-tagline { font-size: 0.68rem; color: rgba(255,255,255,0.8); font-style: italic; letter-spacing: 0.03em; transition: color 0.3s; }

        .header-nav { display: flex; gap: 10px; align-items: center; }

        .btn-nav {
            padding: 9px 18px; border-radius: 10px;
            font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 0.88rem;
            border: none; text-decoration: none; display: inline-flex; align-items: center;
            gap: 7px; transition: all 0.25s ease; cursor: pointer; letter-spacing: 0.02em;
        }
        .btn-nav-outline { border: 2px solid rgba(255,255,255,0.7); background: transparent; color: white; }
        .btn-nav-outline:hover { background: rgba(255,255,255,0.15); color: white; border-color: white; }
        .btn-nav-solid { background: white; color: var(--primary); box-shadow: 0 4px 14px rgba(0,0,0,0.15); }
        .btn-nav-solid:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.2); color: var(--primary); }

        /* Page */
        .page-wrapper { position: relative; z-index: 10; padding-top: 70px; min-height: 100vh; display: flex; align-items: center; }

        /* Hero card */
        .hero-card {
            background: rgba(255,255,255,0.97);
            border-radius: 28px;
            box-shadow: var(--shadow-lg);
            overflow: hidden;
            margin: 24px auto;
            max-width: 1300px;
            width: calc(100% - 32px);
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: 1fr auto;
            min-height: 580px;
            animation: cardIn 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
        }

        @keyframes cardIn {
            from { opacity: 0; transform: translateY(40px) scale(0.97); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* Panneau texte */
        .hero-text {
            padding: 52px 48px;
            display: flex; flex-direction: column; justify-content: center;
            grid-row: 1;
        }

        .hero-eyebrow {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 6px 14px; background: var(--primary-light);
            border-radius: 20px; font-size: 0.78rem; font-weight: 700;
            color: var(--primary); letter-spacing: 0.06em; text-transform: uppercase;
            margin-bottom: 20px; width: fit-content; border: 1px solid rgba(79,70,229,0.2);
        }

        .hero-title {
            font-family: 'Outfit', sans-serif; font-size: 2.5rem; font-weight: 800;
            color: var(--bg-dark); line-height: 1.15; margin-bottom: 14px; letter-spacing: -0.02em;
        }

        .hero-title span {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }

        .hero-subtitle { font-size: 0.98rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 28px; }

        /* Features */
        .features-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 2px; margin-bottom: 32px; }

        .feature-item {
            display: flex; align-items: flex-start; gap: 12px;
            padding: 9px 10px; border-radius: 10px; transition: background 0.2s;
        }
        .feature-item:hover { background: var(--bg-light); }

        .feature-icon-wrap {
            width: 30px; height: 30px; border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 0.85rem; flex-shrink: 0; margin-top: 1px;
        }

        .fi-primary { background: rgba(79,70,229,0.1);   color: var(--primary); }
        .fi-success { background: rgba(16,185,129,0.1);  color: var(--success); }
        .fi-warning { background: rgba(245,158,11,0.1);  color: var(--warning); }
        .fi-danger  { background: rgba(239,68,68,0.1);   color: var(--danger); }
        .fi-info    { background: rgba(6,182,212,0.1);   color: var(--info); }
        .fi-gray    { background: rgba(107,114,128,0.1); color: var(--text-muted); }

        .feature-text { font-size: 0.9rem; color: var(--bg-dark); line-height: 1.4; padding-top: 5px; }

        /* CTA */
        .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; }

        .btn-cta-primary {
            padding: 14px 28px; border-radius: 12px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: white; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 0.95rem;
            border: none; text-decoration: none; display: inline-flex; align-items: center;
            gap: 9px; cursor: pointer; box-shadow: 0 6px 20px rgba(79,70,229,0.35);
            transition: all 0.3s; position: relative; overflow: hidden;
        }
        .btn-cta-primary::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(255,255,255,0.15), transparent); opacity: 0; transition: opacity 0.3s; }
        .btn-cta-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(79,70,229,0.45); color: white; }
        .btn-cta-primary:hover::before { opacity: 1; }

        .btn-cta-outline {
            padding: 14px 24px; border-radius: 12px; border: 2px solid var(--border);
            background: white; color: var(--bg-dark); font-family: 'Outfit', sans-serif;
            font-weight: 700; font-size: 0.95rem; text-decoration: none;
            display: inline-flex; align-items: center; gap: 9px; transition: all 0.25s;
        }
        .btn-cta-outline:hover { border-color: var(--primary); color: var(--primary); transform: translateY(-2px); }

        /* Panneau vidéo */
        .hero-media { position: relative; overflow: hidden; grid-row: 1; }
        .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
        .media-overlay { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(79,70,229,0.2) 0%, rgba(118,75,162,0.3) 100%); z-index: 1; }

        .media-logo {
            position: absolute; top: 20px; right: 20px; width: 88px; z-index: 3;
            filter: drop-shadow(0 4px 12px rgba(0,0,0,0.3));
            animation: cardIn 1s ease both;
            
        }

        .media-badge {
            position: absolute; top: 20px; left: 20px;
            background: rgba(255,255,255,0.15); backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.3); border-radius: 20px;
            padding: 6px 14px; font-size: 0.75rem; font-weight: 700; color: white;
            display: flex; align-items: center; gap: 6px; z-index: 3;
        }

        .media-caption {
            position: absolute; bottom: 24px; left: 20px; right: 20px;
            background: rgba(255,255,255,0.95); backdrop-filter: blur(10px);
            padding: 14px 18px; border-radius: 14px; box-shadow: var(--shadow-md);
            z-index: 3; font-size: 0.83rem; color: var(--bg-dark); line-height: 1.5;
            border-left: 3px solid var(--primary);
            animation: slideUp 1.2s ease both;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* Footer card */
        .hero-footer {
            grid-column: 1 / -1; grid-row: 2;
            background: var(--bg-light); border-top: 1px solid var(--border);
            padding: 16px 48px; display: flex; align-items: center;
            justify-content: space-between; flex-wrap: wrap; gap: 12px;
        }

        .footer-stats { display: flex; gap: 28px; flex-wrap: wrap; }

        .stat-item { display: flex; align-items: center; gap: 8px; font-size: 0.82rem; color: var(--text-muted); font-weight: 500; }
        .stat-item i { color: var(--primary); }

        .footer-brand { font-size: 0.78rem; color: var(--text-muted); font-weight: 500; }

        /* Mobile */
        @media (max-width: 767px) {
            .hero-card { grid-template-columns: 1fr; width: calc(100% - 24px); margin: 12px auto; border-radius: 20px; }
            .hero-text { padding: 30px 22px 22px; grid-row: 1; }
            .hero-title { font-size: 1.75rem; }
            .hero-media { min-height: 250px; grid-row: 2; border-radius: 0; }
            .hero-footer { grid-row: 3; padding: 14px 22px; flex-direction: column; align-items: flex-start; }
            .footer-stats { gap: 12px; }
            .site-header { padding: 0 14px; }
            .btn-nav span { display: none; }
            .btn-nav { padding: 9px 13px; }
        }

        @media (max-width: 480px) {
            .hero-title { font-size: 1.55rem; }
            .hero-cta { flex-direction: column; }
            .btn-cta-primary, .btn-cta-outline { justify-content: center; }
        }
    </style>
</head>
<body>

    <div class="bg-blobs">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>
    </div>

    <div class="sport-icons" aria-hidden="true">
        <i class="fas fa-futbol sport-icon"          style="top:10%; left:8%;  animation-duration:6s;  animation-delay:0s;"></i>
        <i class="fas fa-basketball sport-icon"      style="top:25%; left:90%; animation-duration:8s;  animation-delay:1s;"></i>
        <i class="fas fa-volleyball sport-icon"      style="top:60%; left:5%;  animation-duration:7s;  animation-delay:2s;"></i>
        <i class="fas fa-trophy sport-icon"          style="top:75%; left:85%; animation-duration:9s;  animation-delay:0.5s;"></i>
        <i class="fas fa-medal sport-icon"           style="top:5%;  left:55%; animation-duration:5s;  animation-delay:3s;"></i>
        <i class="fas fa-flag-checkered sport-icon"  style="top:85%; left:40%; animation-duration:10s; animation-delay:1.5s;"></i>
        <i class="fas fa-stopwatch sport-icon"       style="top:45%; left:92%; animation-duration:7s;  animation-delay:4s;"></i>
        <i class="fas fa-star sport-icon"            style="top:50%; left:2%;  animation-duration:11s; animation-delay:2.5s;"></i>
        <i class="fas fa-shield-halved sport-icon"   style="top:88%; left:15%; animation-duration:6s;  animation-delay:0.8s;"></i>
        <i class="fas fa-ranking-star sport-icon"    style="top:15%; left:75%; animation-duration:9s;  animation-delay:3.5s;"></i>
    </div>

    <!-- Header -->
    <header class="site-header" id="siteHeader">
        <div class="header-inner">
            <div class="header-brand">
                <img src="logos/Logo.png" alt="Brackito" class="header-logo">
                <span class="header-tagline">The french brackets software</span>
            </div>
            <nav class="header-nav">
                <a href="register.php" class="btn-nav btn-nav-outline">
                    <i class="fas fa-user-plus"></i>
                    <span>{{t('inscription')}}</span>
                </a>
                <a href="Auth/" class="btn-nav btn-nav-solid">
                    <i class="fas fa-arrow-right-to-bracket"></i>
                    <span>{{t('login')}}</span>
                </a>
            </nav>
        </div>
    </header>

    <div class="page-wrapper">
        <div class="hero-card">

            <!-- Texte -->
            <div class="hero-text">
                <div class="hero-eyebrow">
                    <i class="fas fa-trophy"></i>
                    Gestion de tournois sportifs
                </div>

                <h1 class="hero-title">{{t('titreIndex')}}</h1>

                <p class="hero-subtitle">{{t('sousTitreIndex')}}</p>

                <ul class="features-list">
                    <li class="feature-item">
                        <div class="feature-icon-wrap fi-primary"><i class="fas fa-users-gear"></i></div>
                        <span class="feature-text">{{t('indexCreationDePoules')}}</span>
                    </li>
                    <li class="feature-item">
                        <div class="feature-icon-wrap fi-success"><i class="fas fa-calendar-check"></i></div>
                        <span class="feature-text">{{t('indexPlanification')}}</span>
                    </li>
                    <li class="feature-item">
                        <div class="feature-icon-wrap fi-success"><i class="fas fa-wand-magic-sparkles"></i></div>
                        <span class="feature-text">{{t('indexPlacementAutomatique')}}</span>
                    </li>
                    <li class="feature-item">
                        <div class="feature-icon-wrap fi-warning"><i class="fas fa-trophy"></i></div>
                        <span class="feature-text">{{t('indexSuivi')}}</span>
                    </li>
                    <li class="feature-item">
                        <div class="feature-icon-wrap fi-danger"><i class="fas fa-user-slash"></i></div>
                        <span class="feature-text">{{t('indexGestionDesAbsences')}}</span>
                    </li>
                    <li class="feature-item">
                        <div class="feature-icon-wrap fi-info"><i class="fas fa-mobile-screen-button"></i></div>
                        <span class="feature-text">{{t('indexInterfaceMobile')}}</span>
                    </li>
                    <li class="feature-item">
                        <div class="feature-icon-wrap fi-warning">🤝</div>
                        <span class="feature-text">{{t('indexGestionDesPartenaires')}}</span>
                    </li>
                    <li class="feature-item">
                        <div class="feature-icon-wrap fi-gray"><i class="fas fa-layer-group"></i></div>
                        <span class="feature-text">{{t('indexGestionCategories')}}</span>
                    </li>
                    <li class="feature-item">
                        <div class="feature-icon-wrap fi-primary"><i class="fas fa-circle-info"></i></div>
                        <span class="feature-text"><strong>{{t('indexTypePoule')}}</strong></span>
                    </li>
                </ul>

                <div class="hero-cta">
                    <a href="Auth/" class="btn-cta-primary">
                        <i class="fas fa-arrow-right-to-bracket"></i>
                        {{t('login')}}
                    </a>
                    <a href="register.php" class="btn-cta-outline">
                        <i class="fas fa-user-plus"></i>
                        {{t('inscription')}}
                    </a>
                </div>
            </div>

            <!-- Vidéo -->
            <div class="hero-media">
                <video autoplay muted loop playsinline
                       poster="videos/HBCAT_Tournoi_herbe.jpg"
                       class="hero-video">
                    <source src="videos/HBCAT_Tournoi_herbe.webm" type="video/webm">
                    <source src="videos/HBCAT_Tournoi_herbe_web.mp4" type="video/mp4">
                </video>

                <div class="media-overlay"></div>

                

                <img src="logos/Logo.png" class="media-logo" alt="Brackito">

                <div class="media-caption">
                    <i class="fas fa-quote-left" style="color: var(--primary); margin-right: 6px; font-size: 0.75rem;"></i>
                    {{t('indexCaptionVideo1')}}
                </div>
            </div>

            <!-- Footer -->
            <div class="hero-footer">
                <div class="footer-stats">
                    <div class="stat-item"><i class="fas fa-shield-halved"></i> Logiciel 100% français</div>
                    <div class="stat-item"><i class="fas fa-mobile-screen-button"></i> Compatible mobile</div>
                    <div class="stat-item"><i class="fas fa-bolt"></i> Temps réel</div>
                    <div class="stat-item"><i class="fas fa-euro-sign"></i> Gratuit pour commencer</div>
                </div>
                <div class="footer-brand">
                    <i class="fas fa-trophy" style="color: #f59e0b; margin-right: 4px;"></i>
                    Brackito &mdash; Gestion de tournois sportifs
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const header = document.getElementById('siteHeader');
        window.addEventListener('scroll', () => {
            header.classList.toggle('scrolled', window.scrollY > 20);
        });
    </script>
</body>
</html>