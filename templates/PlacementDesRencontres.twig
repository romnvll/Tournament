<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Placez vos rencontres</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    
    <script src="https://unpkg.com/htmx.org@1.9.12" integrity="sha384-ujb1lZYygJmzgSwoxRggbCHcjc0rB2XoQrxeTUQyRjrOnlCoYta87iKBWq3EsdM2" crossorigin="anonymous"></script>
  

  
  

    <style>
        .hidden {
            display: none;
        }
        #filter-input {
            position: fixed;
            top: 10px;
            right: 10px;
            padding: 5px;
            z-index: 1000;
            width: 150px;
            font-size: 12px;
        }

   select {
  /* Style du bouton select */
}
select::picker-icon {
  /* Pseudo élément représentant la flêche */
}
select::picker(select) {
   opacity: 0;
  transform: translateY(-10px);
  transition: all 0.4s allow-discrete;
}
option::checkmark {
  /* Coche à gauche des options */
}

    </style>






</head>




<body>
    {{ include('header.twig') }}
    <div class="row ml-n4">
        <div class="col-lg-3">
            {% for tournoi in ListeDesTournois %}
            {% if tournoi.isArchived == 0 %}
            {% if tournoi.id == idTournoi %}
            <a href="PlacementDesRencontres.php?id_tournoi={{ tournoi.id }}" class="btn btn-success btn-sm">{{ tournoi.nom }}</a>
            {% else %}
            <a href="PlacementDesRencontres.php?id_tournoi={{ tournoi.id }}" class="btn btn-secondary">{{ tournoi.nom }}</a>
            {% endif %}
            {% endif %}
            {% endfor %}
        </div>
        <div class="col-lg-12">
            <div class="container my-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <form method="post" action="PlacementDesRencontresTraitement.php" class="d-flex align-items-center flex-wrap gap-3">
                            <!-- Retarder les rencontres -->
                            <div class="d-flex align-items-center">
                                <label for="modifMinutes" class="form-label mb-0 me-2">Retarder les rencontres :</label>
                                <input
                                    type="number"
                                    
                                    id="modifMinutes"
                                    class="form-control"
                                    name="modifMinutes"
                                    onfocusout="this.form.submit()"
                                    placeholder="Minutes"
                                    style="width: 100px;">
                            </div>

                            <!-- Ajuster le pas horaire -->
                            <div class="d-flex align-items-center">
                                <label for="modifPasHoraire" class="form-label mb-0 me-2">Durée des rencontres :</label>
                                <input
                                    type="number"
                                    min="0"
                                    id="modifPasHoraire"
                                    name="modifPasHoraire"
                                    value="{{tournoiInfo['pasHoraire']}}"
                                    class="form-control"
                                    onchange="this.form.submit()"
                                    style="width: 100px;">
                            </div>

                            <!-- Heure de début (lecture seule) -->
                            <div class="d-flex align-items-center">
                                <input type="hidden" name="modifHeureDebut" value="{{tournoiInfo['heure_debut']}}">
                            </div>

                            <!-- Bouton de soumission -->
                            <div>
                                <input type="hidden" name="idTournoi" value="{{idTournoi}}">
                            </div>

                            <!-- Informations sur les rencontres -->
                            <div class="d-flex align-items-center mt-3 gap-4">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-calendar-check me-2 text-info"></i>
                                    <span><strong>Planifiées :</strong> {{ nombreDeRencontresPlanifiee }}</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-list-ol me-2 text-success"></i>
                                    <span><strong>Total :</strong> {{ nombreRencontreAPlanifier }}</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-exclamation-circle me-2 text-warning"></i>
                                    <span><strong>Restantes :</strong> {{ nombreRencontreAPlanifier - nombreDeRencontresPlanifiee }}</span>
                                </div>

                                <div class="d-flex align-items-center">
    <a href="#"
       data-bs-toggle="tooltip"
       data-bs-placement="top"
       title="Le temps estimé est calculé en multipliant le nombre de rencontres à planifier par le pas horaire du tournoi et le tout divisé par le nombre de terrain">
        <i class="bi bi-clock me-2 text-info"></i>
    </a>
    <span><strong>Temps estimé :</strong>
        {% set timeInMinutes = (nombreRencontreAPlanifier * tournoiInfo.pasHoraire) / terrains|length %}
        {% set hours = timeInMinutes // 60 %}
        {% set minutes = timeInMinutes % 60 %}
        {{ hours }} heures {{ minutes }} minutes
    </span>
</div>


                                <div class="d-flex align-items-center">
                                    <i class="bi bi-info-circle-fill me-2 text-info"></i>
                                    <span><strong><a href="GererLabels.php?id_tournoi={{idTournoi}}">Labels :</a></strong> {{nombreDeLabel | length}}</span>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <table class="table ms-1" id="planification-table">
            <thead>
                <tr>
                    <th scope="col">Heure des rencontres</th>
                                        {% for i in 0..terrains|length - 1 %}
                     <th scope="col" class="sticky-top bg-white" style="z-index: 1;">
                        <form id="terrain{{i}}">
                            <input type="hidden" name="terrain_id" value="{{terrains[i]['terrain_id']}}">
                            <input type="text" class="form-control form-control-sm" value="{{terrains[i]['nom']}}" name="nomTerrain" size="2"
                                hx-post="PlacementDesRencontresTraitement.php"
                                hx-trigger="change"
                                hx-include="#terrain{{i}} [name='terrain_id'], #terrain{{i}} [name='nomTerrain']"
                            >
                            <a href="PlacementDesRencontresTraitement.php?action=delTerrain&terrain_id={{terrains[i]['terrain_id']}}&idTournoi={{idTournoi}}">
                                <p class="text-danger"><i class="fa fa-minus-circle" aria-hidden="true"></i></p>
                            </a>
                        </form>
                    </th>

                    {% endfor %}
                    <th scope="col"><a href="PlacementDesRencontresTraitement.php?action=addTerrain&idTournoi={{idTournoi}}"><h2><p class="text-success"><i class="fa fa-plus-circle" aria-hidden="true"></i></p></h2></a></th>
                </tr>
            </thead>
            <tbody>
                {% for creneau in listCreneaux %}
                <tr>
                    <td class="col-md-1 ">
                    
                        <div class="input-group flex-nowrap">
                            <span class="input-group-text" id="addon-wrapping">
                                <a href="PlacementDesRencontresTraitement.php?action=delCreneau&creneauId={{creneau.creneau_id}}"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="Supprimer ce créneau (il doit être vide)">
                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                </a>
                            </span>
                            <input type="text" name="creneau" class="form-control"
                                   value="{{ creneau.nom|slice(0, -3) }}" size="5"
                                   hx-post="PlacementDesRencontresTraitement.php"
                                   hx-trigger="change"
                                   hx-target="this"
                                   hx-vals='{"creneau_id": "{{ creneau.creneau_id }}", "action": "updateCreneau"}'
                                   pattern="^([01]\d|2[0-3]):[0-5]\d$"
                                   title="Veuillez entrer une heure au format HH:MM (par exemple, 09:12 ou 14:30)."
                            >
                        </div>
                        <!--<form action="PlacementDesRencontresTraitement.php" method="post" name="VerticalPlacement">
                         
                        <select name="idCategorie" class="form-select form-select-sm">

                        {% for Categorie in listeCategorie %}
                        <option value="{{ Categorie.id_categorie }}">{{ Categorie.Nom_categorie }}</option>
                            
                        {% endfor %}
                        </select>
                        <input type="hidden" name="idCreneau" value="{{ creneau.creneau_id }}">
                        <input type="submit" class="btn btn-primary btn-sm" value="VerticalPlacement">
                        
                        </form>
                        -->
                    </td>
                    {% set Displayed = false %}
                    {% for j in 0..terrains|length - 1 %}
                    <td id="planif-{{ terrains[j]['terrain_id'] }}-{{ creneau.creneau_id }}">

                    
                        {% set planificationFound = false %}
                        {% set creneauOqp = false %}
                        {% for planification in afficherPlanification %}
                            {% if planification.terrain_id == terrains[j]['terrain_id'] and planification.creneau_id == creneau.creneau_id  %}
                                {% set planificationFound = true %}
                                {% if planification.rencontre_id is not null or planification.arbitre_id is not null   %}
                                    {% if planification.arbitre_id is not null and  tournoiInfo.gestionArbitres == 1 %}
                                       <i class="fas fa-user-tie"></i> <i class="material-icons me-2" style="font-size: 20px;">sports</i> {{planification.arbitre_nom}} {{planification.club_nom_arbitre}}
                                        <a href="PlacementDesRencontresTraitement.php?action=noPlanifEvent&event={{ planification.planification_id }}&arbitre_id={{planification.arbitre_id}}&tournoi_id={{idTournoi}}#planif-{{ terrains[j]['terrain_id'] }}-{{ creneau.creneau_id }}" >
                                            <p class="text-danger"><i class="fa fa-calendar" aria-hidden="true"></i></p>
                                        </a>
                                    {% else %}
                                   {% if tournoiInfo.gestionArbitres == 1 %}
                                       <form action="PlacementDesRencontresTraitement.php" method="post" class="arbitreForm">
                                            <select class="form-select"  name="Addevent" id="listeArbitre">
                                             <option value="">Choisir arbitre</option>
                                                {% for arbitre in listeDesArbitres %}
                                                <option value='{"idterrain":"{{terrains[j]['terrain_id']}}","idcreneau":"{{creneau.creneau_id}}","idarbitre":"{{arbitre.arbitre_id}}","idtournoi":"{{idTournoi}}"}' >
                                                   {% if arbitre.nom is not empty %} Arbitre: {{arbitre.nom}} ({{arbitre.nombre_matchs}}) {% endif %}  Club: {{arbitre.club_nom}} ({{arbitre.nombre_matchs_club}})
                                                </option>
                                                {% endfor %}
                                            </select>
                                        </form>
                                     {% endif %}
                                    {% endif %}
                                    {% if planification.rencontre_id is not null %}
                                        {% if planification.isClassement == 0 %}
                                            <p class="card-text">tour{{planification.tour}}-{{planification.equipe1_categorie_nom}}-{{planification.equipe1_nom_categorie}}{{planification.equipe1_nom}} vs {{planification.equipe2_nom}} -  {{ planification.equipe2_poule_noms|split(' - ')[1] }}  </p>
                                        {% elseif planification.isClassement == 1 %}
                                            <p class="card-text"><i class="fa fa-trophy" aria-hidden="true"></i> PF-tour{{planification.tour}}-{{planification.equipe1_categorie_nom}}-{{planification.equipe1_nom_categorie}}{{planification.equipe1_nom}} vs {{planification.equipe2_nom}} - {{ planification.equipe2_poule_noms|split(',')[0] }} </p>
                                        {% endif %}
                                        <a href="PlacementDesRencontresTraitement.php?action=noPlanifEvent&event={{ planification.planification_id }}&tournoi_id={{idTournoi}}&rencontreId={{planification.rencontre_id}}#planif-{{ terrains[j]['terrain_id'] }}-{{ creneau.creneau_id }}" >
                                            <p class="text-danger"><i class="fa fa-calendar" aria-hidden="true"></i></p>
                                        </a>
                                        {% set creneauOqp = true %}
                                    {% endif %}
                                    <script>
                                        var tdElement = document.currentScript.parentElement;
                                        var backgroundColor = '{{ planification.equipe1_categorie_couleur }}';
                                        tdElement.style.backgroundColor = backgroundColor;
                                    </script>
                                {% elseif planification.label_id is not null %}
                                    <script>
                                        var tdElement = document.currentScript.parentElement;
                                        var backgroundColor = '{{ planification.label_couleur }}';
                                        tdElement.style.backgroundColor = backgroundColor;
                                    </script>
                                    <a href="PlacementDesRencontresTraitement.php?action=noPlanifEvent&event={{ planification.planification_id }}&tournoi_id={{idTournoi}}#planif-{{ terrains[j]['terrain_id'] }}-{{ creneau.creneau_id }}">
                                        <p class="text-danger"><i class="fa fa-calendar" aria-hidden="true"></i></p>
                                    </a>
                                    <p class="text-light">{{ planification.label_description }}</p>
                                    {% set creneauOqp = true %}
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                        {% if creneauOqp == false %}
                            <form action="PlacementDesRencontresTraitement.php" method="post" class="rencontreLabel" >
                           
                                <select class="form-select basic"   name="Addevent" >
                                    <option value="">Choisir une rencontre ou un label</option>
                                    {% for planif in planificationSansCreneauNiTerrain %}
                                        {% if planif.isClassement == 0 %}
                                            <option value='{"idterrain":"{{terrains[j]['terrain_id']}}","idcreneau":"{{creneau.creneau_id}}","idrencontre":"{{planif.id}}","idtournoi":"{{idTournoi}}"}'>tour{{planif.tour}}-{{ planif.equipe1_categorie_nom }} {{planif.equipe1_nom}} vs {{planif.equipe2_nom}}  {{ planif.equipe1_poule_nom|split(' - ')[1] }} </option>
                                        {% elseif planif.isClassement == 1 %}
                                            <option value='{"idterrain":"{{terrains[j]['terrain_id']}}","idcreneau":"{{creneau.creneau_id}}","idrencontre":"{{planif.id}}","idtournoi":"{{idTournoi}}"}'>PF-tour{{planif.tour}}-{{ planif.equipe1_categorie_nom }} {{planif.equipe1_nom}} vs {{planif.equipe2_nom}} {{ planif.equipe1_poule_nom }} </option>
                                        {% endif %}
                                    {% endfor %}
                                    {% for label in libelleParTournoi %}
                                        <option value='{"idlabel":"{{label.label_id}}","idterrain":"{{terrains[j]['terrain_id']}}","idcreneau":"{{creneau.creneau_id}}","idtournoi":"{{idTournoi}}"}'>Label: {{label.description}}</option>
                                    {% endfor %}
                                </select>
                            </form>
                        {% endif %}
                    </td>
                    {% endfor %}
                </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <td>
                    <a id="add-creneau-link"
                       href="PlacementDesRencontresTraitement.php?action=addCreneau&idTournoi={{idTournoi}}&startTime={{lastCreneau['nom']|slice(0, -3)}}&newTime={{timeNextCreneau}}"
                    >
                        <h2><p class="text-success"><i class="fa fa-plus-circle" aria-hidden="true"></i></p></h2>
                    </a>
                    <span id="bottom"></span>
                </td>
            </tfoot>
        </table>
    </div>
    <input type="text" id="filter-input" placeholder="Filtrer...">





    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const filterInput = document.getElementById('filter-input');
            const storedFilter = localStorage.getItem('filterValue');
            if (storedFilter) {
                filterInput.value = storedFilter;
                filterOptions(storedFilter.toLowerCase());
            }

            filterInput.addEventListener('input', function() {
                const filter = this.value.toLowerCase();
                localStorage.setItem('filterValue', this.value);
                filterOptions(filter);
            });
        });

        function filterOptions(filter) {
            const selects = document.querySelectorAll('select');
            selects.forEach(select => {
                const options = select.querySelectorAll('option');
                options.forEach(option => {
                    if (option.text.toLowerCase().includes(filter)) {
                        option.classList.remove('hidden');
                    } else {
                        option.classList.add('hidden');
                    }
                });
            });
        }
    </script>

    <script>
        $(document).ready(function() {
            $('.rencontreLabel .form-select').on('change', function() {
                var $form = $(this).closest('form');
                var formAction = $form.attr('action');
                var formData = $form.serialize();

                $.post(formAction, formData, function() {
                    location.reload();
                });
            });
        });



           $(document).ready(function() {
        $('.arbitreForm .form-select').on('change', function() {
            var $form = $(this).closest('form');
            var formAction = $form.attr('action');
            var formData = $form.serialize();

            $.post(formAction, formData, function() {
                location.reload();
            });
        });
    });
    </script>

    <script>
        document.querySelectorAll('input[name="creneau"]').forEach(function(input) {
            input.addEventListener('input', function(e) {
                const value = e.target.value;
                const regex = /^([01]\d|2[0-3]):[0-5]\d$/;
                if (!regex.test(value) && value.length >= 5) {
                    alert('Please enter a valid time in HH:MM format (e.g., 09:12 or 14:30).');
                    e.target.value = value.slice(0, -1);
                }
            });
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            console.log("DOM fully loaded and parsed");
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            console.log("Tooltip elements:", tooltipTriggerList);
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                console.log("Initializing tooltip for element:", tooltipTriggerEl);
                return new bootstrap.Tooltip(tooltipTriggerEl)
            })
        });
    </script>





    <script src="https://stackpath.bootstrapcdn.com/bootstrap/5.1.3/js/bootstrap.bundle.min.js"></script>
</body>
</html>

