<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous" />
  <!-- Inclure la bibliothèque htmx via CDN -->
  <script src="https://unpkg.com/htmx.org@latest/dist/htmx.min.js"></script>

  <title>Gestion rencontre</title>
  <style>
    .card {
      /* Ajout d'une ombre pour l'effet de relief */
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      transition: box-shadow 0.3s ease-in-out;
    }

    .card:hover {
      /* Ombre plus marquée au survol pour un effet interactif */
      box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
    }
  </style>
</head>

<body>

  {{ include('header.twig') }}

  <div class="container-fluid">
    <div class="row justify-content-center">
      <div class="col-lg-6">
        <div class="card mt-5">
          <div class="card-header text-center">
            <h3>Créer un club</h3>
          </div>
          <div class="card-body">
            <form action="creerClub_traitement.php" method="POST" enctype="multipart/form-data">

              <div class="mb-3">
                <label for="nomduclub" class="form-label">Nom du club</label>
                <input type="text" class="form-control" id="nomduclub" name="nomduclub" required />
                <div id="nomduclub" class="form-text">Nom du club</div>
              </div>

              <div class="mb-3">
                <label for="contactClub" class="form-label">Contact</label>
                <input type="email" class="form-control" id="contactClub" name="contactClub" />
                <div id="contactClub" class="form-text"> (optionnel)</div>
              </div>

              <div class="mb-3">
                <label for="logo" class="form-label">Choisir un logo</label>
                <input type="file" name="logo" accept="image/png, image/jpeg" class="form-control" />
              </div>

              <button type="submit" class="btn btn-primary w-100">
                <i class="fas fa-check me-2"></i> Soumettre
              </button>

            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

</body>

</html>
