<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>

<style>
    :root {
        --primary-color: #4f46e5;
        --primary-hover: #4338ca;
        --bg-dark: #1f2937;
        --bg-darker: #111827;
        --text-light: #e5e7eb;
        --shadow-lg: 0 10px 25px rgba(0,0,0,0.3);
        --shadow-md: 0 4px 6px rgba(0,0,0,0.2);
    }

    /* Navbar moderne */
    .navbar-modern {
        background: linear-gradient(135deg, var(--bg-dark), var(--bg-darker)) !important;
        box-shadow: var(--shadow-lg);
        padding: 1rem 0;
        border-bottom: 3px solid var(--primary-color);
    }

    .navbar-brand-modern {
        font-size: 1.5rem;
        font-weight: 700;
        color: white !important;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s;
    }

    .navbar-brand-modern:hover {
        transform: scale(1.05);
        color: var(--primary-color) !important;
    }

    /* Toggler moderne */
    .navbar-toggler-modern {
        border: 2px solid rgba(255,255,255,0.3);
        border-radius: 8px;
        padding: 8px 12px;
        transition: all 0.3s;
    }

    .navbar-toggler-modern:hover {
        border-color: var(--primary-color);
        background: rgba(79, 70, 229, 0.1);
    }

    .navbar-toggler-modern:focus {
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.3);
    }

    /* Nav items */
    .nav-item-modern {
        margin: 0 5px;
    }

    .nav-link-modern {
        color: var(--text-light) !important;
        font-weight: 600;
        padding: 10px 18px !important;
        border-radius: 8px;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        gap: 8px;
        position: relative;
    }

    .nav-link-modern::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 0;
        height: 3px;
        background: var(--primary-color);
        transition: all 0.3s;
        transform: translateX(-50%);
    }

    .nav-link-modern:hover {
        background: rgba(79, 70, 229, 0.2);
        color: white !important;
        transform: translateY(-2px);
    }

    .nav-link-modern:hover::after {
        width: 80%;
    }

    .nav-link-modern.active {
        background: linear-gradient(135deg, var(--primary-color), var(--primary-hover));
        color: white !important;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.4);
    }

    .nav-link-modern i {
        font-size: 1.1rem;
    }

    /* Dropdown moderne */
    .dropdown-menu-modern {
        background: white;
        border: none;
        border-radius: 12px;
        box-shadow: var(--shadow-lg);
        padding: 8px;
        margin-top: 8px;
        min-width: 280px;
        animation: dropdownFadeIn 0.3s ease;
    }

    @keyframes dropdownFadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .dropdown-item-modern {
        color: var(--bg-dark);
        padding: 12px 16px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 4px;
    }

    .dropdown-item-modern i {
        width: 20px;
        text-align: center;
        color: var(--primary-color);
        font-size: 1.1rem;
    }

    .dropdown-item-modern:hover {
        background: linear-gradient(135deg, rgba(79, 70, 229, 0.1), rgba(79, 70, 229, 0.05));
        color: var(--primary-color);
        transform: translateX(5px);
    }

    .dropdown-divider-modern {
        border-top: 2px solid #e5e7eb;
        margin: 8px 0;
    }

    /* Badge pour les numéros d'étapes */
    .step-badge {
        background: linear-gradient(135deg, var(--primary-color), var(--primary-hover));
        color: white;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 700;
        margin-left: auto;
    }

    /* Eye icon spécial */
    .view-link {
        background: rgba(79, 70, 229, 0.2);
        border: 2px solid var(--primary-color);
        padding: 8px 12px !important;
        border-radius: 50%;
        transition: all 0.3s;
    }

    .view-link:hover {
        background: var(--primary-color);
        transform: rotate(15deg) scale(1.1);
    }

    .view-link i {
        font-size: 1.2rem;
    }

    /* User dropdown */
    .user-dropdown {
        background: rgba(79, 70, 229, 0.15);
        border: 2px solid rgba(79, 70, 229, 0.3);
        padding: 8px 16px !important;
        border-radius: 25px;
        transition: all 0.3s;
    }

    .user-dropdown:hover {
        background: rgba(79, 70, 229, 0.3);
        border-color: var(--primary-color);
        transform: translateY(-2px);
    }

    /* Responsive mobile */
    @media (max-width: 768px) {
        .navbar-nav {
            padding: 15px 0;
        }

        .nav-item-modern {
            margin: 5px 0;
        }

        .nav-link-modern {
            padding: 12px 20px !important;
        }

        .dropdown-menu-modern {
            margin-top: 5px;
            border-radius: 8px;
        }

        .view-link {
            border-radius: 8px;
            padding: 10px 15px !important;
        }
    }

    /* Animation pour le toggler */
    @keyframes pulse {
        0%, 100% {
            opacity: 1;
        }
        50% {
            opacity: 0.7;
        }
    }

    .navbar-toggler-icon {
        animation: pulse 2s infinite;
    }

    /* Dropdown toggle arrow */
    .dropdown-toggle-modern::after {
        margin-left: 8px;
        transition: transform 0.3s;
    }

    .dropdown-toggle-modern[aria-expanded="true"]::after {
        transform: rotate(180deg);
    }

    /* Hover effect for main menu items */
    .nav-item-modern:hover .nav-link-modern {
        color: white !important;
    }
</style>

