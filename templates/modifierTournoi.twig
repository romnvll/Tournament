    <script>
        window.onload = function() {
            if (typeof(sessionStorage) !== 'undefined') {
                var scrollPosition = sessionStorage.getItem('scrollPosition');
                if (scrollPosition !== null) {
                    window.scrollTo(0, scrollPosition);
                }
            }
        };

        window.onbeforeunload = function() {
            if (typeof(sessionStorage) !== 'undefined') {
                sessionStorage.setItem('scrollPosition', window.scrollY);
            }
        };
    </script>

    <script>
        document.getElementById('filtreNom')?.addEventListener('keyup', function () {
            const filtre = this.value.toLowerCase();
            const lignes = document.querySelectorAll('#placementPersonneSurTerrain tbody tr');

            lignes.forEach(function (ligne) {
                const nom = ligne.querySelector('td:nth-child(1)').textContent.toLowerCase();
                ligne.style.display = nom.includes(filtre) ? '' : 'none';
            });
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const params = new URLSearchParams(window.location.search);
            const status = params.get('status');
            if (status === 'success') {
                const successToast = new bootstrap.Toast(document.getElementById('mailToast'));
                successToast.show();
            } else if (status === 'error') {
                const errorToast = new bootstrap.Toast(document.getElementById('errorToast'));
                errorToast.show();
            }
        });
    </script>

    <script>
        let mediaRecorder;
        let audioChunks = [];
        let currentStopButton = null;

        function startRecording(arbitreId, tournoiId) {
            navigator.mediaDevices.getUserMedia({ audio: true }).then(stream => {
                mediaRecorder = new MediaRecorder(stream);
                audioChunks = [];

                mediaRecorder.ondataavailable = event => {
                    audioChunks.push(event.data);
                };

                mediaRecorder.onstop = () => {
                    const audioBlob = new Blob(audioChunks, { type: 'audio/wav' });
                    const formData = new FormData();
                    formData.append('audio_data', audioBlob);
                    formData.append('idArbitre', arbitreId);
                    formData.append('idTournoi', tournoiId);
                    formData.append('type', 'arbitre');

                    fetch('upload_audio.php', {
                        method: 'POST',
                        body: formData
                    }).then(response => response.text()).then(result => {
                        console.log('Audio enregistré');
                    }).catch(err => {
                        alert('Erreur lors de l\'upload : ' + err);
                    });

                    if (currentStopButton) currentStopButton.disabled = true;
                };

                mediaRecorder.start();

                currentStopButton = document.getElementById(`stopButton_${arbitreId}`);
                if (currentStopButton) currentStopButton.disabled = false;
            }).catch(err => {
                alert('Impossible d\'accéder au microphone : ' + err.message);
            });
        }

        function stopRecording() {
            if (mediaRecorder && mediaRecorder.state === "recording") {
                mediaRecorder.stop();
            }
        }
    </script>

    <script>
function copyTournamentLink(tournoiId) {
    const baseUrl = window.location.origin + window.location.pathname.substring(0, window.location.pathname.lastIndexOf('/') + 1);
    const link = baseUrl + 'index.php?id_tournoi=' + tournoiId;
    
    navigator.clipboard.writeText(link).then(function() {
        showToast();
    }, function(err) {
        // Fallback pour les anciens navigateurs
        const textArea = document.createElement("textarea");
        textArea.value = link;
        document.body.appendChild(textArea);
        textArea.select();
        document.execCommand('copy');
        document.body.removeChild(textArea);
        showToast();
    });
}

function showToast() {
    const toast = document.getElementById('copy-toast');
    toast.classList.add('show');
    
    setTimeout(function() {
        toast.classList.remove('show');
    }, 3000); // Disparaît après 3 secondes
}
</script>

