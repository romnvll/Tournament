                            <button class="nav-link {% if tab == 'Partenaires' %} active {% endif %} " id="Partenaires-tab" data-bs-toggle="tab" data-bs-target="#Partenaires" type="button" role="tab" aria-controls="Partenaires" aria-selected="false">
                                Partenaires
                            </button>
                        </li>
                        {% endif %}
                    </ul>
                    <div class="tab-content mt-3" id="myTabContent">
                       
                        <div class="tab-pane fade  {% if tab == 'arbitres' %} show active {% endif %} " id="arbitres" role="tabpanel" aria-labelledby="arbitres-tab">
                            <!-- debut tab arbitres -->
                            {% if infotournoi.gestionArbitres == 1 %}
                                <div class="card shadow-lg mt-5">
                                    <div class="card-header bg-primary text-white text-center" id="ajouterDesArbitres">
                                        <h4>
                                            Ajouter des arbitres
                                        </h4>
                                    </div>
                                    <div class="card-body p-4">
                                        <div class="col-5 mt-3">
                                            <form action="modifierTournoi_traitement.php" class="bg-light p-4 rounded shadow" method="GET">
                                                <div class="mb-3">
                                                    <input type="hidden" name="addArbitre" value="true">
                                                    <label for="nomArbitre" class="form-label">
                                                        Nom (optionnel)
                                                    </label>
                                                    <input type="text" class="form-control" id="nomArbitre" aria-describedby="emailHelp" name="nomArbitre">
                                                </div>
                                                <div class="mb-3">
                                                    <input type="hidden" name="tournoiId" value="{{ infotournoi.id }}">
                                                    <label for="club" class="form-label">
                                                        Club
                                                    </label>
                                                    <select class="form-select" id="club" name="clubID">
                                                        {% for club in AfficherLesClubsPourArbitres %}
                                                            <option value="{{ club.id }}">
                                                                {{ club.nom }}
                                                            </option>
                                                        {% endfor %}
                                                    </select>
                                                </div>
                                                <button type="submit" class="btn btn-primary">
