<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"/>
    <title>Gestion rencontre</title>
    <style>
        body {
            background-color: #f8f9fa;
        }
        .card {
            border: none;
            border-radius: 15px;
        }
        .btn-primary {
            background-color: #007bff;
            border-color: #007bff;
        }
        .btn-danger {
            background-color: #dc3545;
            border-color: #dc3545;
        }
        .toast-body {
            font-size: 1rem;
        }
    </style>
</head>
<body>
    {{ include('header.twig') }}
    <div class="container mt-4">
        <div class="row">
            <div class="col">
                <h3>Sélection du tournoi</h3>
                {% for tournoi in ListeDesTournois %}
                    <a href="modifierTournoi.php?idTournoi={{ tournoi.id }}" class="btn {% if tournoi.id == tournoiEnCours %}btn-danger{% else %}btn-primary{% endif %}" role="button">{{ tournoi.nom }}</a>
                {% endfor %}
            </div>
        </div>
        {% if tournoiEnCours != 0 %}
            <div class="row mt-4">
                <div class="col-lg-6">
                    <div class="card shadow-lg">
                        <div class="card-header bg-primary text-white text-center">
                            <h4>Modifier Tournoi</h4>
                        </div>
                        <div class="card-body p-4">
                            <form action="modifierTournoi_traitement.php" method="post">
                                <input type="hidden" name="idTournoi" value="{{ infotournoi.id }}">
                                <div class="mb-3">
                                    <label for="nom" class="form-label">Nom du tournoi</label>
                                    <input type="text" class="form-control" id="nom" name="nom" value="{{ infotournoi.nom }}" readonly>
                                </div>
                                <div class="mb-3">
                                    <label for="heure_debut" class="form-label">Heure de début</label>
                                    <input type="time" class="form-control" id="heure_debut" name="heure_debut" value="{{ infotournoi.heure_debut }}" onchange="this.form.submit()">
                                </div>
                                <div class="mb-3">
                                    <label for="pasHoraire" class="form-label">Pas Horaire (en minutes)</label>
                                    <input type="number" class="form-control" id="pasHoraire" name="pasHoraire" value="{{ infotournoi.pasHoraire }}" onchange="this.form.submit()">
                                </div>
                                <h5 class="mt-4" id="option">Options</h5>
                                <div class="form-group">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="gestionTables" name="gestionTables" value="1" {% if infotournoi.gestionTables == 1 %} checked {% endif %} onchange="this.form.submit()">
                                        <label class="form-check-label" for="gestionTables">Gestion des tables</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="gestionArbitres" name="gestionArbitres" value="1" {% if infotournoi.gestionArbitres == 1 %} checked {% endif %} onchange="this.form.submit()">
                                        <label class="form-check-label" for="gestionArbitres">Gestion des arbitres</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="isVisible" name="isVisible" value="1" {% if infotournoi.isVisible == 1 %} checked {% endif %} onchange="this.form.submit()">
                                        <label class="form-check-label" for="isVisible">Tournoi visible du public ?</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="heureIsVisible" name="heureIsVisible" value="1" {% if infotournoi.heureIsVisible == 1 %} checked {% endif %} onchange="this.form.submit()">
                                        <label class="form-check-label" for="heureIsVisible">Horaires visibles du public</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="IsRankingView" name="IsRankingView" value="1" {% if infotournoi.IsRankingView == 1 %} checked {% endif %} onchange="this.form.submit()">
                                        <label class="form-check-label" for="IsRankingView">Classement visible du public</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="isArchived" name="isArchived" value="1" {% if infotournoi.isArchived == 1 %} checked {% endif %} onchange="this.form.submit()">
                                        <label class="form-check-label" for="isArchived">Archiver le tournoi</label>
                                    </div>
									<div class="mb-3 ">
                                    <label for="refreshClientTime" class="form-label">Taux raffraichissement (s)</label>
                                    <input type="number" class="form-control" id="refreshClientTime" name="refreshClientTime" value="{{ infotournoi.refreshClientTime /1000 }}" onchange="this.form.submit()" min="1" max="200">
                                </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="container mt-4">
                        <h3 class="text-center mb-4">
                            <i class="fa-solid fa-qrcode me-2"></i>
                            Génération des QR Codes
                        </h3>
                        <div class="row gy-4">
                            <div class="col-lg-6">
                                <div class="card shadow-lg">
                                    <div class="card-body text-center">
                                        <h5 class="card-title">
                                            <i class="fa-solid fa-qrcode me-2"></i>
                                            Pour les coachs
                                        </h5>
                                        <a href="GenerateQrCode.php?idTournoi={{infotournoi.id}}" class="btn btn-primary">
                                            <i class="fa-solid fa-qrcode me-1"></i>
                                            QR Code public
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="card shadow-lg">
                                    <div class="card-body text-center">
                                        <h5 class="card-title">
                                            <i class="fa-solid fa-qrcode me-2"></i>
                                            Pour les arbitres
                                        </h5>
                                        <a href="GenerateQrCodeArbitre.php?idTournoi={{infotournoi.id}}" class="btn btn-primary">
                                       
                                        <i class="fa-solid fa-qrcode me-1"></i>
                                           QR Code Arbitre
                                        
                                        </a>
                                        
                                        
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col">
                    {% if infotournoi.gestionTables == 1 %}
                        <div class="card shadow-lg mt-5">
                            <div class="card-header bg-primary text-white text-center">
                                <h4>Ajouter une personne pour gérer les scores à une table d'un terrain</h4>
                            </div>
                            <di	v class="card-body p-4">
                              <div class="col-md-6 mt-3">
									<form action="modifierTournoi_traitement.php" class="bg-light p-4 rounded shadow">
										<div class="mb-3">
											<label for="Email" class="form-label">Adresse email</label>
											<input type="email" class="form-control" id="Email" aria-describedby="emailHelp" name="mail" required>
											<input type="hidden" name="addPersonne" value="true">
											<input type="hidden" name="tournoiId" value="{{infotournoi.id}}">
											<div id="emailHelp" class="form-text">Veuillez entrer une adresse email valide.</div>
										</div>
										<div class="mb-3">
											<label for="Nom" class="form-label">Nom</label>
											<input type="text" class="form-control" id="Nom" name="nom" required>
										</div>
										<div class="mb-3">
											<label for="prenom" class="form-label">Prénom</label>
											<input type="text" class="form-control" id="prenom" name="prenom" required>
										</div>
										<button type="submit" class="btn btn-primary">Ajouter</button>
									</form>
								</div>

                                <div class="col mt-3">
									{% if AfficherPersonnes |length > 0 %}
										<table class="table table-striped table-hover" id="placementPersonneSurTerrain">
											<thead class="table-dark">
												<tr>
													<th scope="col">Nom</th>
													<th scope="col">Prénom</th>
													<th scope="col">Mail</th>
													<th scope="col">Positionner cette personne sur le terrain N°</th>
                                                    <th scope="col">Actions</th>
												</tr>
											</thead>
											<tbody>
												{% for personne in AfficherPersonnes %}
													<tr>
														<td>{{ personne.Nom }}</td>
														<td>{{ personne.Prenom }}</td>
														<td>{{ personne.Mail }}</td>
														<td>
															{% for terrain in AfficherTerrain %}
																<a href="modifierTournoi_traitement.php?action=ajoutUserSurTable&idPersonne={{ personne.id }}&idterrain={{ terrain.terrain_id }}&tournoiId={{ infotournoi.id }}" class="btn btn-success btn-sm">
																	{{ terrain.nom }}
																</a>
															{% endfor %}
														</td>
                                                        <td>
                                                            <a href="modifierTournoi_traitement.php?action=delPersonne&idPersonne={{ personne.id }}&tournoiId={{ infotournoi.id }}" class="btn btn-danger btn-sm">
                                                                <i class="fa fa-trash" aria-hidden="true"></i> Supprimer
                                                            </a>
													</tr>
												{% endfor %}
											</tbody>
										</table>
									{% endif %}
								</div>

                                <div class="col mt-3">
									{% if AfficherLesPersonnesCrees |length > 0 %}
										<table class="table table-striped table-hover">
											<thead class="table-dark">
												<tr>
													<th scope="col">Nom</th>
													<th scope="col">Prénom</th>
													<th scope="col">Mail</th>
													<th scope="col">Terrain N°</th>
													<th scope="col">Code PIN</th>
													<th scope="col">Clé sécurisée</th>
													<th scope="col">Envoyer les informations</th>
													<th scope="col">Suppression de cette personne</th>
												</tr>
											</thead>
											<tbody>
												{% for personneTable in AfficherLesPersonnesCrees %}
													<tr>
														<td>{{ personneTable.Nom }}</td>
														<td>{{ personneTable.Prenom }}</td>
														<td>{{ personneTable.Mail }}</td>
														<td>{{ personneTable.terrain_nom }}</td>
														<td>{{ personneTable.code_pin }}</td>
														<td>{{ personneTable.url_key }}</td>
														<td class="align-middle">
															<a href="modifierTournoi_traitement.php?action=sendMail&personneTableId={{ personneTable.personne_rencontre_id }}" class="btn btn-primary btn-sm">
																<i class="fa fa-envelope" aria-hidden="true"></i> Envoyer
															</a>
														</td>
														<td>
															<a href="modifierTournoi_traitement.php?action=delPersonneTable&personneTableId={{ personneTable.personne_rencontre_id }}&tournoiId={{ idTournoi }}" class="btn btn-danger btn-sm">
																<i class="fa fa-trash" aria-hidden="true"></i> Supprimer
															</a>
														</td>
													</tr>
												{% endfor %}
											</tbody>
										</table>
									{% endif %}
								</div>

                            </div>
                        </div>
                    {% endif %}
                    {% if infotournoi.gestionArbitres == 1 %}
                        <div class="card shadow-lg mt-5">
                            <div class="card-header bg-primary text-white text-center">
                                <h4>Ajouter des arbitres</h4>
                            </div>
                            <div class="card-body p-4">
                                <div class="col-5 mt-3">
                                    <form action="modifierTournoi_traitement.php" class="bg-light p-4 rounded shadow" method="GET">
										<div class="mb-3">
											<input type="hidden" name="addArbitre" value="true">
											<label for="nomArbitre" class="form-label">Nom (optionnel)</label>
											<input type="text" class="form-control" id="nomArbitre" aria-describedby="emailHelp" name="nomArbitre">
										</div>
										<div class="mb-3">
											<input type="hidden" name="tournoiId" value="{{ infotournoi.id }}">
											<label for="club" class="form-label">Club</label>
											<select class="form-select" id="club" name="clubID">
												{% for club in AfficherLesClubsPourArbitres %}
													<option value="{{ club.id }}">{{ club.nom }}</option>
												{% endfor %}
											</select>
										</div>
										<button type="submit" class="btn btn-primary">Ajouter</button>
									</form>

                                </div>
								<div class="col mt-3">
									<table class="table table-striped table-hover" id="tableDesArbitres">
										<thead class="table-dark">
											<tr>
												<th scope="col">Nom</th>
												<th scope="col">Club</th>
												<th scope="col">Actions</th>
											</tr>
										</thead>
										<tbody>
											{% for arbitre in AfficherLesArbitres %}
												<tr>
													<td>{{ arbitre.nom }}</td>
													<td>{{ arbitre.club_nom }}</td>
													<td>
														<a href="modifierTournoi_traitement.php?delArbitre=true&arbitre_id={{ arbitre.arbitre_id }}" class="btn btn-danger btn-sm">
															<i class="fa fa-trash-o" aria-hidden="true"></i> Supprimer
														</a>
													</td>
												</tr>
											{% endfor %}
										</tbody>
									</table>
								</div>






                            </div>
                        </div>
                    {% endif %}
                    {% if infotournoi.isArchived == 1 %}
                        <div class="row">
                            <a class="btn btn-danger btn-sm" href="deleteTournament.php?idTournoi={{infotournoi.id}}&action=delete" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce tournoi ?\n l\'action est irréversible');">
                                <i class="fa-solid fa-trash-can me-1"></i>Suppression du tournoi
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div id="mailToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        Email envoyé avec succès !
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
            <div id="errorToast" class="toast align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        Échec de l'envoi de l'email.
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const params = new URLSearchParams(window.location.search);
                const status = params.get('status');
                if (status === 'success') {
                    const successToast = new bootstrap.Toast(document.getElementById('mailToast'));
                    successToast.show();
                } else if (status === 'error') {
                    const errorToast = new bootstrap.Toast(document.getElementById('errorToast'));
                    errorToast.show();
                }
            });
        </script>
    </div>
</body>




</html>
