    <!-- Toasts -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="mailToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body"><i class="fas fa-check-circle me-2"></i>{{ t('emailEnvoyeSuccess') }}</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
        <div id="errorToast" class="toast align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body"><i class="fas fa-times-circle me-2"></i>{{ t('emailNonEnvoyeEchec') }}</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
        <div id="copyToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="polite" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body"><i class="fa-solid fa-check-circle me-2"></i>{{ t('lienCopie') }}</div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        // Sauvegarde automatique : tout formulaire .auto-submit est envoyé au moindre changement
        document.querySelectorAll('form.auto-submit').forEach(function (form) {
            form.addEventListener('change', function () { form.submit(); });
        });

        // Affiche / masque une sous-option selon son interrupteur parent (data-controls="id-du-bloc")
        document.querySelectorAll('[data-controls]').forEach(function (checkbox) {
            var target = document.getElementById(checkbox.dataset.controls);
            if (!target) return;
            var update = function () { target.classList.toggle('d-none', !checkbox.checked); };
            checkbox.addEventListener('change', update);
            update();
        });

        // Conserve la position de scroll entre deux rechargements
        window.addEventListener('load', function () {
            var pos = sessionStorage.getItem('scrollPosition');
            if (pos !== null) window.scrollTo(0, pos);
        });
        window.addEventListener('beforeunload', function () {
            sessionStorage.setItem('scrollPosition', window.scrollY);
        });

        // Filtre par nom (onglet Tables)
        document.getElementById('filtreNom')?.addEventListener('keyup', function () {
            var filtre = this.value.toLowerCase();
            document.querySelectorAll('#placementPersonneSurTerrain tbody tr').forEach(function (ligne) {
                ligne.style.display = (ligne.dataset.nom || '').includes(filtre) ? '' : 'none';
            });
        });

        // Toasts d'envoi de mail
        document.addEventListener('DOMContentLoaded', function () {
            var status = new URLSearchParams(window.location.search).get('status');
            if (status === 'success') new bootstrap.Toast(document.getElementById('mailToast')).show();
            else if (status === 'error') new bootstrap.Toast(document.getElementById('errorToast')).show();
        });

        // Copie du lien public
        function copyTournamentLink(tournoiId) {
            var base = window.location.origin + window.location.pathname.substring(0, window.location.pathname.lastIndexOf('/') + 1);
            var link = base + 'index.php?id_tournoi=' + tournoiId;
            var done = function () { new bootstrap.Toast(document.getElementById('copyToast'), { delay: 2500 }).show(); };

            navigator.clipboard.writeText(link).then(done, function () {
                var ta = document.createElement('textarea');
                ta.value = link;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
                done();
            });
        }
    </script>

    <script>
        // ---------- Enregistrement audio des arbitres ----------
        let mediaRecorder;
        let audioChunks = [];
        let currentStopButton = null;

        function startRecording(arbitreId, tournoiId) {
            navigator.mediaDevices.getUserMedia({ audio: true }).then(stream => {
                mediaRecorder = new MediaRecorder(stream);
                audioChunks = [];

                mediaRecorder.ondataavailable = event => { audioChunks.push(event.data); };

                mediaRecorder.onstop = () => {
                    const audioBlob = new Blob(audioChunks, { type: 'audio/wav' });
                    const formData = new FormData();
                    formData.append('audio_data', audioBlob);
                    formData.append('idArbitre', arbitreId);
                    formData.append('idTournoi', tournoiId);
                    formData.append('type', 'arbitre');

                    fetch('upload_audio.php', { method: 'POST', body: formData })
                        .then(r => r.text())
                        .then(() => console.log('Audio enregistré'))
                        .catch(err => alert('Erreur upload : ' + err));

                    if (currentStopButton) currentStopButton.disabled = true;
                };

                mediaRecorder.start();
                currentStopButton = document.getElementById(`stopButton_${arbitreId}`);
                if (currentStopButton) currentStopButton.disabled = false;

            }).catch(err => alert('Impossible d\'accéder au microphone : ' + err.message));
        }

        function stopRecording() {
            if (mediaRecorder && mediaRecorder.state === 'recording') mediaRecorder.stop();
        }

        const arbitreAudios = {};

        function playArbitreAudio(arbitreId, audioPath) {
            Object.keys(arbitreAudios).forEach(id => {
                if (arbitreAudios[id] && !arbitreAudios[id].paused) {
                    arbitreAudios[id].pause();
                    arbitreAudios[id].currentTime = 0;
                    document.getElementById('playButton_' + id).style.display = '';
                    document.getElementById('stopPlayButton_' + id).style.display = 'none';
                }
            });

            if (!arbitreAudios[arbitreId]) {
                arbitreAudios[arbitreId] = new Audio(audioPath);
                arbitreAudios[arbitreId].onended = () => {
                    document.getElementById('playButton_' + arbitreId).style.display = '';
                    document.getElementById('stopPlayButton_' + arbitreId).style.display = 'none';
                };
            }

            arbitreAudios[arbitreId].play();
            document.getElementById('playButton_' + arbitreId).style.display = 'none';
            document.getElementById('stopPlayButton_' + arbitreId).style.display = '';
        }

        function stopArbitreAudio(arbitreId) {
            if (arbitreAudios[arbitreId]) {
                arbitreAudios[arbitreId].pause();
                arbitreAudios[arbitreId].currentTime = 0;
            }
            document.getElementById('playButton_' + arbitreId).style.display = '';
            document.getElementById('stopPlayButton_' + arbitreId).style.display = 'none';
        }
    </script>

</body>
