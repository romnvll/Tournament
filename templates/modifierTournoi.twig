   <script>
            function toggleDependencies() {
                const isVisible = document.getElementById('isVisible').checked;
                document.getElementById('heureIsVisibleContainer').style.display = isVisible ? 'block' : 'none';
                document.getElementById('IsRankingViewContainer').style.display = isVisible ? 'block' : 'none';
            }
            //document.querySelector('form').submit();
            // Appel initial pour s'assurer que les dépendances sont correctement affichées au chargement de la page
            toggleDependencies();
        </script>


        <script>
  // Stocker la position de défilement avant de quitter la page
  window.onload = function() {
    if (typeof(sessionStorage) !== 'undefined') {
      var scrollPosition = sessionStorage.getItem('scrollPosition');
      if (scrollPosition !== null) {
        window.scrollTo(0, scrollPosition);
      }
    }
  };

  window.onbeforeunload = function() {
    if (typeof(sessionStorage) !== 'undefined') {
      sessionStorage.setItem('scrollPosition', window.scrollY);
    }
  };
</script>
<script>
    document.getElementById('filtreNom').addEventListener('keyup', function () {
        const filtre = this.value.toLowerCase();
        const lignes = document.querySelectorAll('table tbody tr');

        lignes.forEach(function (ligne) {
            const nom = ligne.querySelector('td:nth-child(1)').textContent.toLowerCase();
            ligne.style.display = nom.includes(filtre) ? '' : 'none';
        });
    });
</script>


<script>
            document.addEventListener('DOMContentLoaded', function () {
