    <!-- Scripts -->
    <script>
        function toggleDependencies() {
            // isVisible → sous-options horaire et classement
            const isVisible = document.getElementById('isVisible').checked;
            document.getElementById('heureIsVisibleContainer').style.display = isVisible ? 'block' : 'none';
            document.getElementById('IsRankingViewContainer').style.display  = isVisible ? 'block' : 'none';

            // gestionVoix → effets sonores
            const gestionVoix = document.getElementById('gestionVoix').checked;
            document.getElementById('effetsSonoresContainer').style.display = gestionVoix ? 'block' : 'none';

            // gestionInformations → bloc gymnase
            const gestionInformations = document.getElementById('gestionInformations').checked;
            document.getElementById('gymnaseContainer').style.display = gestionInformations ? 'block' : 'none';
        }

        // Appel immédiat au chargement pour appliquer l'état initial
        toggleDependencies();
    </script>

    <script>
        window.onload = function () {
            if (typeof sessionStorage !== 'undefined') {
                var pos = sessionStorage.getItem('scrollPosition');
                if (pos !== null) window.scrollTo(0, pos);
            }
        };
        window.onbeforeunload = function () {
            if (typeof sessionStorage !== 'undefined') {
                sessionStorage.setItem('scrollPosition', window.scrollY);
            }
        };
    </script>

    <script>
        document.getElementById('filtreNom')?.addEventListener('keyup', function () {
            const filtre = this.value.toLowerCase();

            document.querySelectorAll('#placementPersonneSurTerrain tbody tr').forEach(function (ligne) {
                const nom = (ligne.dataset.nom || ligne.querySelector('td:nth-child(1)').textContent).toLowerCase();
                ligne.style.display = nom.includes(filtre) ? '' : 'none';
            });

            document.querySelectorAll('.placement-card').forEach(function (carte) {
                const nom = (carte.dataset.nom || '').toLowerCase();
                carte.style.display = nom.includes(filtre) ? '' : 'none';
            });

            document.querySelectorAll('.table-personnes-desktop tbody tr').forEach(function (ligne) {
                const nom = (ligne.dataset.nom || ligne.querySelector('td:nth-child(1)')?.textContent || '').toLowerCase();
                ligne.style.display = nom.includes(filtre) ? '' : 'none';
            });

            document.querySelectorAll('.personne-card:not(.placement-card)').forEach(function (carte) {
                const nom = (carte.dataset.nom || '').toLowerCase();
                carte.style.display = nom.includes(filtre) ? '' : 'none';
            });
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const params = new URLSearchParams(window.location.search);
            const status = params.get('status');
            if (status === 'success') {
                new bootstrap.Toast(document.getElementById('mailToast')).show();
            } else if (status === 'error') {
                new bootstrap.Toast(document.getElementById('errorToast')).show();
            }
        });
    </script>

    <script>
        let mediaRecorder;
        let audioChunks = [];
        let currentStopButton = null;

        function startRecording(arbitreId, tournoiId) {
            navigator.mediaDevices.getUserMedia({ audio: true }).then(stream => {
                mediaRecorder = new MediaRecorder(stream);
                audioChunks = [];

                mediaRecorder.ondataavailable = event => { audioChunks.push(event.data); };

                mediaRecorder.onstop = () => {
                    const audioBlob = new Blob(audioChunks, { type: 'audio/wav' });
                    const formData  = new FormData();
                    formData.append('audio_data', audioBlob);
                    formData.append('idArbitre',  arbitreId);
                    formData.append('idTournoi',  tournoiId);
                    formData.append('type',       'arbitre');

                    fetch('upload_audio.php', { method: 'POST', body: formData })
                        .then(r => r.text())
                        .then(() => console.log('Audio enregistré'))
                        .catch(err => alert('Erreur upload : ' + err));

                    if (currentStopButton) currentStopButton.disabled = true;
                };

                mediaRecorder.start();
                currentStopButton = document.getElementById(`stopButton_${arbitreId}`);
                if (currentStopButton) currentStopButton.disabled = false;

            }).catch(err => alert('Impossible d\'accéder au microphone : ' + err.message));
        }

        function stopRecording() {
            if (mediaRecorder && mediaRecorder.state === 'recording') mediaRecorder.stop();
        }

        const arbitreAudios = {};

        function playArbitreAudio(arbitreId, audioPath) {
            Object.keys(arbitreAudios).forEach(id => {
                if (arbitreAudios[id] && !arbitreAudios[id].paused) {
                    arbitreAudios[id].pause();
                    arbitreAudios[id].currentTime = 0;
                    document.getElementById('playButton_' + id).style.display = '';
                    document.getElementById('stopPlayButton_' + id).style.display = 'none';
                }
            });

            if (!arbitreAudios[arbitreId]) {
                arbitreAudios[arbitreId] = new Audio(audioPath);
                arbitreAudios[arbitreId].onended = () => {
                    document.getElementById('playButton_' + arbitreId).style.display = '';
                    document.getElementById('stopPlayButton_' + arbitreId).style.display = 'none';
                };
            }

            arbitreAudios[arbitreId].play();
            document.getElementById('playButton_' + arbitreId).style.display = 'none';
            document.getElementById('stopPlayButton_' + arbitreId).style.display = '';
        }

        function stopArbitreAudio(arbitreId) {
            if (arbitreAudios[arbitreId]) {
                arbitreAudios[arbitreId].pause();
                arbitreAudios[arbitreId].currentTime = 0;
            }
            document.getElementById('playButton_' + arbitreId).style.display = '';
            document.getElementById('stopPlayButton_' + arbitreId).style.display = 'none';
        }
    </script>

    <script>
        function copyTournamentLink(tournoiId) {
            const baseUrl = window.location.origin + window.location.pathname.substring(0, window.location.pathname.lastIndexOf('/') + 1);
            const link = baseUrl + 'index.php?id_tournoi=' + tournoiId;

            navigator.clipboard.writeText(link).then(showToast, function () {
                const ta = document.createElement('textarea');
                ta.value = link;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
                showToast();
            });
        }

        function showToast() {
            const toast = document.getElementById('copy-toast');
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 3000);
        }
    </script>

