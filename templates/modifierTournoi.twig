<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <script src="https://unpkg.com/htmx.org@1.9.12/dist/htmx.min.js"></script>
    <title>Gestion du tournoi</title>

    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #4338ca;
            --ink: #1f2937;
            --muted: #6b7280;
            --line: #e5e7eb;
            --surface: #f9fafb;
            --radius: 12px;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: var(--ink);
            padding: 20px;
        }

        .panel {
            background: #fff;
            border-radius: var(--radius);
            box-shadow: 0 10px 15px rgba(0, 0, 0, .1);
            padding: 20px 24px;
            margin-bottom: 20px;
        }

        /* ---------- En-tête ---------- */
        .chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 20px;
            background: var(--surface);
            border: 1px solid var(--line);
            font-size: .9rem;
            color: var(--ink);
        }
        .chip i { color: var(--muted); }

        /* ---------- Cartes de partage ---------- */
        .share-card {
            height: 100%;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .share-card h6 { margin: 0; font-weight: 700; }
        .share-card small { color: var(--muted); }

        /* ---------- Onglets ---------- */
        .tabs-bar {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 6px;
            margin-bottom: 20px;
            border-bottom: 1px solid var(--line);
            -webkit-overflow-scrolling: touch;
        }
        .tabs-bar a {
            flex: 0 0 auto;
            padding: 10px 18px;
            border-radius: 8px 8px 0 0;
            text-decoration: none;
            font-weight: 600;
            color: var(--muted);
            border-bottom: 3px solid transparent;
            white-space: nowrap;
        }
        .tabs-bar a:hover { color: var(--primary); }
        .tabs-bar a.active { color: var(--primary); border-bottom-color: var(--primary); }
        .tabs-bar a.danger.active { color: #dc2626; border-bottom-color: #dc2626; }

        /* ---------- Cartes d'options ---------- */
        .option-card {
            height: 100%;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 18px;
        }
        .option-card h6 {
            font-weight: 700;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .nested {
            margin: 6px 0 10px 8px;
            padding-left: 14px;
            border-left: 3px solid rgba(79, 70, 229, .25);
        }
        .form-check-input:checked { background-color: #10b981; border-color: #10b981; }
        .form-check-label { cursor: pointer; font-weight: 500; }

        .btn-brand { background: var(--primary); border-color: var(--primary); color: #fff; }
        .btn-brand:hover { background: var(--primary-dark); border-color: var(--primary-dark); color: #fff; }

        .danger-zone { border: 1px solid #fecaca; border-radius: var(--radius); padding: 20px; }

        .audio-announce {
            font-size: .85rem;
            color: var(--muted);
            font-style: italic;
            margin-top: 6px;
        }

        .table > :not(caption) > * > * { vertical-align: middle; }
    </style>
</head>
<body>
    {{ include('header.twig') }}

    {# ------------------------------------------------------------------
       Onglet courant (retombe sur "options" si l'onglet demandé est désactivé)
       ------------------------------------------------------------------ #}
    {% set currentTab = tab|default('options') %}
    {% if tournoiEnCours != 0 %}
        {% if currentTab == 'arbitres' and infotournoi.gestionArbitres != 1 %}{% set currentTab = 'options' %}{% endif %}
        {% if currentTab == 'gestionTables' and infotournoi.gestionTables != 1 %}{% set currentTab = 'options' %}{% endif %}
        {% if currentTab == 'infos' and infotournoi.gestionInformations != 1 %}{% set currentTab = 'options' %}{% endif %}
    {% endif %}

    {# Macro : un switch Bootstrap (id = name, valeur 1) #}
    {% macro switch(id, label, checked, controls) %}
        <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" role="switch"
                   id="{{ id }}" name="{{ id }}" value="1"
                   {% if checked %}checked{% endif %}
                   {% if controls %}data-controls="{{ controls }}"{% endif %}>
            <label class="form-check-label" for="{{ id }}">{{ label|raw }}</label>
        </div>
    {% endmacro %}
    {% import _self as ui %}

    <!-- ===================== EN-TÊTE ===================== -->
    <div class="panel">
        <div class="row g-3 align-items-center">
            <div class="col-lg-5">
                <label for="selectTournoi" class="form-label fw-bold mb-1">
                    <i class="fas fa-trophy me-1"></i> {{ t('selectionTournoi') }}
                </label>
                <select id="selectTournoi" class="form-select"
                        onchange="if (this.value) location.href = 'modifierTournoi.php?idTournoi=' + this.value;">
                    {% if tournoiEnCours == 0 %}<option value="">—</option>{% endif %}
                    {% for tournoi in ListeDesTournois %}
                        <option value="{{ tournoi.id }}" {% if tournoi.id == tournoiEnCours %}selected{% endif %}>
                            {{ tournoi.nom }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            {% if tournoiEnCours != 0 %}
            <div class="col-lg-7">
                <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                    <span class="chip"><i class="fas fa-futbol"></i> {{ infotournoi.nom_type_sport }}</span>
                    <span class="chip"><i class="fas fa-calendar-day"></i> {{ infotournoi.dateDebut }}</span>
                    <span class="chip"><i class="fas fa-clock"></i> {{ infotournoi.heure_debut }}</span>
                    <span class="chip"><i class="fas fa-hourglass-half"></i> {{ infotournoi.pasHoraire }} min</span>
                    {% if infotournoi.isVisible == 1 %}
                        <span class="chip"><i class="fas fa-eye text-success"></i> {{ t('tournoiVisible') }}</span>
                    {% else %}
                        <span class="chip"><i class="fas fa-eye-slash"></i> Masqué</span>
                    {% endif %}
                    {% if infotournoi.isArchived == 1 %}
                        <span class="chip"><i class="fas fa-box-archive"></i> Archivé</span>
                    {% endif %}
                </div>
            </div>
            {% endif %}
        </div>

        {% if tournoiEnCours != 0 %}
        <div class="d-flex flex-wrap gap-2 mt-3">
            <a href="ajoutEquipe.php?idTournoi={{ idTournoi }}" class="btn btn-success btn-sm"
               title="{{ t('explicationEquipe')|striptags|e('html_attr') }}">
                <i class="fa-solid fa-plus"></i> {{ t('creerEquipe') }}
            </a>
            <a href="creerClub.php" class="btn btn-success btn-sm"
               title="{{ t('explicationClub')|striptags|e('html_attr') }}">
                <i class="fa-solid fa-plus"></i> {{ t('creerClub') }}
            </a>
        </div>
        {% endif %}
    </div>

    {% if tournoiEnCours != 0 %}

    <!-- ===================== PARTAGE & DIFFUSION ===================== -->
    <div class="panel">
        <div class="row g-3">
            <div class="col-md-{{ infotournoi.gestionArbitres == 1 ? 4 : 6 }}">
                <div class="share-card">
                    <h6><i class="fa-solid fa-qrcode me-1"></i> {{ t('QrpourLesCoachsetPublic') }}</h6>
                    <div class="d-flex flex-wrap gap-2 mt-auto">
                        <a href="GenerateQrCode.php?idTournoi={{ infotournoi.id }}" class="btn btn-brand btn-sm">
                            <i class="fa-solid fa-qrcode"></i> {{ t('qrCode') }}
                        </a>
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                onclick="copyTournamentLink('{{ infotournoi.id }}')">
                            <i class="fa-solid fa-link"></i> {{ t('CopierLeLien') }}
                        </button>
                    </div>
                </div>
            </div>

            {% if infotournoi.gestionArbitres == 1 %}
            <div class="col-md-4">
                <div class="share-card">
                    <h6><i class="fa-solid fa-qrcode me-1"></i> {{ t('pourLesArbitres') }}</h6>
                    <div class="mt-auto">
                        <a href="GenerateQrCodeArbitre.php?idTournoi={{ infotournoi.id }}" class="btn btn-brand btn-sm">
                            <i class="fa-solid fa-qrcode"></i> {{ t('qrCode') }}
                        </a>
                    </div>
                </div>
            </div>
            {% endif %}

            <div class="col-md-{{ infotournoi.gestionArbitres == 1 ? 4 : 6 }}">
                <div class="share-card">
                    <h6><i class="fas fa-tv me-1"></i> Brackito TV</h6>
                    <small>{{ t('explicationTv')|raw }}</small>
                    <div class="mt-auto">
                        <a href="tv_display.php?id_tournoi={{ infotournoi.id }}" target="_blank" class="btn btn-brand btn-sm">
                            <i class="fas fa-tv"></i> {{ t('voirSurTv') }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================== ONGLETS ===================== -->
    <div class="panel">
        <nav class="tabs-bar">
            <a href="modifierTournoi.php?idTournoi={{ infotournoi.id }}&tab=options"
               class="{{ currentTab == 'options' ? 'active' }}">
                <i class="fas fa-sliders-h"></i> Options
            </a>
            {% if infotournoi.gestionInformations == 1 %}
            <a href="modifierTournoi.php?idTournoi={{ infotournoi.id }}&tab=infos"
               class="{{ currentTab == 'infos' ? 'active' }}">
                <i class="fas fa-building"></i> {{ t('gestionInformations') }}
            </a>
            {% endif %}
            {% if infotournoi.gestionArbitres == 1 %}
            <a href="modifierTournoi.php?idTournoi={{ infotournoi.id }}&tab=arbitres"
               class="{{ currentTab == 'arbitres' ? 'active' }}">
                <i class="fas fa-user-tie"></i> {{ t('arbitres') }}
            </a>
            {% endif %}
            {% if infotournoi.gestionTables == 1 %}
            <a href="modifierTournoi.php?idTournoi={{ infotournoi.id }}&tab=gestionTables"
               class="{{ currentTab == 'gestionTables' ? 'active' }}">
                <i class="fas fa-table"></i> Table
            </a>
            {% endif %}
            <a href="modifierTournoi.php?idTournoi={{ infotournoi.id }}&tab=danger"
               class="danger {{ currentTab == 'danger' ? 'active' }}">
                <i class="fas fa-triangle-exclamation"></i> Archivage
            </a>
        </nav>

        {# ============================ ONGLET OPTIONS ============================ #}
        {% if currentTab == 'options' %}
        <form action="modifierTournoi_traitement.php" method="POST" class="auto-submit">
            <input type="hidden" name="idTournoi" value="{{ infotournoi.id }}">
            {# Champs en lecture seule conservés pour le traitement #}
            <input type="hidden" name="dateDebut" value="{{ infotournoi.dateDebut }}">
            <input type="hidden" name="pasHoraire" value="{{ infotournoi.pasHoraire }}">
            <input type="hidden" name="refreshClientTime" value="{{ infotournoi.refreshClientTime / 1000 }}">

            <div class="row g-3">

                <div class="col-lg-6">
                    <div class="option-card">
                        <h6><i class="fas fa-signature"></i> Général</h6>
                        <div class="mb-3">
                            <label for="nom" class="form-label">{{ t('nameOfTournament') }}</label>
                            <input type="text" class="form-control" id="nom" name="nom" value="{{ infotournoi.nom }}">
                        </div>
                        <div>
                            <label for="heure_debut" class="form-label">{{ t('hourStart') }}</label>
                            <input type="time" class="form-control" id="heure_debut" name="heure_debut" value="{{ infotournoi.heure_debut }}">
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="option-card">
                        <h6><i class="fas fa-eye"></i> Visibilité</h6>
                        {{ ui.switch('isVisible', '👁️ ' ~ t('tournoiVisible') ~ ' ?', infotournoi.isVisible == 1, 'box-visible') }}
                        <div id="box-visible" class="nested">
                            {{ ui.switch('heureIsVisible', '⏰ ' ~ t('horaireIsVisible') ~ ' ?', infotournoi.heureIsVisible == 1) }}
                            {{ ui.switch('IsRankingView', '🏆 ' ~ t('classementIsVisible'), infotournoi.IsRankingView == 1) }}
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="option-card">
                        <h6><i class="fas fa-users-gear"></i> Organisation</h6>
                        {{ ui.switch('gestionTables', '🧮 ' ~ t('gestionDesTables'), infotournoi.gestionTables == 1) }}
                        {{ ui.switch('gestionArbitres', '🧑‍⚖️ ' ~ t('gestionDesArbitres'), infotournoi.gestionArbitres == 1) }}
                        {{ ui.switch('gestionPartenaires',
                            '🤝 ' ~ t('gestionDesPartenaires') ~ ' ' ~ t('partenairesDansLesPreferences', {'%tournoiId%': idTournoi}),
                            infotournoi.gestionPartenaires == 1) }}
                        {{ ui.switch('gestionInformations', '🏟️ ' ~ t('gestionInformations'), infotournoi.gestionInformations == 1) }}
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="option-card">
                        <h6><i class="fas fa-microphone"></i> Annonces vocales</h6>
                        {{ ui.switch('gestionVoix', '🎙️ ' ~ t('gestionDesAnnoncesVocales'), infotournoi.gestionVoix == 1, 'box-voix') }}
                        <div id="box-voix" class="nested">
                            {{ ui.switch('effetsSonores', '🔊 ' ~ t('effetsSonoresMatch'), infotournoi.effetsSonores == 1) }}
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="option-card">
                        <h6><i class="fas fa-tv"></i> Panneau d'affichage virtuel</h6>
                        {{ ui.switch('gestionTempsChangement', '⏱️ Utiliser le panneau d\'affichage virtuel ?', infotournoi.gestionTempsChangement == 1, 'box-temps') }}
                        <div id="box-temps" class="nested">
                            <label for="tempsChangementMinutes" class="form-label">⌛ Temps entre deux matchs (minutes)</label>
                            <input type="number" class="form-control mb-3" style="max-width:160px;"
                                   id="tempsChangementMinutes" name="tempsChangementMinutes"
                                   min="0" max="60" value="{{ infotournoi.tempsChangementMinutes }}">
                            {{ ui.switch('afficherCountdownCoach', '⏳ Afficher le compte à rebours aux coachs', infotournoi.afficherCountdownCoach == 1) }}
                        </div>
                    </div>
                </div>

            </div>
        </form>
        {% endif %}

        {# ============================ ONGLET INFORMATIONS ============================ #}
        {% if currentTab == 'infos' %}
        <div class="alert alert-info">
            <i class="fa-solid fa-circle-info"></i>
            Ces informations sont visibles par les participants sur la page publique du tournoi.
        </div>

        <div class="row g-3">
            <div class="col-lg-6">
                <div class="option-card">
                    <h6><i class="fas fa-building"></i> Gymnase <span class="badge bg-secondary">Optionnel</span></h6>

                    {% if gymnases is empty %}
                        <p class="mb-0">
                            Vous n'avez pas encore de gymnase.
                            <a href="mesPreferences.php?id_tournoi={{ idTournoi }}&gestionGymnases=true" class="fw-bold">
                                Créer un gymnase dans mes préférences
                            </a>
                        </p>
                    {% else %}
                        <form action="modifierTournoi_traitement.php" method="POST" class="auto-submit">
                            <input type="hidden" name="attacherGymnase" value="1">
                            <input type="hidden" name="idTournoi" value="{{ infotournoi.id }}">

                            <label for="gymnase_id" class="form-label">Sélectionner un gymnase</label>
                            <select name="gymnase_id" id="gymnase_id" class="form-select">
                                <option value="">— Aucun gymnase —</option>
                                {% for g in gymnases %}
                                    <option value="{{ g.id }}" {% if gymnaseActuel == g.id %}selected{% endif %}>
                                        {{ g.nom }}{% if g.ville %} — {{ g.ville }}{% endif %}{% if g.nb_terrains %} ({{ g.nb_terrains }} terrain{{ g.nb_terrains > 1 ? 's' : '' }}){% endif %}
                                    </option>
                                {% endfor %}
                            </select>
                        </form>

                        {% for g in gymnases %}
                            {% if gymnaseActuel and g.id == gymnaseActuel %}
                            <div class="mt-3 p-3 rounded" style="background:var(--surface);">
                                <div class="fw-bold mb-1"><i class="fas fa-building me-1"></i>{{ g.nom }}</div>
                                {% if g.adresse %}
                                    <div class="text-muted small">
                                        <i class="fas fa-map-pin me-1"></i>{{ g.adresse }}{% if g.ville %}, {{ g.ville }}{% endif %}{% if g.code_postal %} {{ g.code_postal }}{% endif %}
                                    </div>
                                {% endif %}
                                {% if g.telephone %}
                                    <div class="text-muted small"><i class="fas fa-phone me-1"></i>{{ g.telephone }}</div>
                                {% endif %}
                                {% if g.nb_terrains %}
                                    <div class="text-muted small"><i class="fas fa-th-large me-1"></i>{{ g.nb_terrains }} terrain{{ g.nb_terrains > 1 ? 's' : '' }}</div>
                                {% endif %}
                            </div>
                            {% endif %}
                        {% endfor %}

                        <a href="mesPreferences.php?id_tournoi={{ idTournoi }}&gestionGymnases=true"
                           class="btn btn-brand btn-sm mt-3">
                            <i class="fas fa-cog"></i> Gérer mes gymnases
                        </a>
                    {% endif %}
                </div>
            </div>

            <div class="col-lg-6">
                <div class="option-card">
                    <h6><i class="fas fa-phone"></i> Contact <span class="badge bg-secondary">Optionnel</span></h6>
                    <p class="text-muted small">Ex. : restauration sur place, contactez le 06.XX pour vos questions.</p>

                    <form action="modifierTournoi_traitement.php" method="POST" class="auto-submit">
                        <input type="hidden" name="idTournoi" value="{{ infotournoi.id }}">
                        <input type="hidden" name="actionContact" value="1">

                        <div class="mb-3">
                            <label for="telephone" class="form-label">{{ t('telephone') }}</label>
                            <input type="tel" class="form-control" id="telephone" name="telephone" value="{{ infotournoi.telephone }}">
                        </div>
                        <div>
                            <label for="commentaire" class="form-label">{{ t('commentaire') }}</label>
                            <textarea class="form-control" id="commentaire" name="commentaire" rows="3">{{ infotournoi.commentaire }}</textarea>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        {% endif %}

        {# ============================ ONGLET ARBITRES ============================ #}
        {% if currentTab == 'arbitres' %}
            {% if AfficherLesClubsPourArbitres is empty %}
                <div class="alert alert-warning">
                    <i class="fas fa-triangle-exclamation"></i>
                    Il faut au moins créer les équipes avant de placer les arbitres.
                    <a href="ajoutEquipe.php?idTournoi={{ infotournoi.id }}" class="alert-link">Créer une équipe</a>
                </div>
            {% endif %}

            <form action="modifierTournoi_traitement.php" method="GET" class="row g-2 align-items-end mb-4">
                <input type="hidden" name="addArbitre" value="true">
                <input type="hidden" name="tournoiId" value="{{ infotournoi.id }}">

                <div class="col-md-4">
                    <label for="nomArbitre" class="form-label">{{ t('nomArbitreOptionnel') }}</label>
                    <input type="text" class="form-control" id="nomArbitre" name="nomArbitre"
                           {% if AfficherLesClubsPourArbitres is empty %}disabled{% endif %}>
                </div>
                <div class="col-md-4">
                    <label for="club" class="form-label">{{ t('Club') }}</label>
                    <select class="form-select" id="club" name="clubID"
                            {% if AfficherLesClubsPourArbitres is empty %}disabled{% endif %}>
                        {% for club in AfficherLesClubsPourArbitres %}
                            <option value="{{ club.id }}">{{ club.nom }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-success"
                            {% if AfficherLesClubsPourArbitres is empty %}disabled{% endif %}>
                        <i class="fas fa-plus"></i> {{ t('ajouter') }}
                    </button>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-hover align-middle" id="tableDesArbitres">
                    <thead class="table-dark">
                        <tr>
                            <th>{{ t('nomArbitreOptionnel') }}</th>
                            <th>{{ t('Club') }}</th>
                            <th>{{ t('Action') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for arbitre in AfficherLesArbitres %}
                        <tr id="ligne-arbitre-{{ arbitre.arbitre_id }}">
                            <td style="min-width:200px;">
                                <form id="form-arbitre-{{ arbitre.arbitre_id }}"
                                      hx-post="modifierTournoi_traitement.php"
                                      hx-trigger="keyup delay:500ms"
                                      hx-target="#message-arbitre-{{ arbitre.arbitre_id }}"
                                      hx-swap="innerHTML">
                                    <input type="text" name="nomArbitre" value="{{ arbitre.nom }}"
                                           placeholder="optionnel" class="form-control">
                                    <input type="hidden" name="idArbitre" value="{{ arbitre.arbitre_id }}">
                                    <input type="hidden" name="idTournoi" value="{{ infotournoi.id }}">
                                </form>
                                <div id="message-arbitre-{{ arbitre.arbitre_id }}"></div>
                            </td>
                            <td>{{ arbitre.club_nom }}</td>
                            <td>
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                    <a href="modifierTournoi_traitement.php?action=delArbitre&arbitre_id={{ arbitre.arbitre_id }}&tournoiId={{ infotournoi.id }}"
                                       class="btn btn-outline-danger btn-sm">
                                        <i class="fa fa-trash-o"></i> {{ t('supprimerArbitre') }}
                                    </a>

                                    {% if infotournoi.gestionVoix == 1 %}
                                        <button class="btn btn-brand btn-sm"
                                                onclick="startRecording({{ arbitre.arbitre_id }}, {{ infotournoi.id }})">
                                            🎤 {{ t('enregistrer') }}
                                        </button>
                                        <button id="stopButton_{{ arbitre.arbitre_id }}" class="btn btn-danger btn-sm"
                                                onclick="stopRecording()" disabled>
                                            ⏹️ {{ t('stop') }}
                                        </button>

                                        {% if arbitre.audio_path == null %}
                                            <i class="fa-solid fa-volume-xmark text-danger" title="Aucun enregistrement"></i>
                                        {% else %}
                                            <i class="fa-solid fa-volume-high text-success" title="Enregistrement disponible"></i>
                                            <button class="btn btn-success btn-sm" id="playButton_{{ arbitre.arbitre_id }}"
