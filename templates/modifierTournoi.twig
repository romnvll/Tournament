<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
        <script src="https://unpkg.com/htmx.org@latest/dist/htmx.min.js"></script>
        <title>
            Gestion rencontre
        </title>
        <style>
        body {
            background-color: #f8f9fa;
        }
        .card {
            border: none;
            border-radius: 15px;
        }
        .btn-primary {
            background-color: #007bff;
            border-color: #007bff;
        }
        .btn-danger {
            background-color: #dc3545;
            border-color: #dc3545;
        }
        .toast-body {
            font-size: 1rem;
        }
    </style>
    </head>
    <body>
        {{ include('header.twig') }}
        <div class="container mt-4">
            <div class="row">
                <div class="col">
                    <h3>
                        {{ t('selectionTournoi') }}
                    </h3>
                    {% for tournoi in ListeDesTournois %}
                        <a href="modifierTournoi.php?idTournoi={{ tournoi.id }}" class="btn {% if tournoi.id == tournoiEnCours %}btn-danger{% else %}btn-primary btn-sm {% endif %}" role="button">
                            {{ tournoi.nom }}
                            <i class="fas fa-trophy"></i>
                        </a>
                    {% endfor %}
                </div>
            </div>

           

            {% if tournoiEnCours != 0 %}
                <div class="row mt-4">
                    <div class="col-lg-6">
                        <div class="card shadow-lg">
                            <div class="card-header bg-primary text-white text-center" id="option">
                                <h4>
                                    {{ t('parametresDuTournoi') }}
                                    (
                                    {{ infotournoi.nom_type_sport }}
                                    )
                                </h4>
                            </div>
                            <div class="card-body p-4">
                                <form action="modifierTournoi_traitement.php" method="POST">
                                    <input type="hidden" name="idTournoi" value="{{ infotournoi.id }}">
                                    <div class="mb-3">
                                        <label for="nom" class="form-label">
                                            {{ t('nameOfTournament') }}
                                        </label>
                                        <input type="text" class="form-control" id="nom" name="nom" value="{{ infotournoi.nom }}" onchange="this.form.submit()">
                                    </div>
                                    <div class="mb-3">
                                        <label for="dateDebut" class="form-label">
                                            {{ t('dateDuTournoi') }}
                                        </label>
                                        <input type="date" class="form-control" id="dateDebut" name="dateDebut" value="{{ infotournoi.dateDebut }}" readonly>
                                    </div>
                                    <div class="mb-3">
                                        <label for="heure_debut" class="form-label">
                                            {{ t('hourStart') }}
                                        </label>
                                        <input type="time" class="form-control" id="heure_debut" name="heure_debut" value="{{ infotournoi.heure_debut }}" onchange="this.form.submit()">
                                    </div>
                                    <div class="mb-3">
                                        <label for="pasHoraire" class="form-label">
                                            {{ t('dureeRencontreDisable') }}
                                        </label>
                                        <input type="number" class="form-control" id="pasHoraire" name="pasHoraire" value="{{ infotournoi.pasHoraire }}" onchange="this.form.submit()" readonly>
                                    </div>
                                    <h5 class="mt-4">
                                        Options
                                    </h5>
                                    <div class="form-group">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="gestionTables" name="gestionTables" value="1" {% if infotournoi.gestionTables == 1 %} checked {% endif %} onchange="this.form.submit()">
                                            <label class="form-check-label" for="gestionTables">
                                                🧮
                                                {{ t('gestionDesTables') }}
                                            </label>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="gestionVoix" name="gestionVoix" value="1" {% if infotournoi.gestionVoix == 1 %} checked {% endif %} onchange="this.form.submit()">
                                            <label class="form-check-label" for="gestionVoix">
                                                🎙️
                                                {{ t('gestionDesAnnoncesVocales') }}
                                            </label>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="gestionArbitres" name="gestionArbitres" value="1" {% if infotournoi.gestionArbitres == 1 %} checked {% endif %} onchange="this.form.submit()">
                                            <label class="form-check-label" for="gestionArbitres">
                                                🧑‍⚖️
                                                {{ t('gestionDesArbitres') }}
                                            </label>
                                        </div>
                                        <!--
                                            <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="gestionRepas" name="gestionRepas" value="1" {% if infotournoi.gestionRepas == 1 %} checked {% endif %} onchange="this.form.submit()">
                                            <label class="form-check-label" for="gestionRepas">
                                            🍽️ Gestion des repas
                                            </label>
                                            </div>
                                        -->
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="gestionPartenaires" name="gestionPartenaires" value="1" {% if infotournoi.gestionPartenaires == 1 %} checked {% endif %} onchange="this.form.submit()">
                                            <label class="form-check-label" for="gestionPartenaires">
                                                🤝
                                                {{ t('gestionDesPartenaires') }}
                                                {{ t('partenairesDansLesPreferences',{'%tournoiId%': idTournoi})| raw }}
                                            </label>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="isVisible" name="isVisible" value="1" {% if infotournoi.isVisible == 1 %} checked {% endif %} onchange="toggleDependencies(),this.form.submit()">
                                            <label class="form-check-label" for="isVisible">
                                                👁️
                                                {{ t('tournoiVisible') }}
                                                ?
                                            </label>
                                        </div>
                                        <div class="form-check form-switch" id="heureIsVisibleContainer" style="margin-left: 20px;">
                                            <input class="form-check-input" type="checkbox" id="heureIsVisible" name="heureIsVisible" value="1" {% if infotournoi.heureIsVisible == 1 %} checked {% endif %} onchange="this.form.submit()">
                                            <label class="form-check-label" for="heureIsVisible">
                                                ⏰
                                                {{ t('horaireIsVisible') }}
                                                ?
                                            </label>
                                        </div>
                                        <div class="form-check form-switch" id="IsRankingViewContainer" style="margin-left: 20px;">
                                            <input class="form-check-input" type="checkbox" id="IsRankingView" name="IsRankingView" value="1" {% if infotournoi.IsRankingView == 1 %} checked {% endif %} onchange="this.form.submit()">
                                            <label class="form-check-label" for="IsRankingView">
                                                🏆
                                                {{ t('classementIsVisible') }}
                                            </label>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="isArchived" name="isArchived" value="1" {% if infotournoi.isArchived == 1 %} checked {% endif %} onchange="this.form.submit()">
                                            <label class="form-check-label" for="isArchived">
                                                🗃️
                                                {{ t('archiverLeTournoi') }}
                                            </label>
                                        </div>
                                        <div class="mb-3">
                                            <label for="refreshClientTime" class="form-label">
                                                🔄Taux raffraichissement (s)
                                            </label>
                                            <input type="number" class="form-control" id="refreshClientTime" name="refreshClientTime" value="{{ infotournoi.refreshClientTime /1000 }}" onchange="this.form.submit()" min="1" max="200">
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                        {% if infotournoi.isArchived == 1 %}
                            <a class="btn btn-danger btn-sm" href="deleteTournament.php?idTournoi={{ infotournoi.id }}&action=delete" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce tournoi ?\n l\'action est irréversible');">
                                <i class="fa-solid fa-trash-can me-1"></i>
                                {{ t('suppressionDuTournoi') }}
                            </a>
                        {% endif %}
                    </div>
                    <div class="col-lg-6">
                        <div class="container mt-4">
                            <h3 class="text-center mb-4">
                                <i class="fa-solid fa-qrcode me-2"></i>
                                {{ t ('generateQrCode') }}
                            </h3>
                            <div class="row gy-4">
                                <div class="col-lg-6 {% if infotournoi.gestionArbitres == 0 %} offset-3 {% endif %}">
                                    <div class="card shadow-lg">
                                        <div class="card-body text-center">
                                            <h5 class="card-title">
                                                <i class="fa-solid fa-qrcode me-2"></i>
                                                {{ t('QrpourLesCoachsetPublic') }}
                                            </h5>
                                            <a href="GenerateQrCode.php?idTournoi={{ infotournoi.id }}" class="btn btn-primary">
                                                <i class="fa-solid fa-qrcode me-1"></i>
                                                {{ t('qrCode') }}
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                {% if infotournoi.gestionArbitres == 1 %}
                                    <div class="col-lg-6">
                                        <div class="card shadow-lg">
                                            <div class="card-body text-center">
                                                <h5 class="card-title">
                                                    <i class="fa-solid fa-qrcode me-2"></i>
                                                    {{ t('pourLesArbitres') }}
                                                </h5>
                                                <a href="GenerateQrCodeArbitre.php?idTournoi={{ infotournoi.id }}" class="btn btn-primary">
                                                    <i class="fa-solid fa-qrcode me-1"></i>
                                                    {{ t('qrCode') }}
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endif %}
                        </div>
                        <div class="row mt-5">
                            <!-- Bloc Créer Club + explication -->
                            <div class="col-12 d-flex flex-wrap align-items-start mb-3">
                                <!-- Bouton Créer Club -->
                                <a href="creerClub.php" class="btn btn-success btn-lg d-flex align-items-center me-3 flex-shrink-0" style="min-width: 180px;">
                                    <i class="fa-solid fa-plus me-2"></i>
                                    {{ t('creerClub') }}
                                </a>
                                <!-- Explication Club -->
                                <div class="alert alert-info mb-0 flex-grow-1">
                                    <i class="fa-solid fa-info-circle me-2"></i>
                                    {{ t('explicationClub') | raw }}
                                </div>
                            </div>
                            <!-- Bloc Créer Équipe + explication -->
                            <div class="col-12 d-flex flex-wrap align-items-start mb-3">
                                <!-- Bouton Créer Équipe -->
                                <a href="ajoutEquipe.php?idTournoi={{ idTournoi }}" class="btn btn-success btn-lg d-flex align-items-center me-3 flex-shrink-0" style="min-width: 180px;">
                                    <i class="fa-solid fa-plus me-2"></i>
                                    {{ t('creerEquipe') }}
                                </a>
                                <!-- Explication Équipe -->
                                <div class="alert alert-info mb-0 flex-grow-1">
                                    <i class="fa-solid fa-info-circle me-2"></i>
                                    {{ t('explicationEquipe') }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {% if tab == 'tableDesPersonnes' %}
                {% set tabcontent_table = 'show active' %}
            {% else %}
                {% set tabcontent_table = '' %}
            {% endif %}
            {% if tab == 'partenaires' %}
                {% set tabcontent_partenaires = 'show active' %}
            {% else %}
                {% set tabcontent_partenaires = '' %}
            {% endif %}
            {% if tab == 'arbitres' %}
                {% set tabcontent_arbitres = 'show active' %}
            {% else %}
                {% set tabcontent_arbitres = '' %}
            {% endif %}
            <div class="row mt-4">
                <div class="container my-5">
                    <ul class="nav nav-tabs nav justify-content-center" id="myTab" role="tablist">
                        {% if infotournoi.gestionArbitres == 1 %}
                            <li class="nav-item" role="Gestion des arbitres">
                                <button class="nav-link {% if tab == 'arbitres' %} active {% endif %}" id="arbitres-tab" data-bs-toggle="tab" data-bs-target="#arbitres" type="button" role="tab" aria-controls="arbitres" aria-selected="true">
                                    {{ t('arbitres') }}
                                </button>
                            </li>
                        {% endif %}
                        {% if infotournoi.gestionTables == 1 %}
                            <li class="nav-item" role="presentation">
                                <button class="nav-link {% if tab == 'tableDesPersonnes' %} active {% endif %} " id="Table-tab" data-bs-toggle="tab" data-bs-target="#table" type="button" role="tab" aria-controls="table" aria-selected="false">
                                    Table
                                </button>
                            </li>
                        {% endif %}
                    </ul>
                    <div class="tab-content mt-3" id="myTabContent">
                        <div class="tab-pane fade  {% if tab == 'arbitres' %} show active {% endif %} " id="arbitres" role="tabpanel" aria-labelledby="arbitres-tab">
                            <!-- debut tab arbitres -->
                            {% if infotournoi.gestionArbitres == 1 %}
                                <div class="card shadow-lg mt-5">
                                    <div class="card-header bg-primary text-white text-center" id="ajouterDesArbitres">
                                        <h4>
                                            {{ t('ajouterDesArbitres') }}
                                        </h4>
                                    </div>
                                    <div class="card-body p-4">
                                        <div class="col-5 mt-3">
                                            <form action="modifierTournoi_traitement.php" class="bg-light p-4 rounded shadow" method="GET">
                                                <div class="mb-3">
                                                    <input type="hidden" name="addArbitre" value="true">
                                                    <label for="nomArbitre" class="form-label">
                                                        {{ t('nomArbitreOptionnel') }}
                                                    </label>
                                                    <input type="text" class="form-control" id="nomArbitre" aria-describedby="emailHelp" name="nomArbitre">
                                                </div>
                                                <div class="mb-3">
                                                    <input type="hidden" name="tournoiId" value="{{ infotournoi.id }}">
                                                    <label for="club" class="form-label">
                                                        {{ t('Club') }}
                                                    </label>
                                                    <select class="form-select" id="club" name="clubID">
                                                        {% for club in AfficherLesClubsPourArbitres %}
                                                            <option value="{{ club.id }}">
                                                                {{ club.nom }}
                                                            </option>
                                                        {% endfor %}
                                                    </select>
                                                </div>
                                                <button type="submit" class="btn btn-primary">
                                                    {{ t('ajouter') }}
                                                </button>
                                            </form>
                                        </div>
                                        <div class="col mt-3">
                                            <table class="table table-striped table-hover" id="tableDesArbitres">
                                                <thead class="table-dark">
                                                    <tr>
                                                        <th scope="col">
                                                            {{ t('nomArbitreOptionnel') }}
                                                        </th>
                                                        <th scope="col">
                                                            {{ t('Club') }}
                                                        </th>
                                                        <th scope="col">
                                                            {{ t('Action') }}
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for arbitre in AfficherLesArbitres %}
                                                        <tr id="ligne-arbitre-{{ arbitre.arbitre_id }}">
                                                            <td>
                                                                <form id="form-arbitre-{{ arbitre.arbitre_id }}" hx-post="modifierTournoi_traitement.php" hx-trigger="keyup" hx-target="#message-arbitre-{{ arbitre.arbitre_id }}" hx-swap="innerHTML">
                                                                    <input type="text" name="nomArbitre" value="{{ arbitre.nom }}" placeholder="optionnel" class="form-control">
                                                                    <input type="hidden" name="idArbitre" value="{{ arbitre.arbitre_id }}">
                                                                    <input type="hidden" name="idTournoi" value="{{ infotournoi.id }}">
                                                                </form>
                                                                <div id="message-arbitre-{{ arbitre.arbitre_id }}"></div>
                                                            </td>
                                                            <td>
                                                                {{ arbitre.club_nom }}
                                                            </td>
                                                            <td>
                                                                <a href="modifierTournoi_traitement.php?delArbitre=true&arbitre_id={{ arbitre.arbitre_id }}&tournoiId={{ infotournoi.id }}" class="btn btn-danger btn-sm">
                                                                    <i class="fa fa-trash-o" aria-hidden="true"></i>
                                                                    {{ t('supprimer') }}
                                                                </a>
                                                                {% if infotournoi.gestionVoix == 1 %}
                                                                    <!-- Enregistrement audio -->
                                                                    <button class="btn btn-primary btn-sm" onclick="startRecording({{ arbitre.arbitre_id }}, {{ infotournoi.id }})">
                                                                        🎤
                                                                        {{ t('enregistrer') }}
                                                                    </button>
                                                                    <button id="stopButton_{{ arbitre.arbitre_id }}" class="btn btn-danger btn-sm" onclick="stopRecording()" disabled>
                                                                        ⏹️
                                                                        {{ t('stop') }}
                                                                    </button>
                                                                    {% if arbitre.audio_path == null %}
                                                                        <i class="fa-solid fa-volume-xmark"></i>
                                                                        {{ t('aideEnregistrementArbitre') }}
                                                                    {% else %}
                                                                        <i class="fa-solid fa-volume-high"></i>
                                                                    {% endif %}
                                                                {% endif %}
                                                            </td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                
                            {% endif %}


                        <!-- fin tab arbitres -->
                        </div>
                        <div class="tab-pane fade {% if tab == 'tableDesPersonnes' %} show active {% endif %} " id="table" role="tabpanel" aria-labelledby="table-tab">
                            <!-- debut tab tables -->
                            {% if infotournoi.gestionTables == 1 %}
                                <div class="card shadow-lg mt-5">
                                    <div class="card-header bg-primary text-white text-center" id="ajouterDesPersonnesSurTerrain">
                                        <h4>
                                            {{ t('ajouterPersonneTerrainTitre') }}
                                        </h4>
                                    </div>
                                    <div class="card-body p-4">
                                        <div class="col-md-6 mt-3">
                                            <form action="modifierTournoi_traitement.php" class="bg-light p-4 rounded shadow">
                                                <div class="mb-3">
                                                    <label for="Email" class="form-label">
                                                        {{ t('email') }}
                                                    </label>
                                                    <input type="email" class="form-control" id="Email" aria-describedby="emailHelp" name="mail" required>
                                                    <input type="hidden" name="addPersonne" value="true">
                                                    <input type="hidden" name="tournoiId" value="{{ infotournoi.id }}">
                                                    <div id="emailHelp" class="form-text">
                                                        {{ t('entrerValidAdressMail') }}
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="Nom" class="form-label">
                                                        {{ t('name') }}
                                                    </label>
                                                    <input type="text" class="form-control" id="Nom" name="nom" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="prenom" class="form-label">
                                                        {{ t('prenom') }}
                                                    </label>
                                                    <input type="text" class="form-control" id="prenom" name="prenom" required>
                                                </div>
                                                <button type="submit" class="btn btn-primary">
                                                    {{ t('ajouter') }}
                                                </button>
                                            </form>
                                        </div>
                                        <div class="col mt-3">
                                            {% if AfficherPersonnes |length > 0 %}
                                                <table class="table table-striped table-hover" id="placementPersonneSurTerrain">
                                                    <thead class="table-dark">
                                                        <tr>
                                                            <th scope="col">
                                                                {{ t('name') }}
                                                            </th>
                                                            <th scope="col">
                                                                {{ t('prenom') }}
                                                            </th>
                                                            <th scope="col">
                                                                {{ t('email') }}
                                                            </th>
                                                            <th scope="col">
                                                                {{ t ('postionnerPersonneTerrain') }}
                                                            </th>
                                                            <th scope="col">
                                                                {{ t('action') }}
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <input type="text" id="filtreNom" class="form-control mb-3" placeholder="Rechercher par nom...">
                                                        {% for personne in AfficherPersonnes %}
                                                            <tr>
                                                                <td>
                                                                    {{ personne.Nom }}
                                                                </td>
                                                                <td>
                                                                    {{ personne.Prenom }}
                                                                </td>
                                                                <td>
                                                                    {{ personne.Mail }}
                                                                </td>
                                                                <td>
                                                                    {% for terrain in AfficherTerrain %}
                                                                        {% set estAffecte = false %}
                                                                        {% for personneTable in AfficherLesPersonnesCrees %}
                                                                            {% if personneTable.personne_id == personne.id and personneTable.terrain_id == terrain.terrain_id %}
                                                                                {% set estAffecte = true %}
                                                                            {% endif %}
                                                                        {% endfor %}
                                                                        <a href="modifierTournoi_traitement.php?action=ajoutUserSurTable&idPersonne={{ personne.id }}&idterrain={{ terrain.terrain_id }}&tournoiId={{ infotournoi.id }}" class="btn btn-sm {{ estAffecte ? 'btn-secondary disabled' : 'btn-success' }}">
                                                                            {{ terrain.nom }}
                                                                        </a>
                                                                    {% endfor %}
                                                                </td>
                                                                <td>
                                                                    <a href="modifierTournoi_traitement.php?action=delPersonne&idPersonne={{ personne.id }}&tournoiId={{ infotournoi.id }}" class="btn btn-danger btn-sm">
                                                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                                                        {{ t('supprimer') }}
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                        {% endfor %}
                                                    </tbody>
                                                </table>
                                            {% endif %}
                                            <div class="col mt-3">
                                                {% if AfficherLesPersonnesCrees |length > 0 %}
                                                    <!-- Champ de recherche -->
                                                    <table class="table table-striped table-hover">
                                                        <thead class="table-dark">
                                                            <tr>
                                                                <th scope="col">
                                                                    {{ t('name') }}
                                                                </th>
                                                                <th scope="col">
                                                                    {{ t('prenom') }}
                                                                </th>
                                                                <th scope="col">
                                                                    {{ t('email') }}
                                                                </th>
                                                                <th scope="col">
                                                                    {{ t('terrainN') }}
                                                                </th>
                                                                <th scope="col">
                                                                    {{ t('codePIN') }}
                                                                </th>
                                                                <th scope="col">
                                                                    {{ t('cleSecurisee') }}
                                                                </th>
                                                                <th scope="col">
                                                                    {{ t('envoiDesInformations') }}
                                                                </th>
                                                                <th scope="col">
                                                                    {{ t('supprimerPersonneTerrain') }}
                                                                </th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            {% for personneTable in AfficherLesPersonnesCrees %}
                                                                <tr>
                                                                    <td>
                                                                        {{ personneTable.Nom }}
                                                                    </td>
                                                                    <td>
                                                                        {{ personneTable.Prenom }}
                                                                    </td>
                                                                    <td>
                                                                        {{ personneTable.Mail }}
                                                                    </td>
                                                                    <td>
                                                                        {{ personneTable.terrain_nom }}
                                                                    </td>
                                                                    <td>
                                                                        {{ personneTable.code_pin }}
                                                                    </td>
                                                                    <td>
                                                                        {{ personneTable.url_key }}
                                                                    </td>
                                                                    <td class="align-middle">
                                                                        <a href="modifierTournoi_traitement.php?action=sendMail&personneTableId={{ personneTable.personne_rencontre_id }}&tournoiId={{ idTournoi }}" class="btn btn-primary btn-sm">
                                                                            <i class="fa fa-envelope" aria-hidden="true"></i>
                                                                            {{ t('envoyer') }}
                                                                        </a>
                                                                        {% if personneTable.sentMail == 1 %}
