                                                                    <i class="fa fa-envelope" aria-hidden="true"></i>
                                                                    Envoyer
                                                                </a>
                                                                
                                                                {% if personneTable.sentMail == 1 %}
                                                                    <span class="badge bg-success">envoyé</span>
                                                                {% else %}
                                                                    <span class="badge bg-secondary">non envoyé</span>
