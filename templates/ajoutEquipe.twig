                        <div class="input-group mb-3">
                            <input 
                                type="text" 
                                class="form-control" 
                                name="query" 
                                placeholder="{{t('RechercherUneEquipeUnClubUneCategorie')}}"
                                value="{{ query|default('') }}"  
                            >
                            <button class="btn btn-primary" type="submit">🔍</button>
                            <a 
                                href="?idTournoi={{ idTournoi }}&query=" 
                                class="btn btn-outline-secondary" 
                                title="Effacer la recherche"
                            >❌</a>
                        </div>
                            <div class="form-text text-muted">
                                🔢  {{t('nombre')}} : <strong>{{ AfficherLesEquipes.nombre }}</strong>
                            </div>
                        {% if query is defined and query != '' %}
                            <div class="form-text text-muted">
                                🔎 {{t('filtreActif')}} : <strong>{{ query }}</strong>
                            </div>
                        {% endif %}
                    </form>





                    <table class="table mt-2" id="tableEquipes">
                        <thead>
                            <tr>
                                <th scope="col" class="text-center" style="display:none">Id</th>
                                <th scope="col" class="text-center">{{t('Club')}}</th>
                                <th scope="col" class="text-center">{{t('nomEquipe')}}</th>
                               {% if infotournoi.gestionVoix == 1 %} <th scope="col" class="text-center">Son de l'équipe</th> {% endif %}
                                <th scope="col">{{t('categorie')}}</th>
                                <th scope="col">{{t('changerVersCategorie')}}</th>
                                <th scope="col">{{t('action')}}</th>
                                
                            </tr>
                          
                        </thead>
                        <tbody>
                        
                            {% for equipe in AfficherLesEquipes.resultats %}

                                <tr style="background-color: {{ equipe.cat_couleur }} !important;">
                               
                                  <td style="display:none">{{ equipe.id }}</td>
                            <td class="text-center">
                            <form action="modifierEquipe.php" method="POST" class="d-inline">

                               {% set dateFin = licence.date_fin|date('Y-m-d')|date %}
                                            {% set today = "now"|date('Y-m-d')|date %}
                                            
                                              
                                            

                            <input type="hidden" name="idEquipe" value="{{ equipe.id }}">
                            <input type="hidden" name="changeClub" value="true">
                            
                                <select name="club_id" class="form-select float-start" style="display:none;" onchange="this.form.submit()">
                                    <option value="">{{t('selectionnerClub')}}</option>
                                   {% for club in AfficherClub %}
                                    <option value="{{ club.id }}"
                                        {% if AfficherLesEquipes['nombre'] > licence.limite_equipes and today > dateFin %} disabled {% endif %}>
                                        {{ club.nom }}
                                    </option>
                                {% endfor %}

                                </select>
                            
                            </form>

    <span class="badge text-bg-dark float-start"> {{ equipe.nom_club }}</span>
    <img 
        class="img-thumbnail float-end shadow" 
        src="{{ equipe.logo }}" 
        style="cursor:pointer;" 
        ondblclick="toggleSelect(this)"
    >
</td>

                                 <td>
                                        <input 
                                            type="text" 
                                            class="form-control" 
                                            size="12"
                                            maxlength="12"
                                            name="nomEquipe" 
                                            value="{{ equipe.nom }}"
                                            hx-post="modifierEquipe.php"
                                            hx-vals='{
                                                "idEquipe": "{{ equipe.id }}",
                                                "tournoi_id": "{{ equipe.tournoi_id }}",
                                                "categorie": "{{ equipe.categorie }}",
                                                "changeNomEquipe": "true"
                                            }'
                                            hx-trigger="blur"
                                            hx-target="#notif-{{ equipe.id }}"
                                            hx-swap="innerHTML"
                                             
                                            {% set dateFin = licence.date_fin|date('Y-m-d')|date %}
                                            {% set today = "now"|date('Y-m-d')|date %}
                                        {% if AfficherLesEquipes['nombre'] > licence.limite_equipes and today >= dateFin %} 
                                        disabled 
                                        {% endif %}>

                                        



                                           
   
      


                                       
                                       
                                       
                                        <!-- si la licence est payante, on readonly le champ nomEquipe -->
                                       


                                        <small id="notif-{{ equipe.id }}" class="text-success ms-2"></small>
                                    </td>
                                    {% if infoTournoi.gestionVoix == 1 %}
                                  <td class="text-center" data-id-tournoi="{{tournoiEnCours}}" data-id-equipe="{{ equipe.id }}">
                                        <button onclick="startRecording(this)" class="btn btn-sm btn-primary">🎙️ {{t('enregistrer')}}</button>
                                            <button onclick="stopRecording(this)" class="btn btn-sm btn-danger" disabled>⏹️ {{t('stop')}}</button>
                                            <br>
                                            <audio controls style="margin-top:5px;" preload="none" src=Audio/{{idTournoi}}/Equipe/{{ equipe.id }}.wav></audio>
                                        {% if equipe.audio_path == null %}
                                          <i class="fa-solid fa-volume-xmark"></i>
                                        {% else %}
                                           <i class="fa-solid fa-volume-high"></i>
                                    {% endif %}
                                    </td>
                                {% endif %}

                                    <td class="text-center"><span class="badge text-bg-dark">{{ equipe.nom_categorie}}</span></td>
                                    <td>
                                        <select 
                                            class="form-select"
                                            name="categorie"
                                            hx-post="modifierEquipe.php"
                                            hx-trigger="change delay:200ms"
                                            hx-vals='{
                                                "idEquipe": "{{ equipe.id }}",
                                                "tournoi_id": "{{ equipe.tournoi_id }}",
                                                "nomEquipe": "{{ equipe.nom }}",
                                                "changeCategorie" : "true"
                                            }'
                                            hx-include="this"
                                            hx-target="#message-{{ equipe.id }}"
                                            hx-swap="outerHTML"
                                        >
   
    

                                            <option selected value="{{ equipe.categorie }}">{{ equipe.nom_categorie }}</option>
                                            {% for categorie in AfficheLesCategories %}
                                                {% if categorie['id_categorie'] != equipe.categorie %}
                                                    <option value="{{ categorie['id_categorie'] }}">{{ categorie['Nom_categorie'] }}</option>
                                                {% endif %}
                                            {% endfor %}
                                        </select>

                                        <div id="message-{{ equipe.id }}" class="small mt-1 text-muted"></div>
                                </td>
 

                                   <td>
                                    </form>
                                    <a href="deleteEquipe.php?idEquipe={{equipe.id}}&idTournoi={{equipe.tournoi_id}}" onclick="return confirm('Voulez-vous vraiment supprimer cette équipe ?')" >
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash text-danger" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6Z"/>
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1Z"/>
                                        </svg>
                                    </a>
                                </td>




                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</body>
<script>

//on autocomplete le club
  document.addEventListener('DOMContentLoaded', function() {
            const equipeInput = document.getElementById('nomEquipe');
            const clubSelect = document.getElementById('club');

            equipeInput.addEventListener('input', function() {
                const equipeName = equipeInput.value.toLowerCase();

                // Parcourir les options du select pour trouver une correspondance
                for (let option of clubSelect.options) {
                    if (option.textContent.toLowerCase().includes(equipeName)) {
                        clubSelect.value = option.value;
                        break;
                    }
                }
            });
        });


// on retient la categorie
document.addEventListener('DOMContentLoaded', function() {
    // Sélectionner les éléments du formulaire
    const categorieSelect = document.getElementById('Categorie');
    const clubSelect = document.getElementById('club');

    // Restaurer les valeurs depuis le localStorage
    if (localStorage.getItem('Categorie')) {
        categorieSelect.value = localStorage.getItem('Categorie');
    }
    //if (localStorage.getItem('club')) {
     //   clubSelect.value = localStorage.getItem('club');
   // }
 

    // Ajouter des écouteurs d'événements pour sauvegarder les valeurs dans le localStorage
    categorieSelect.addEventListener('change', function() {
        localStorage.setItem('Categorie', categorieSelect.value);
    });

    //clubSelect.addEventListener('change', function() {
     //   localStorage.setItem('club', clubSelect.value);
    //});

    
});






  
</script>


<script>
  // Stocker la position de défilement avant de quitter la page
  window.onload = function() {
    if (typeof(sessionStorage) !== 'undefined') {
      var scrollPosition = sessionStorage.getItem('scrollPosition');
      if (scrollPosition !== null) {
        window.scrollTo(0, scrollPosition);
      }
    }
  };

  window.onbeforeunload = function() {
    if (typeof(sessionStorage) !== 'undefined') {
      sessionStorage.setItem('scrollPosition', window.scrollY);
    }
  };
</script>



<script>
function toggleSelect(imgElement) {
    // Trouver le select dans la même cellule (<td>) que l'image double-cliquée
    const td = imgElement.closest('td');
    const select = td.querySelector('select.form-select');
    if (!select) return;

    // Toggle affichage du select
    if (select.style.display === 'none' || select.style.display === '') {
        select.style.display = 'inline-block'; // ou 'block' selon style souhaité
    } else {
        select.style.display = 'none';
    }
}
</script>



<script>
let mediaRecorder;
let audioChunks = [];

function startRecording(btn) {
    const td = btn.closest('td');
    const stopBtn = td.querySelector('button.btn-danger');
    btn.disabled = true;
    stopBtn.disabled = false;

    navigator.mediaDevices.getUserMedia({ audio: true }).then(stream => {
        mediaRecorder = new MediaRecorder(stream);
        audioChunks = [];

        mediaRecorder.ondataavailable = event => {
            audioChunks.push(event.data);
        };

        mediaRecorder.onstop = () => {
            const blob = new Blob(audioChunks, { type: 'audio/wav' });
            const formData = new FormData();
            const idTournoi = td.dataset.idTournoi;
            const idEquipe = td.dataset.idEquipe;
            formData.append('audio', blob, `equipe_${idEquipe}.wav`);
            formData.append('idTournoi', idTournoi);
            formData.append('idEquipe', idEquipe);

            fetch('upload_audio.php', {
                method: 'POST',
                body: formData
            }).then(response => {
                if (response.ok) {
                    alert('Audio envoyé avec succès');
                    const audioElement = td.querySelector('audio');
                    // Ajout d’un cache buster avec un timestamp
                    const baseSrc = audioElement.src.split('?')[0];
                    audioElement.src = baseSrc + '?t=' + new Date().getTime();
                    audioElement.load(); // recharge l’audio avec le nouveau src
                } else {
                    alert('Erreur lors de l’envoi');
                }
                btn.disabled = false;
                stopBtn.disabled = true;
            });
        };

        mediaRecorder.start();
    });
}

function stopRecording(btn) {
    btn.disabled = true;
    const td = btn.closest('td');
    const startBtn = td.querySelector('button.btn-primary');
    startBtn.disabled = false;

    if (mediaRecorder && mediaRecorder.state === "recording") {
        mediaRecorder.stop();
    }
}

</script>

<script>
document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("td[data-id-tournoi][data-id-equipe]").forEach(td => {
        const idTournoi = td.dataset.idTournoi;
        const idEquipe = td.dataset.idEquipe;
        const audioTag = td.querySelector("audio");

        const url = `Audio/${idTournoi}/Equipe/${idEquipe}.wav`;

        // Tester si le fichier existe sans bloquer
        fetch(url, { method: 'HEAD' }).then(resp => {
            if (resp.ok) {
                audioTag.src = url;
            }
        }).catch(e => {
            console.warn("Audio introuvable :", url);
        });
    });
});
</script>




</html>