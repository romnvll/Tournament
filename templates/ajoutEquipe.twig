                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success" style="z-index: 10;">
                                    {{tournament.nombre_equipes}}/{{licence.limite_equipes}}
                                    <span class="visually-hidden">{{t('equipe')}}</span>
                                </span>
                            </a>
                        {% endif %}
                    {% endfor %}
