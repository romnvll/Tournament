                              <div class="d-grid gap-2">
                                    {% if AfficherLesEquipes['nombre'] < licence.limite_equipes %}
                                        <input type="submit" class="btn btn-success btn-lg" value="{{t('ajouterEquipe')}}" />
                                    {% elseif AfficherLesEquipes['nombre'] > licence.limite_equipes or today > dateFin %}
                                        <button type="submit" class="btn btn-secondary btn-lg" disabled>
                                            {% if today > dateFin %}
                                                {{t('tournoiTermine')}}
                                            {% else %}
                                                {{t('ajouterEquipe')}} ({{t('limiteAtteinte')}}) 
                                            {% endif %}
                                        </button>
                                    {% else %}
                                        <input type="submit" class="btn btn-success btn-lg" value="{{t('ajouterEquipe')}}" />
                                    {% endif %}
                                </div>



                        </div>
                    </form>
                </div>
                <div class="col-md-9">
                    
                    {% for tournament in ListeDesTournois %}
                        {% if tournament.isArchived == 0 %}
                            <a href="ajoutEquipe.php?idTournoi={{tournament.id}}" class="btn {% if tournament.id == tournoiEnCours %}btn-danger{% else %}btn-primary btn-sm {% endif %} position-relative ms-2 mb-2">
