<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
    <script src="https://unpkg.com/htmx.org@latest/dist/htmx.min.js"></script>

    <script src="js/RemoveEquipe.js"></script>
    <title>Gestion rencontre</title>
</head>
<body>
    <style>
      select::picker(select) {
  opacity: 0;
  transform: translateY(-10px);
  transition: all 0.4s allow-discrete;
}

select::picker(select):popover-open {
  transform: translateY(0px);
  opacity: 1;

  @starting-style {
    opacity: 0;
    transform: translateY(-10px);
  }
}
        </style>
    {{ include('header.twig') }}
    <script src="https://cdn.datatables.net/2.0.7/js/dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/3.2.2/dataTables.bootstrap4.min.js"></script>

    <div class="container-fluid mt-4">
        <div class="row">
        
            {% if tournoiEnCours != 0 %}
                <div class="col-md-3">
                {% if error %}
                        <div class="alert alert-danger">{{ error }}</div>
                    {% endif %}
                    
                    {% if AfficherLesEquipes['nombre'] > licence.limite_equipes %}
                    <form action="" method="POST">
                    {% else %}                    
                    <form action="ajoutEquipe_traitement.php" method="POST">
                    {% endif %}
                    <input type="hidden" name="query" value="{{query}}">
                        <div class="card shadow-sm p-4">
                            {% if AfficherLesEquipes['nombre'] > licence.limite_equipes  %}
                                <div class="alert alert-danger">
                                {{t('limiteAtteinteMessage',{'%licence.limite_equipes%':licence.limite_equipes})}}
                                                                    
                                </div>
                            {% endif %}
                            <h5 class="text-center mb-3">{{t('ajouterEquipe')}}</h5>
                            <div class="form-group mb-3">
                                <label for="nomEquipe" class="form-label">{{t('nomEquipe')}}</label>
                                <input type="text" class="form-control" name="nomEquipe" id="nomEquipe" placeholder="Ex: HBCAT2" required />
                            </div>
                            <div class="form-group mb-3">
                                <label for="Categorie" class="form-label">{{t('choisirCategorie')}}</label>
                                <select class="form-select" name="Categorie" id="Categorie" required>
                                    <option value="" disabled selected>{{t('choisirCategorie')}}</option>
                                    {% for categorie in AfficheLesCategories %}
                                        <option value="{{categorie.id_categorie}}">{{categorie.Nom_categorie}}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <input type="hidden" value="{{tournoiEnCours}}" name="IdTournoi">
                            <div class="form-group mb-3">
                                <label for="club" class="form-label">{{t('selectionnerClub')}}</label>
                                <select class="form-select" name="idClubs" id="club" required>
                                    {% for club in AfficherClub %}
                                        <option value="{{ club.id }}">{{ club.nom|upper }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            {% set dateFin = licence.date_fin|date('Y-m-d')|date %}
