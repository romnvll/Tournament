<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
    <script src="https://unpkg.com/htmx.org@latest/dist/htmx.min.js"></script>

    <script src="js/RemoveEquipe.js"></script>
    <title>Gestion rencontre</title>
</head>
<body>
    {{ include('header.twig') }}
    <script src="https://cdn.datatables.net/2.0.7/js/dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/3.2.2/dataTables.bootstrap4.min.js"></script>

    <div class="container mt-4">
        <div class="row">
            {% if tournoiEnCours != 0 %}
                <div class="col-md-4">
                    <form action="ajoutEquipe_traitement.php" method="POST">
                        <div class="card shadow-sm p-4">
                            <h5 class="text-center mb-3">Ajouter une équipe</h5>
                            <div class="form-group mb-3">
                                <label for="nomEquipe" class="form-label">Noms des équipes (séparés par une virgule ou un saut de ligne)</label>
                                <input type="text" class="form-control" name="nomEquipes" id="nomEquipes" placeholder="Ex: HBCAT2, HBCAT3, HBCAT4" required />
                            </div>
                            <div class="form-group mb-3">
                                <label for="Categorie" class="form-label">Choisir la catégorie</label>
                                <select class="form-select" name="Categorie" id="Categorie" required>
                                    <option value="" disabled selected>Choisir une catégorie...</option>
                                    {% for categorie in AfficheLesCategories %}
                                        <option value="{{categorie.id_categorie}}">{{categorie.Nom_categorie}}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <input type="hidden" value="{{tournoiEnCours}}" name="IdTournoi">
                            <div class="form-group mb-3">
                                <label for="club" class="form-label">Choisir le club de l'équipe</label>
                                <select class="form-select" name="idClubs" id="club" required>
                                    {% for club in AfficherClub %}
                                        <option value="{{ club.id }}">{{ club.nom }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="d-grid gap-2">
                                <input type="submit" class="btn btn-success btn-lg" value="Ajouter l'équipe" />
                            </div>
                        </div>
                    </form>
                </div>
                <div class="col-md-8">
                    <h5>Choisir un tournoi</h5>
                    {% for tournament in ListeDesTournois %}
                        {% if tournament.isArchived == 0 %}
                            <a href="ajoutEquipe.php?idTournoi={{tournament.id}}" class="btn {% if tournament.id == tournoiEnCours %}btn-danger{% else %}btn-primary{% endif %} position-relative ms-2 mb-2">
                                {{tournament.nom}}
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success">
                                    {{tournament.nombre_equipes}}
                                    <span class="visually-hidden">équipes</span>
                                </span>
                            </a>
                        {% endif %}
                    {% endfor %}
                    <table class="table mt-2" id="tableEquipes">
                        <thead>
                            <tr>
                                <th scope="col" class="text-center" style="display:none">Id</th>
                                <th scope="col" class="text-center">Club</th>
                                <th scope="col" class="text-center">Nom de l'équipe</th>
                                <th scope="col">Categorie</th>
                                <th scope="col">Changer vers categorie</th>
                                <th scope="col">Action</th>
                                <th scope="col" class="text-center">Est présente?</th>
                            </tr>
                          
                        </thead>
                        <tbody>
                        
                            {% for equipe in AfficherLesEquipes %}

                                <tr style="background-color: {{ equipe.cat_couleur }} !important;">
                               
                                    <td  style="display:none">{{equipe.id}}</td>
                                    <td class="text-center">
                                   
                                       <span class="badge text-bg-dark"> {{equipe.nom_club}}</span> <img class="img-thumbnail float-end shadow" src="{{equipe.logo}}">
                                    </td>
                                    <td>
                                        <form action="modifierEquipe.php" method="POST">
                                            <input type="hidden" value="{{equipe.id}}" name="idEquipe">
                                            <input type="hidden" value="{{equipe.tournoi_id}}" name="tournoi_id">
                                            <input type="text" value="{{equipe.nom}}" class="form-control" size="1" name="nomEquipe">
                                    </td>
                                    <td class="text-center"><span class="badge text-bg-dark">{{ equipe.nom_categorie}}</span></td>
                                    <td>
                                        <select id="categorie" name="categorie" class="form-select">
                                            <option selected value="{{equipe.categorie}}">{{ equipe.nom_categorie}}</option>
                                            {% for categorie in AfficheLesCategories %}
                                                <option value="{{categorie['id_categorie']}}">{{categorie['Nom_categorie']}}</option>
                                            {% endfor %}
                                        </select>
                                    </td>
                                   <td>
    <input class="btn btn-primary" type="submit" value="Modifier la catégorie">
    </form>
    <a href="deleteEquipe.php?idEquipe={{equipe.id}}&idTournoi={{equipe.tournoi_id}}" onclick="return confirm('Voulez-vous vraiment supprimer cette équipe ?')" >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash text-danger" viewBox="0 0 16 16">
            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6Z"/>
            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1Z"/>
        </svg>
    </a>
</td>

<td class="text-center">

   {% if equipe.IsPresent == 1 %}
                <a 
                    href="#"
                    onclick="return false;"
                    hx-post="ajoutEquipe_traitement.php"
                    hx-vals='{"id": {{ equipe.id }}, "etat": "absente"}'
                    hx-trigger="dblclick"
                    hx-swap="outerHTML"
                    hx-target="this"
                    title="Double-cliquer pour marquer comme absente"
                    style="text-decoration: none; cursor: pointer;"
                >✅</a>
            {% else %}
                <a 
                    href="#"
                    onclick="return false;"
                    hx-post="ajoutEquipe_traitement.php"
                    hx-vals='{"id": {{ equipe.id }}, "etat": "presente"}'
                    hx-trigger="dblclick"
                    hx-swap="outerHTML"
                    hx-target="this"
                    title="Double-cliquer pour marquer comme présente"
                    style="text-decoration: none; cursor: pointer;"
                >❌</a>
            {% endif %}



</td>


                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</body>
<script>

//on autocomplete le club
  document.addEventListener('DOMContentLoaded', function() {
            const equipeInput = document.getElementById('nomEquipes');
            const clubSelect = document.getElementById('club');

            equipeInput.addEventListener('input', function() {
                const equipeName = equipeInput.value.toLowerCase();

                // Parcourir les options du select pour trouver une correspondance
                for (let option of clubSelect.options) {
                    if (option.textContent.toLowerCase().includes(equipeName)) {
                        clubSelect.value = option.value;
                        break;
                    }
                }
            });
        });


// on retient la categorie
document.addEventListener('DOMContentLoaded', function() {
    // Sélectionner les éléments du formulaire
    const categorieSelect = document.getElementById('Categorie');
    const clubSelect = document.getElementById('club');

    // Restaurer les valeurs depuis le localStorage
    if (localStorage.getItem('Categorie')) {
        categorieSelect.value = localStorage.getItem('Categorie');
    }
    //if (localStorage.getItem('club')) {
     //   clubSelect.value = localStorage.getItem('club');
   // }
 

    // Ajouter des écouteurs d'événements pour sauvegarder les valeurs dans le localStorage
    categorieSelect.addEventListener('change', function() {
        localStorage.setItem('Categorie', categorieSelect.value);
    });

    //clubSelect.addEventListener('change', function() {
     //   localStorage.setItem('club', clubSelect.value);
    //});

    
});




new DataTable('#tableEquipes', {
    searchable: true,
    ordering: false,
    paging: false,
     dom: '<"top"f<i>rt<"bottom"flp>',
     language: {
        search: "Rechercher :",  // Texte pour le champ de recherche
        lengthMenu: "Afficher _MENU_ résultats",  // Texte pour le menu de pagination
       // info: "Affichage de _START_ à _END_ sur _TOTAL_ résultats",  // Texte pour l'information de nombre de résultats
        info: "_TOTAL_ résultats",
        infoEmpty: "Affichage de 0 à 0 sur 0 résultats",  // Texte quand il n'y a pas de données
        infoFiltered: "(filtré à partir de _MAX_ résultats)",  // Texte pour indiquer que les résultats sont filtrés
        paginate: {
            first: "Premier",  // Texte pour le bouton "Premier"
            previous: "Précédent",  // Texte pour le bouton "Précédent"
            next: "Suivant",  // Texte pour le bouton "Suivant"
            last: "Dernier"  // Texte pour le bouton "Dernier"
        },
      },
    columns: [
        { searchable: true }, // Colonne 1
        { searchable: true }, // Colonne 2
        { searchable: true }, // Colonne 3
        { searchable: true }, // Colonne 3
        { searchable: false },
        { searchable: false },
        { searchable: false }, // Colonne 4
         // Colonne 5
        
        // Ajoutez d'autres colonnes si nécessaire
    ]
});


//
  
</script>

</html>