    <script>
    // Autocomplete le club
    document.addEventListener('DOMContentLoaded', function() {
    const equipeInput = document.getElementById('nomEquipe');

    if (equipeInput) {
        equipeInput.addEventListener('input', function() {
            const equipeName = equipeInput.value.toLowerCase();
            const picker = document.getElementById('club-picker-add');
            if (!picker) return;

            const options = picker.querySelectorAll('.club-option');
            const hiddenInput = picker.querySelector('input[type="hidden"]');
            const selectedDisplay = picker.querySelector('.club-selected-display');
            const selectedLogo = picker.querySelector('.selected-logo');
            const selectedName = picker.querySelector('.selected-name');
            const searchInput = picker.querySelector('.club-search-input');

            for (let opt of options) {
                const name = opt.dataset.name || '';
                if (name && name.toLowerCase().includes(equipeName) && equipeName.length > 0) {
                    const img = opt.querySelector('img');
                    hiddenInput.value = opt.dataset.value;
                    selectedLogo.src = img ? img.src : '';
                    selectedName.textContent = name;
                    selectedDisplay.style.display = 'flex';
                    searchInput.style.display = 'none';
                    break;
                }
            }
        });
    }
});

    // Retient la catégorie
    document.addEventListener('DOMContentLoaded', function() {
        const categorieSelect = document.getElementById('Categorie');
        const clubSelect = document.getElementById('club');

        if (categorieSelect) {
            if (localStorage.getItem('Categorie')) {
                categorieSelect.value = localStorage.getItem('Categorie');
            }

            categorieSelect.addEventListener('change', function() {
                localStorage.setItem('Categorie', categorieSelect.value);
            });
        }
    });

    // Stocker la position de défilement
    window.onload = function() {
        if (typeof(sessionStorage) !== 'undefined') {
            var scrollPosition = sessionStorage.getItem('scrollPosition');
            if (scrollPosition !== null) {
                window.scrollTo(0, scrollPosition);
            }
        }
    };

    window.onbeforeunload = function() {
        if (typeof(sessionStorage) !== 'undefined') {
            sessionStorage.setItem('scrollPosition', window.scrollY);
        }
    };

    // Toggle select club
   function toggleSelect(imgElement) {
    const td = imgElement.closest('td');
    
    // Nouveau : club-picker inline
    const picker = td.querySelector('.club-picker-inline');
    if (picker) {
        const isVisible = picker.style.display === 'block';
        picker.style.display = isVisible ? 'none' : 'block';
        if (!isVisible) {
            const searchInput = picker.querySelector('.club-search-input');
            if (searchInput) {
                searchInput.focus();
            }
        }
        return;
    }

    // Fallback ancien select (si présent)
    const select = td.querySelector('select.club-select');
    if (!select) return;
    select.style.display = (select.style.display === 'none' || select.style.display === '') ? 'inline-block' : 'none';
}

    // Enregistrement audio
    let mediaRecorder;
    let audioChunks = [];

    function startRecording(btn) {
        const td = btn.closest('td');
        const stopBtn = td.querySelector('button.stop');
        btn.disabled = true;
        stopBtn.disabled = false;

        navigator.mediaDevices.getUserMedia({ audio: true }).then(stream => {
            mediaRecorder = new MediaRecorder(stream);
            audioChunks = [];

            mediaRecorder.ondataavailable = event => {
                audioChunks.push(event.data);
            };

            mediaRecorder.onstop = () => {
                const blob = new Blob(audioChunks, { type: 'audio/wav' });
                const formData = new FormData();
                const idTournoi = td.dataset.idTournoi;
                const idEquipe = td.dataset.idEquipe;
                formData.append('audio', blob, `equipe_${idEquipe}.wav`);
                formData.append('idTournoi', idTournoi);
                formData.append('idEquipe', idEquipe);

                fetch('upload_audio.php', {
                    method: 'POST',
                    body: formData
                }).then(response => {
                    if (response.ok) {
                        
                        const audioElement = td.querySelector('audio');
                        const baseSrc = audioElement.src.split('?')[0];
                        audioElement.src = baseSrc + '?t=' + new Date().getTime();
                        audioElement.load();

                        // Mettre à jour le statut et activer le bouton supprimer
                        const statusDiv = td.querySelector('.audio-status');
                        if (statusDiv) {
                            statusDiv.innerHTML = '<i class="fa-solid fa-volume-high" style="color: var(--success-color);"></i>';
                        }
                        const deleteBtn = td.querySelector('button.delete-audio');
                        if (deleteBtn) {
                            deleteBtn.disabled = false;
                        }
                    } else {
                        alert('Erreur lors de l\'envoi');
                    }
                    btn.disabled = false;
                    stopBtn.disabled = true;
                });
            };

            mediaRecorder.start();
        });
    }

    function stopRecording(btn) {
        btn.disabled = true;
        const td = btn.closest('td');
        const startBtn = td.querySelector('button.record');
        startBtn.disabled = false;

        if (mediaRecorder && mediaRecorder.state === "recording") {
            mediaRecorder.stop();
        }
    }

    // ===== NOUVEAU : Supprimer l'enregistrement audio =====
    function deleteAudio(btn) {
        if (!confirm('Voulez-vous vraiment supprimer cet enregistrement ?')) {
            return;
        }

        const td = btn.closest('td');
        const idTournoi = td.dataset.idTournoi;
        const idEquipe = td.dataset.idEquipe;

        const formData = new FormData();
        formData.append('idTournoi', idTournoi);
        formData.append('idEquipe', idEquipe);

        btn.disabled = true;
        btn.textContent = '⏳ Suppression...';

        fetch('delete_audio.php', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Vider le lecteur audio
                const audioElement = td.querySelector('audio');
                if (audioElement) {
                    audioElement.pause();
                    audioElement.src = '';
                    audioElement.load();
                }

                // Mettre à jour l'icône de statut
                const statusDiv = td.querySelector('.audio-status');
                if (statusDiv) {
                    statusDiv.innerHTML = '<i class="fa-solid fa-volume-xmark" style="color: var(--danger-color);"></i>';
                }

                // Garder le bouton désactivé (plus rien à supprimer)
                btn.textContent = '🗑️ Supprimer';
                btn.disabled = true;

                alert('Enregistrement supprimé avec succès');
            } else {
                alert('Erreur : ' + (data.message || 'Impossible de supprimer le fichier'));
                btn.disabled = false;
                btn.textContent = '🗑️ Supprimer';
            }
        })
        .catch(err => {
            console.error('Erreur réseau :', err);
            alert('Erreur réseau lors de la suppression');
            btn.disabled = false;
            btn.textContent = '🗑️ Supprimer';
        });
    }
    // ======================================================

    // Charger les fichiers audio
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll("td[data-id-tournoi][data-id-equipe]").forEach(td => {
            const idTournoi = td.dataset.idTournoi;
            const idEquipe = td.dataset.idEquipe;
            const audioTag = td.querySelector("audio");
            const deleteBtn = td.querySelector("button.delete-audio");

            const url = `Audio/${idTournoi}/Equipe/${idEquipe}.wav`;

            fetch(url, { method: 'HEAD' }).then(resp => {
                if (resp.ok) {
                    audioTag.src = url;
                    // Activer le bouton supprimer si le fichier existe
                    if (deleteBtn) {
                        deleteBtn.disabled = false;
                    }
                } else {
                    // Désactiver le bouton supprimer si pas de fichier
                    if (deleteBtn) {
                        deleteBtn.disabled = true;
                    }
                }
            }).catch(e => {
                console.warn("Audio introuvable :", url);
                if (deleteBtn) {
                    deleteBtn.disabled = true;
                }
            });
        });
    });

    // Compteur de caractères
    document.addEventListener("DOMContentLoaded", function() {
        document.querySelectorAll('.nomEquipeInput').forEach(function(input) {
            const equipeId = input.dataset.equipeId;
            const maxLength = input.getAttribute('maxlength');
            const counter = document.getElementById('charCount-' + equipeId);
            
            if (counter) {
                input.addEventListener('input', function() {
                    const remaining = maxLength - input.value.length;
                    counter.textContent = remaining + ' / ' + maxLength + ' caractères restants';
                });
            }
        });
    });

    // Gérer l'indicateur de scroll sur mobile
    document.addEventListener("DOMContentLoaded", function() {
        const tableWrapper = document.querySelector('.table-wrapper');
        const scrollIndicator = document.querySelector('.scroll-indicator');
        
        if (tableWrapper && scrollIndicator) {
            tableWrapper.addEventListener('scroll', function() {
                const scrollLeft = tableWrapper.scrollLeft;
                const scrollWidth = tableWrapper.scrollWidth;
                const clientWidth = tableWrapper.clientWidth;
                
                // Masquer l'indicateur quand on est scrollé à droite
                if (scrollLeft + clientWidth >= scrollWidth - 10) {
                    scrollIndicator.style.opacity = '0';
                } else {
                    scrollIndicator.style.opacity = '1';
                }
            });
        }
    });


// ===== Club Picker =====
document.addEventListener('DOMContentLoaded', function () {

    function initClubPicker(picker) {
        const searchInput = picker.querySelector('.club-search-input');
        const dropdown = picker.querySelector('.club-dropdown');
        const options = picker.querySelectorAll('.club-option');
        const hiddenInput = picker.querySelector('input[type="hidden"][name="idClubs"], input[type="hidden"][name="club_id"]');
        const selectedDisplay = picker.querySelector('.club-selected-display');
        const selectedLogo = picker.querySelector('.selected-logo');
        const selectedName = picker.querySelector('.selected-name');
        const clearBtn = picker.querySelector('.club-clear-btn');
        const form = picker.closest('form');
        const isInline = picker.classList.contains('club-picker-inline');

   function openDropdown() {
    const rect = searchInput.getBoundingClientRect();
    dropdown.style.top = (rect.bottom + 4) + 'px';
    dropdown.style.left = rect.left + 'px';
    dropdown.style.width = rect.width + 'px';
    dropdown.classList.add('open');
    filterOptions(searchInput.value);
    
    // Déplacer le dropdown dans le body pour éviter les contextes de transformation
    if (dropdown.parentElement !== document.body) {
        document.body.appendChild(dropdown);
    }
}

searchInput.addEventListener('focus', openDropdown);
searchInput.addEventListener('input', () => {
    openDropdown();
});
document.addEventListener('scroll', () => {
    if (dropdown.classList.contains('open')) openDropdown();
}, true);

        function filterOptions(query) {
            const q = query.toLowerCase().trim();
            options.forEach(opt => {
                const name = opt.dataset.name || '';
                opt.classList.toggle('hidden', name !== '' && !name.toLowerCase().includes(q));
            });
        }

        // Sélectionner une option
        options.forEach(opt => {
            opt.addEventListener('mousedown', (e) => {
                e.preventDefault();
                if (opt.classList.contains('club-option-disabled')) return;

                const val = opt.dataset.value;
                const name = opt.dataset.name;
                const img = opt.querySelector('img');

                hiddenInput.value = val;
                dropdown.classList.remove('open');

                if (!isInline) {
                    // Mode ajout : afficher la sélection
                    if (val && name) {
                        searchInput.style.display = 'none';
                        selectedDisplay.style.display = 'flex';
                        selectedLogo.src = img ? img.src : '';
                        selectedName.textContent = name;
                    }
                } else {
                    // Mode inline : soumettre le formulaire
                    if (val && form) {
                        searchInput.value = name;
                        form.submit();
                    }
                }
            });
        });

        // Effacer la sélection (mode ajout)
        if (clearBtn) {
            clearBtn.addEventListener('click', () => {
                hiddenInput.value = '';
                selectedDisplay.style.display = 'none';
                searchInput.style.display = '';
                searchInput.value = '';
                searchInput.focus();
                filterOptions('');
            });
        }

        // Clic sur le display pour re-éditer
        if (selectedDisplay) {
            selectedDisplay.addEventListener('click', () => {
                selectedDisplay.style.display = 'none';
                searchInput.style.display = '';
                hiddenInput.value = '';
                searchInput.value = '';
                searchInput.focus();
                filterOptions('');
            });
        }

        // Fermer si clic ailleurs
        document.addEventListener('click', (e) => {
            if (!picker.contains(e.target)) {
                dropdown.classList.remove('open');
            }
        });
    }

    document.querySelectorAll('.club-picker').forEach(initClubPicker);
});



    </script>
</body>
</html>
