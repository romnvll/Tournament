                                    <th scope="col"><i class="fas fa-futbol"></i> Buts+</th>
                                    <th scope="col"><i class="fas fa-futbol"></i> Buts-</th>
                                    <th scope="col"><i class="fas fa-sort-amount-down"></i> Buts diff</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% set classement = 0 %}
                                {% for resultat in resultatRencontres %}
                                    {% set classement = classement + 1 %}
