                                                            <i class="fas fa-user-tie me-1 text-dark"></i>
                                                            {{ equipe.arbitre_nom|capitalize }}
                                                            (
                                                            {{ equipe.arbitre_club_nom|upper }}
                                                            )
                                                        </div>
                                                    {% endif %}
                                                    <!-- Catégorie -->
                                                    <div class="mb-2">
                                                        <span class="badge rounded-pill px-3" style="background-color: {{ equipe.equipe2_categorie_couleur }}; color:#000;">
                                                            {{ equipe.equipe2_categorie_nom }}
                                                        </span>
                                                    </div>
                                                    <!-- Score -->
                                                    <div class="mb-2 fs-5 fw-bold">
                                                        {% if equipe.score1 > equipe.score2 %}
                                                            <span class="badge bg-success px-3">
                                                                {{ equipe.score1 }}
                                                            </span>
                                                            <span class="mx-0">
                                                                -
                                                            </span>
                                                            <span class="badge bg-danger px-3">
                                                                {{ equipe.score2 }}
                                                            </span>
                                                        {% elseif equipe.score1 < equipe.score2 %}
                                                            <span class="badge bg-danger px-3">
                                                                {{ equipe.score1 }}
                                                            </span>
                                                            <span class="mx-0">
                                                                -
                                                            </span>
                                                            <span class="badge bg-success px-3">
                                                                {{ equipe.score2 }}
                                                            </span>
                                                        {% else %}
                                                            <span class="badge bg-secondary px-3">
                                                                {{ equipe.score1 ?? 0 }}
                                                            </span>
                                                            <span class="mx-0">
                                                                -
                                                            </span>
                                                            <span class="badge bg-secondary px-3">
                                                                {{ equipe.score2 ?? 0 }}
                                                            </span>
                                                        {% endif %}
                                                    </div>
                                                    <!-- Statut du match -->
                                                    <div class="mb-2">
                                                        {% if equipe.isTerminated == 0 %}
                                                            <span class="badge bg-warning text-dark shadow-sm">
                                                                À venir
                                                            </span>
                                                        {% elseif equipe.isTerminated == 1 %}
                                                            <span class="badge bg-danger shadow-sm">
                                                                Rencontre terminée
                                                            </span>
                                                        {% elseif equipe.isTerminated == 2 %}
                                                            <span class="badge bg-info text-dark d-inline-flex align-items-center shadow-sm">
                                                                <span class="spinner-grow spinner-grow-sm me-2" role="status"></span>
                                                                Rencontre en cours
                                                            </span>
                                                        {% endif %}
                                                    </div>
                                                    <!-- Sponsor -->
                                                    {% if partenaires is not empty %}
                                                        {% set randIndex = random(0, partenaires|length - 1) %}
                                                        {% set sponsor = partenaires[randIndex] %}
                                                        <div class="card mt-2 shadow-sm border-0">
                                                            <div class="card-body p-2 d-flex justify-content-between align-items-center">
                                                                <small class="text-muted">
                                                                    Sponsorisé par
                                                                    <a href="{{ sponsor.lien_web }}" target="_blank" rel="noopener" class="fw-bold text-decoration-none">
                                                                        {{ sponsor.nom }}
                                                                    </a>
                                                                    {% if sponsor.description %}
                                                                        <br>
                                                                        <em>
                                                                            {{ sponsor.description }}
                                                                        </em>
                                                                    {% endif %}
                                                                </small>
                                                                {% if sponsor.logo %}
                                                                    <a href="{{ sponsor.lien_web }}" target="_blank" rel="noopener">
                                                                        <img src="{{ sponsor.logo }}" alt="{{ sponsor.nom }}" class="img-fluid ms-2" style="max-height:40px;">
                                                                    </a>
                                                                {% endif %}
                                                            </div>
                                                        </div>
                                                    {% endif %}
                                                </td>
                                                <td class="align-middle text-center">
                                                    <div class="d-flex flex-column align-items-center">
                                                        <a href="index.php?id_tournoi={{ idTournoi }}&id_equipe={{ equipe.equipe2_id }}&id_club={{ equipe.club2_id }}&affichageByTeam=true">
                                                            <h5>
                                                                <span class="badge text-bg-dark p-1">
                                                                    {{ equipe.equipe2_nom|upper }}
                                                                </span>
                                                            </h5>
                                                        </a>
                                                        <a href="index.php?id_tournoi={{ idTournoi }}&id_equipe={{ equipe.equipe2_id }}&id_club={{ equipe.club2_id }}&affichageByClubs=true">
                                                            <img src="{{ equipe.club2_logo }}" class="w-100 img-fluid w-md-50 w-lg-50" alt="{{ equipe.equipe2_nom|upper }}">
                                                        </a>
                                                    </div>
                                                </td>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </tbody>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-sm-12 col-12">
                            {% if IsRankingView == 1 and IdPoules != null %}
                                <div class="table-responsive">
                                    <table class="table table-sm table-borderless align-middle" id="classementTableau">
                                        <thead class="bg-light">
                                            <tr>
                                                <th scope="col" class="text-center ps-2">
                                                    <i class="fas fa-users me-1"></i>
                                                    Équipe
                                                </th>
                                                <th scope="col" class="text-center">
                                                    <i class="fas fa-medal me-1"></i>
                                                    Pts
                                                </th>
                                                <th scope="col" class="text-center">
                                                    <i class="fas fa-futbol me-1"></i>
                                                    +
                                                </th>
                                                <th scope="col" class="text-center">
                                                    <i class="fas fa-futbol me-1"></i>
                                                    -
                                                </th>
                                                <th scope="col" class="text-center">
                                                    <i class="fas fa-sort-amount-down me-1"></i>
                                                    Diff
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% set classement = 0 %}
                                            {% for resultat in resultatRencontres %}
                                                {% set classement = classement + 1 %}
                                                <tr>
                                                    <td class="ps-2">
                                                        <div class="d-flex align-items-center">
                                                            <span class="me-2 fw-bold">
                                                                {{ classement }}
                                                                .
                                                            </span>
                                                            <img src="{{ resultat.club_logo }}" class="me-2 rounded-circle" style="width: 30px; height: 30px; object-fit: cover;" alt="logo">
                                                            <span class="fw-medium" style="font-size: 0.85rem;">
                                                                {{ resultat.nom|upper }}
                                                            </span>
                                                        </div>
                                                    </td>
                                                    <td class="text-center fw-medium">
                                                        {{ resultat.TotalDesPoints }}
                                                    </td>
                                                    <td class="text-center fw-medium">
                                                        {{ resultat.nombreButsMarque }}
                                                    </td>
                                                    <td class="text-center fw-medium">
                                                        {{ resultat.nombreButsEncaisse }}
                                                    </td>
                                                    <td class="text-center fw-medium">
                                                        {{ resultat.DifferenceButs }}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    {% include "footer.twig" %}
                {% endif %}
            </div>
            <script src="https://code.jquery.com/jquery-3.7.1.js" integrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4=" crossorigin="anonymous"></script>
            <script>
        var refreshInterval = {{ infoTournoiEnCours['refreshClientTime'] }};

        setInterval(function () {
            $('#score').load(location.href + ' #score > *');
            $('#classementTableau').load(location.href + ' #classementTableau > *');
            $('#labels').load(location.href + ' #labels > *', function () {
                if ($.trim($('#labels').text()) === '') {
                    $('#labels').hide();
                } else {
                    $('#labels').show();
                }
            });
        }, refreshInterval);

        document.addEventListener("DOMContentLoaded", function () {
            function getUrlParams() {
                let params = {};
                let queryString = window.location.search.substring(1);
                let regex = /([^&=]+)=([^&]*)/g;
                let m;
                while (m = regex.exec(queryString)) {
                    params[decodeURIComponent(m[1])] = decodeURIComponent(m[2]);
                }
                return params;
            }

            let params = getUrlParams();

            if (params.hasOwnProperty('id_equipe')) {
                let choisirEquipeDiv = document.querySelector('.choisirEquipe');
                if (choisirEquipeDiv) {
                    choisirEquipeDiv.style.display = 'none';
                }
            }

            if (params.hasOwnProperty('idPoule')) {
                let choisirEquipeDiv = document.querySelector('.choisirEquipe');
                if (choisirEquipeDiv) {
                    choisirEquipeDiv.style.display = 'none';
                }
            }

            if (params.hasOwnProperty('id_club')) {
                let choisirClubDiv = document.querySelector('.choisirClub');
                if (choisirClubDiv) {
                    choisirClubDiv.style.display = 'none';
                }
            }
        });
    </script>
        </body>
    </body>
</html>
