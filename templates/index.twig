                                            <div>
                                                <h4 class="mb-1 fw-bold text-success">
                                                    <i class="fas fa-users me-2"></i>Choisir une équipe
                                                </h4>
                                                <small class="text-muted">Sélectionnez votre équipe pour continuer</small>
