                                    </div>
                                {% endif %}
                                <ul class="list-group no-bullet">
                                    {% for poule in afficherLesPoules %}
                                        {% if IdPoules == poule.id %}
                                        <li>
                                            <a href="index.php?id_tournoi={{ idTournoi }}&idPoule={{ poule.id }}&id_club={{ IdClub }}&id_equipe={{IdEquipe}}" class="list-group-item list-group-item-action active">
                                                {{ poule.nom|upper }}
                                            </a>
                                        </li>
                                        {% else %}
                                         <li>
                                            <a href="index.php?id_tournoi={{ idTournoi }}&idPoule={{ poule.id }}&id_club={{ IdClub }}&id_equipe={{IdEquipe}}" class="list-group-item list-group-item-action">
                                                {{ poule.nom|upper }}
