    <body>
        <div class="container-fluid">
            {% if infoTournoiEnCours is not empty and (infoTournoiEnCours.isArchived == 1 or infoTournoiEnCours.isVisible == 0) %}
                <div class="container-fluid">
                    <div class="alert alert-warning text-center mt-5">
                        <h2>
                            <i class="fas fa-exclamation-triangle"></i>
                            Ce tournoi n'est plus disponible
                        </h2>
                        <p>
                            Il n'y a actuellement aucun tournoi en cours ou à venir.
                        </p>
                    </div>
                </div>
            {% else %}
                {% set countVisibleTournois = 0 %}
                {% for tournoi in ListeDesTournois %}
                    {% if tournoi.isVisible == 1 and tournoi.isArchived == 0 %}
                        {% set countVisibleTournois = countVisibleTournois + 1 %}
                    {% endif %}
                {% endfor %}
                {% if infoTournoiEnCours|length == 0 %}
                    {% include ('accueil.twig') %}
                {% elseif countVisibleTournois == 0 and infoTournoiEnCours.isArchived == 0 and infoTournoiEnCours.isVisible == 1 %}
                    <div class="container-fluid">
                        <div class="alert alert-warning text-center mt-5">
                            <h2>
                                <i class="fas fa-exclamation-triangle"></i>
                                Ce tournoi n'est plus disponible
                            </h2>
                            <p>
                                Il n'y a actuellement aucun tournoi en cours ou à venir.
                            </p>
                        </div>
                    </div>
                {% else %}
                    {% set hasNonArchived = false %}
                    {% for tournoi in ListeDesTournois %}
                        {% if tournoi.isArchived == 0 %}
                            {% set hasNonArchived = true %}
                        {% endif %}
                    {% endfor %}
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-lg-3">
                                {% set heureIsVisible = 0 %}
                                {% set visibility = 0 %}
                                {% set IsRankingView = 0 %}
                                {% set gestionArbitres = 0 %}
                                {% for tournoi in ListeDesTournois %}
                                    {% if tournoi.id == idTournoi %}
                                        {% if tournoi.isVisible == 1 %}
                                            {% set visibility = 1 %}
                                        {% endif %}
                                        {% if tournoi.IsRankingView == 1 %}
                                            {% set IsRankingView = 1 %}
                                        {% endif %}
                                        {% if tournoi.gestionArbitres == 1 %}
                                            {% set gestionArbitres = 1 %}
                                        {% endif %}
                                    {% endif %}
                                    {% if tournoi.heureIsVisible == 1 and tournoi.id == idTournoi %}
                                        {% set heureIsVisible = 1 %}
                                    {% endif %}
                                {% endfor %}
                            </div>
                            <div class="col-lg-3 text-left choisirClub">
                                {% if idTournoi %}
                                    {% if visibility == 1 %}
                                        <div class="bg-success bg-opacity-10 border border-success rounded-3 p-3 shadow-sm">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <h4 class="mb-1 fw-bold text-success">
                                                        <i class="fas fa-users me-2"></i>
                                                        Choisir un club
                                                    </h4>
                                                    <small class="text-muted">
                                                        Sélectionnez votre club pour continuer
                                                    </small>
                                                </div>
                                                <img src="favicon.ico" alt="Logo Brackito" class="img-thumbnail" style="height:50px; width:auto; align-self:start;">
                                            </div>
                                        </div>
                                        <ul class="list-group no-bullet">
                                            <li class="">
                                                {% for club in listeDesCLubs %}
                                                    <li>
                                                        <a href="index.php?id_tournoi={{ idTournoi }}&id_club={{ club.id }}" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between">
                                                            <div class="d-flex align-items-center">
                                                                <img class="img-thumbnail me-2" src="{{ club.logo }}" alt="Logo club" style="max-width: 50px; max-height: 50px;">
                                                                <strong class="me-3">
                                                                    {{ club.nom|upper }}
                                                                </strong>
                                                            </div>
                                                        </a>
                                                        {% if partenaires is not empty %}
                                                            {% set randIndex = random(0, partenaires|length - 1) %}
                                                            {% set sponsor = partenaires[randIndex] %}
