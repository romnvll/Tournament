    <meta charset="UTF-8">
    <meta name="description" content="Brackito est un logiciel français pour gérer vos tournois sportifs : création automatique des poules, planification des matchs, suivi des scores en direct.">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

