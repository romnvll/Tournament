                                                <small class="text-muted">Sélectionnez votre club pour continuer</small>
                                            </div>
                                            <img src="favicon.ico" alt="Logo Brackito" class="img-thumbnail" style="height:50px; width:auto; align-self:start;">
                                        </div>
                                    </div>






                                    <ul class="list-group no-bullet">
                                    <li class="">
                                        {% for club in listeDesCLubs %}
                         
                                    <li>
