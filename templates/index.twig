                                        </li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if affichageByTeam %}
                <div class="alert alert-info mt-3 shadow-sm rounded-3 p-4 d-flex align-items-center">
                    <i class="fa-solid fa-users me-3 fs-4 text-primary"></i>
                    <span class="fw-bold">Toutes les rencontres de l'équipe <strong>{{ getNomEquipeCourant }}</strong></span>
                </div>
            {% elseif affichageByClubs %}
                <div class="alert alert-warning mt-3 shadow-sm rounded-3 p-4 d-flex align-items-center">
                    <i class="fa-solid fa-building me-3 fs-4 text-warning"></i>
                    <span class="fw-bold">Toutes les rencontres du club <strong>{{ getNomClubCourant }}</strong></span>
                </div>
            {% elseif affichageByTerrain %}
                <div class="alert alert-success mt-3 shadow-sm rounded-3 p-4 d-flex align-items-center">
                    <i class="fa-solid fa-map-location-dot me-3 fs-4 text-success"></i>
                    <span class="fw-bold">Toutes les rencontres du terrain <strong>{{ listeDesRencontresByTerrain[0]['terrain_nom'] }}</strong></span>
                </div>
            {% elseif IdPoules != null %}
                <div class="alert alert-primary mt-3 shadow-sm rounded-3 p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h3 class="mb-0">
                            <i class="fa-solid fa-futbol me-2"></i> Rencontres par poule
                        </h3>
                    </div>
                    {% if IsRankingView == 1 %}
                        <a href="#classementTableau" class="btn btn-success btn-sm fw-bold">
                            Voir le classement <i class="fa-solid fa-ranking-star ms-1"></i>
                        </a>
                    {% endif %}
                </div>
            {% endif %}

            {# Gestion des labels #}
            {% set current_time = "now"|date("H:i") %}
            {% set labels_to_display = labels|filter(label => label['creneau_horaire'] > current_time) %}
            {% set grouped_labels = [] %}
            {% set seen_creneaux = [] %}
            {% for label in labels_to_display %}
                {% if label['creneau_horaire'] not in seen_creneaux %}
                    {% set grouped_labels = grouped_labels|merge([label]) %}
                    {% set seen_creneaux = seen_creneaux|merge([label['creneau_horaire']]) %}
                {% endif %}
            {% endfor %}
            {% if grouped_labels|length > 0 %}
                <div class="alert alert-primary p-4 rounded shadow-sm" role="alert" id="labels">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-circle-info me-2 text-info" style="font-size: 1.5rem;"></i>
                        <h5 class="mb-0">Informations du tournoi</h5>
                    </div>
                    <div class="d-flex flex-column">
                        {% for label in grouped_labels %}
                            <div class="d-flex align-items-center">
                                <i class="fa-solid fa-check-circle me-2 text-success" style="font-size: 1.2rem;"></i>
                                <span>
                                    <strong>{{ label['creneau_horaire'] }}</strong> -> {{ label['labels'] }}
                                </span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
            {# fin Gestion des labels #}
           
            <div class="row mt-3">
