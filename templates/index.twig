                                                                {{ equipe.terrain_nom|upper }}
                                                            </span>
                                                        </a>
                                                    {% endif %}
                                                    <!-- Arbitre -->
                                                    {% if gestionArbitres == 1 and (equipe.arbitre_nom or equipe.arbitre_club_nom) %}
