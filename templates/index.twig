                                                                <div class="text-muted small">
                                                                    <span>
                                                                        Sponsorisé par
                                                                        <strong>
                                                                            <a href="{{ sponsor.lien_web }}" target="_blank" rel="noopener" style="text-decoration: none; outline: none;">
                                                                                {{ sponsor.nom }}
                                                                            </a>
                                                                        </strong>
                                                                    </span>
                                                                    {% if sponsor.description %}
                                                                        <br>
                                                                        <em>
                                                                            {{ sponsor.description }}
                                                                        </em>
                                                                    {% endif %}
                                                                </div>
                                                                {% if sponsor.logo %}
                                                                    <a href="{{ sponsor.lien_web }}" target="_blank" rel="noopener">
                                                                        <img src="{{ sponsor.logo }}" alt="{{ sponsor.nom }}" class="img-thumbnail ms-2" style="max-width: 80px; max-height: 60px;">
                                                                    </a>
                                                                {% endif %}
                                                            </div>
                                                        {% endif %}
                                                    </li>
                                                {% endfor %}
                                            </li>
                                        </ul>
                                    {% endif %}
                                {% endif %}
                            </div>
                            <div class="col-lg-3 choisirEquipe">
                                {% if idTournoi %}
                                    {% if IdClub %}
                                        {% if visibility == 1 %}
                                            <div class="bg-success bg-opacity-10 border border-success rounded-3 p-3 shadow-sm">
                                                <div class="d-flex justify-content-between">
                                                    <div>
                                                        <h4 class="mb-1 fw-bold text-success">
                                                            <i class="fas fa-users me-2"></i>
                                                            Choisir une équipe
                                                        </h4>
                                                        <small class="text-muted">
                                                            Sélectionnez votre équipe pour continuer
                                                        </small>
                                                    </div>
                                                    <img src="favicon.ico" alt="Logo Brackito" class="img-thumbnail" style="height:50px; width:auto; align-self:start;">
                                                </div>
                                            </div>
                                        {% endif %}
                                    {% endif %}
                                    <ul class="list-group no-bullet">
                                        {% for equipe in equipesAvecPoule %}
                                            <li>
                                                {% if equipe.idPoule != null %}

                                                    {% if labels.length > 0 or planTournoi is not null %}
                                                    <a href="index.php?id_tournoi={{ idTournoi }}&id_club={{ IdClub }}&id_equipe={{ equipe.id }}&idPoule={{ equipe.idPoule }}#labels " class="list-group-item list-group-item-action">
                                                        {{ equipe.nom|upper }}
                                                        -
                                                        {{ equipe.Nom_categorie }}
                                                    </a>
                                                    {% else %}
                                                    <a href="index.php?id_tournoi={{ idTournoi }}&id_club={{ IdClub }}&id_equipe={{ equipe.id }}&idPoule={{ equipe.idPoule }}#score" class="list-group-item list-group-item-action">
                                                        {{ equipe.nom|upper }}
                                                        -
                                                        {{ equipe.Nom_categorie }}

                                                    </a>
                                                    {% endif %}
                                                    {% if partenaires is not empty %}
                                                        {% set randIndex = random(0, partenaires|length - 1) %}
                                                        {% set sponsor = partenaires[randIndex] %}
                                                        <div class="d-flex align-items-center justify-content-between p-2 border rounded bg-light mt-1">
                                                            <div class="text-muted small">
                                                                <span>
                                                                    Sponsorisé par
                                                                    <strong>
                                                                        <a href="{{ sponsor.lien_web }}" target="_blank" rel="noopener" style="text-decoration: none; outline: none;">
                                                                            {{ sponsor.nom }}
                                                                        </a>
                                                                    </strong>
                                                                </span>
                                                                {% if sponsor.description %}
                                                                    <br>
                                                                    <em>
                                                                        {{ sponsor.description }}
                                                                    </em>
                                                                {% endif %}
                                                            </div>
                                                            {% if sponsor.logo %}
                                                                <a href="{{ sponsor.lien_web }}" target="_blank" rel="noopener">
                                                                    <img src="{{ sponsor.logo }}" alt="{{ sponsor.nom }}" class="img-thumbnail ms-2" style="max-width: 80px; max-height: 60px;">
                                                                </a>
                                                            {% endif %}
                                                        </div>
                                                    {% endif %}
                                                {% endif %}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </div>
                            <div class="col-lg-3">
                                {% if visibility == 1 %}
                                    {% if IdEquipe and affichageByClubs is not defined %}
                                        <div class="alert alert-success mt-2">
                                            <h4>
                                                <i class="fas fa-check-circle"></i>
                                                Dernière étape: Choisir la poule
                                            </h4>
                                        </div>
                                    {% endif %}
                                {% endif %}
                            </div>




      <div class="container mt-3 {% if idclub is null and idIdPoules is null and IdEquipe is null %}d-none{% endif %}">
    <!-- Card avec logo et slogan -->
