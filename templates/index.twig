                                                <h5>
                                                    <span class="badge text-bg-dark fs-6 p-1">{{ equipe.equipe2_nom|upper }}</span>
                                                </h5>
                                            </a>
                                            <a href="index.php?id_tournoi={{idTournoi}}&id_equipe={{equipe.equipe2_id}}&id_club={{equipe.club2_id}}&affichageByClubs=true">
                                                <img src="{{ equipe.club2_logo }}" class="w-100 img-fluid w-md-50 w-lg-50" alt="{{ equipe.equipe2_nom|upper }}">
                                            </a>
                                        </div>
                                    </td>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-sm-12 col-12">
