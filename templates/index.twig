                        <a href="index.php"><img src="logos/Logo.png" alt="Logo Brackito" class="me-3"></a>
            </div>
            <span class="text-muted fst-italic">
                Simplifiez l'organisation de vos compétitions avec notre outil tout-en-un pensé pour les clubs de sport.
            </span>
        </div>
    </div>

    <!-- Colonne unique -->
    <div class="row justify-content-center {% if idclub is null and idIdPoules is null and IdEquipe is null %}d-none{% endif %}">
        <div class="col-sm-6 d-flex flex-column gap-3">

            <!-- Encadré des poules -->
                <div class="card border-primary shadow-sm rounded-3 p-3">
                 {% if IdPoules != null %}
                    <!-- Bouton classement uniquement à côté du dernier -->
                   
                    <div class="d-flex justify-content-between align-items-center mb-3" style="border-bottom:2px solid #0d6efd; padding-bottom:5px;">
                        <h5 class="card-title text-primary fw-bold d-flex align-items-center gap-2 mb-0">
                            <i class="fas fa-users"></i> 
                            {% if afficherLesPoules | length > 1 %} Vos poules {% else %} Votre poule {% endif %}
                        </h5>
                        
                        {% if IsRankingView == 1 %}
                            <a href="#classementTableau" class="btn btn-success btn-sm fw-bold d-flex align-items-center gap-1">
                                <i class="fa-solid fa-ranking-star"></i> Classement
                            </a>
                        {% endif %}
                    </div>

                   
                {% endif %}
                    <div class="d-flex flex-column gap-2">
                        {% for poule in afficherLesPoules %}
                            <a href="index.php?id_tournoi={{ idTournoi }}&idPoule={{ poule.id }}&id_club={{ IdClub }}&id_equipe={{ IdEquipe }}#score"
                            class="btn {% if IdPoules == poule.id %}btn-primary{% else %}btn-outline-primary{% endif %} w-100">
                                {{ poule.nom|upper }}
                            </a>
                        {% endfor %}
                    </div>
                </div>


                                <!-- Rencontres du club -->
                    <div class="card shadow-sm border-warning rounded-3 mb-3 p-3 text-center">
                        {% if affichageByClubs %}
                            {% set btnClass = "btn-warning" %}
                        {% else %}
                            {% set btnClass = "btn-outline-warning" %}
                        {% endif %}
                        <h6 class="fw-bold text-warning mb-2 d-flex align-items-center justify-content-center gap-2">
                            <i class="fas fa-building"></i> Rencontres du club
                        </h6>
                        <a href="index.php?id_tournoi={{ idTournoi }}&id_club={{ IdClub }}&id_equipe={{ IdEquipe }}&affichageByClubs=true#score"
                        class="btn {{ btnClass }} fw-bold w-100 w-sm-auto">
                            {{ getNomClubCourant }}
                            <img src="{{ logoClub }}" alt="Logo du club {{ getNomClubCourant }}" class="img-fluid ms-2" style="max-height:30px; max-width:30px; vertical-align: middle;">
                        </a>
                    </div>

                    <!-- Rencontres de l'équipe -->
                    <div class="card shadow-sm border-primary rounded-3 mb-3 p-3 text-center">
                        {% if affichageByTeam %}
                            {% set btnClass = "btn-primary" %}
                        {% else %}
                            {% set btnClass = "btn-outline-primary" %}
                        {% endif %}
                        <h6 class="fw-bold text-primary mb-2 d-flex align-items-center justify-content-center gap-2">
                            <i class="fas fa-users"></i> Rencontres de l'équipe
                        </h6>
                        <a href="index.php?id_tournoi={{ idTournoi }}&id_club={{ IdClub }}&id_equipe={{ IdEquipe }}&affichageByTeam=true#score"
                        class="btn {{ btnClass }} fw-bold w-100 w-sm-auto">
                            {{ getNomEquipeCourant }}
                        </a>
                    </div>


        </div>
    </div>
</div>




                            
                        </div>
                    </div>
                {% endif %}
                
                {# Gestion des labels #}
                {% set current_time = "now"|date("H:i") %}
                {% set labels_to_display = labels|filter(label => label['creneau_horaire'] > current_time) %}
                {% set grouped_labels = [] %}
                {% set seen_creneaux = [] %}
                {% for label in labels_to_display %}
                    {% if label['creneau_horaire'] not in seen_creneaux %}
                        {% set grouped_labels = grouped_labels|merge([label]) %}
                        {% set seen_creneaux = seen_creneaux|merge([label['creneau_horaire']]) %}
                    {% endif %}
                {% endfor %}
                {% if grouped_labels|length > 0 or planTournoi is not null %}
                    




<div class="alert alert-primary p-4 rounded shadow-sm" role="alert" id="labels">
    <div class="d-flex align-items-center mb-3">
        <i class="fa-solid fa-circle-info me-2 text-info" style="font-size: 1.5rem;"></i>
        <h5 class="mb-0">Informations</h5>
    </div>

    <div class="d-flex flex-row justify-content-between">
        <!-- Partie Labels -->
        <div class="d-flex flex-column">
        
            {% for label in grouped_labels %}
                <div class="d-flex align-items-center mb-2">
                    <i class="fa-solid fa-check-circle me-2 text-success" style="font-size: 1.2rem;"></i>
                    <span>
                        <strong>{{ label['creneau_horaire'] }}</strong>
                        ->
                        {{ label['labels'] }}
                    </span>
                </div>
                
            {% endfor %}
        </div>
       
        <!-- Aperçu du plan -->
        {% if planTournoi is defined and planTournoi is not null %}
            <div class="ms-6 text-center" style="margin-top: -50px; margin-right: -20px;">
                <h6 class="fw-bold text-secondary">📍 Plan des terrains</h6>
                <img 
                    src="{{ planTournoi }}" 
                    alt="Plan du tournoi" 
                    class="img-thumbnail shadow-sm" 
                    style="max-width: 100px; cursor: pointer; margin-right: -20px;" 
                    data-bs-toggle="modal" 
                    data-bs-target="#planModal"
                >
            </div>
        {% endif %}
    </div>
</div>
 
{% if planTournoi is defined and planTournoi is not null %}
    <!-- Modal Bootstrap -->
    <div class="modal fade" id="planModal" tabindex="-1" aria-labelledby="planModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header mt-5">
                    <h5 class="modal-title" id="planModalLabel">Plan des terrains</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body text-center">
                    <img src="{{ planTournoi }}" alt="Plan complet du tournoi" class="img-fluid rounded shadow">
                </div>
            </div>
        </div>
    </div>
{% endif %}












                {% endif %}

               
                {# fin Gestion des labels #}
                <div class="row mt-3">
                    <div class="col-lg-12 col-md-6 col-sm-12 col-12" id="score">
                        <div class="table-responsive">
                            <table class="table table-striped table-sm">
                                <thead>
                                    <tr>
                                        {% if affichageByTeam != null or affichageByClubs != null or affichageByTerrain != null or IdPoules != null %}
                                            <th scope="col" class="col-lg-2 col-md-3 col-sm-4 text-center">
                                                <i class="fas fa-futbol"></i>
                                                Equipe1
                                            </th>
                                            <th scope="col" class="col-lg-1 col-md-2 col-sm-4 text-center">
                                                <i class="fas fa-info-circle"></i>
                                                Informations
                                            </th>
                                            <th scope="col" class="col-lg-2 col-md-3 col-sm-4 text-center">
                                                <i class="fas fa-futbol"></i>
                                                Equipe2
                                            </th>
                                        {% endif %}
                                    </tr>
                                </thead>
                                <tbody>
                                    {% if affichageByClubs %}
                                        {% set rencontres = listeDesRencontreByClubs %}
                                    {% endif %}
                                    {% if affichageByTeam %}
                                        {% set rencontres = listeDesRencontreByTeam %}
                                    {% endif %}
                                    {% if affichageByTerrain %}
                                        {% set rencontres = listeDesRencontresByTerrain %}
                                    {% endif %}
                                    {% if IdPoules %}
                                        {% set rencontres = RencontreByPoule %}
                                    {% endif %}
                                    {% for equipe in rencontres %}
                                        {% if equipe.score1 != 0 or equipe.score2 !=0 %}
                                            <tr
                                            class="table-success">
                                                {% else %}
                                                <tr>
                                                {% endif %}
                                                <td class="text-center p-0">
                                                    <div class="d-flex flex-column align-items-center m-0 p-0">
                                                        <a href="index.php?id_tournoi={{ idTournoi }}&id_equipe={{ equipe.equipe1_id }}&id_club={{ equipe.club1_id }}&affichageByTeam=true">
                                                            <h4>
                                                                <span class="badge text-bg-dark p-1">
                                                                    {{ equipe.equipe1_nom|upper }}
                                                                </span>
                                                            </h4>
                                                        </a>
                                                        <a href="index.php?id_tournoi={{ idTournoi }}&id_equipe={{ equipe.equipe1_id }}&id_club={{ equipe.club1_id }}&affichageByClubs=true">
                                                            <img src="{{ equipe.club1_logo }}" class="w-100 img-fluid w-md-50 w-lg-50" alt="{{ equipe.equipe1_nom|upper }}">
                                                        </a>
                                                    </div>
                                                </td>
                                                <td class="align-middle text-center">
                                                    <!-- Heure -->
                                                    {% if heureIsVisible == 1 and equipe.creneau_nom is not empty %}
                                                        <div class="mb-2 p-2 bg-light rounded shadow-sm d-inline-flex align-items-center">
                                                            <i class="fas fa-clock me-2 text-primary"></i>
                                                            <span class="fw-bold">
                                                                {{ equipe.creneau_nom|slice(0, -3) }}
                                                            </span>
                                                        </div>
                                                    {% endif %}
                                                    <!-- Terrain -->
                                                    {% if nbrTerrains > 1 and equipe.terrain_nom != 0 %}
                                                        <a href="index.php?id_tournoi={{ idTournoi }}&terrain={{ equipe.terrain_id }}&id_club={{ IdClub }}&id_equipe={{ IdEquipe }}&affichageByTerrain=true" class="d-inline-block mb-2 text-decoration-none">
                                                            <span class="badge rounded-pill bg-success px-3 py-2 shadow">
