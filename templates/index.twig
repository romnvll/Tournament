                                {% endif %}
                                {% if affichageByTerrain %}
                                    {% set rencontres = listeDesRencontresByTerrain %}
                                {% endif %}
                                {% if IdPoules %}
                                    {% set rencontres = RencontreByPoule %}
                                {% endif %}
                                {% for equipe in rencontres %}
                                    {% if equipe.score1 != 0 or equipe.score2 !=0 %}
                                        <tr class="table-success">
                                    {% else %}
                                        <tr>
                                    {% endif %}
                                    
                                     
                                    <td class="align-middle text-center">
                                        <div class="d-flex flex-column align-items-center">
                                            <a href="index.php?id_tournoi={{idTournoi}}&id_equipe={{equipe.equipe1_id}}&id_club={{equipe.club1_id}}&affichageByTeam=true">
                                                <h4> 
                                                    <span class="badge text-bg-dark fs-6 p-1">{{ equipe.equipe1_nom|upper }}</span>
                                                </h4>
                                            </a>
                                            <a href="index.php?id_tournoi={{idTournoi}}&id_equipe={{equipe.equipe1_id}}&id_club={{equipe.club1_id}}&affichageByClubs=true">
                                                <img src="{{ equipe.club1_logo }}" class="w-100 img-fluid w-md-50 w-lg-50" alt="{{ equipe.equipe1_nom|upper }}">
                                            </a>
                                        </div>
                                    </td>
                                    <td class="align-middle text-center">

                                        <div class="d-flex justify-content-center flex-column align-items-center mt-2">
                                           

                                              {% if heureIsVisible == 1 %}
                                                    {% if not equipe.creneau_nom is empty %}
                                                    <p class="fw-bold">
                                                    <i class="fas fa-clock"></i>
                                                    {{ equipe.creneau_nom|slice(0, -3) }}
                                                    </p>                                          
                                                 {% else %}
                                           
                                                <span class="badge bg-warning text-dark">
                                                    A planifier
                                                </span>
                                                    
                                                {% endif %}
                                            {% endif %}

                                    </div>

                                     <div class="d-flex justify-content-center flex-column align-items-center mb-2 position-relative">
                                           {% if nbrTerrains > 1 %} 
                                            {% if equipe.terrain_nom != 0 %}
                                        
                                            <a href="index.php?id_tournoi={{idTournoi}}&terrain={{equipe.terrain_id}}&id_club={{IdClub}}&id_equipe={{IdEquipe}}&affichageByTerrain=true">
                                                <img src="img/football.png" class="w-100 img-fluid w-md-50 w-lg-50" alt="terrain">
                                                <h6 class="position-absolute top-50 start-50 translate-middle">
                                                    <span class="badge rounded-pill bg-danger">{{ equipe.terrain_nom }}</span>
                                                </h6>
                                            </a>
                                        
                                    
                                        {% endif %}
                                        {% endif %}
                                     </div>

                                     
                                        <div class="d-flex justify-content-center flex-column align-items-center mb-2">
                                            {% if gestionArbitres == 1 and equipe.arbitre_nom or equipe.arbitre_club_nom %}
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-user-tie"></i><i class="material-icons me-2" style="color: black; font-size: 20px;">sports</i>
                                                    <span>{{ equipe.arbitre_nom|capitalize  }} {{ equipe.arbitre_club_nom|upper }}</span>
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="d-flex justify-content-center flex-nowrap mb-2">
                                            
                                            <span class="badge" style="background-color: {{ equipe.equipe2_categorie_couleur }}; color: #000;">
                                                {{ equipe.equipe2_categorie_nom }} 
                                            </span>
                                        </div>
                                        <div class="d-flex justify-content-center flex-nowrap">
                                            {% if equipe.score1 > equipe.score2 %}
                                                <span class="badge bg-success">{{ equipe.score1 }}</span>-
                                                <span class="badge bg-danger">{{ equipe.score2 }}</span>
                                            {% elseif equipe.score1 < equipe.score2 %}
                                                <span class="badge bg-danger">{{ equipe.score1 }}</span>-
                                                <span class="badge bg-success">{{ equipe.score2 }}</span>
                                            {% elseif equipe.score1 is same as(equipe.score2) and (equipe.score1 is not null or equipe.score2 is not null) %}
                                                <span class="badge bg-secondary">{{ equipe.score1 }}</span>-
                                                <span class="badge bg-secondary">{{ equipe.score2 }}</span>
                                            {% elseif equipe.score1 or equipe.score2 == null %}
                                                <span class="badge bg-secondary">0</span>-
                                                <span class="badge bg-secondary">0</span>
                                            {% endif %}
                                        </div>
                                        <div class="d-flex justify-content-center mt-2">
                                            {% if equipe.isTerminated == 0 %}
                                                <span class="badge bg-warning text-dark">À venir</span>
                                            {% elseif equipe.isTerminated == 1 %}
                                                <span class="badge bg-danger">Rencontre terminée</span>
                                            {% elseif equipe.isTerminated == 2 %}
                                                <span class="badge bg-info text-dark d-inline-flex align-items-center">
                                                    <span class="spinner-grow spinner-grow-sm me-2" role="status" aria-hidden="true"></span>
                                                    Rencontre en cours
                                                </span>
                                            {% endif %}
                                        </div>

                                         {% if partenaires is not empty %}
                                            {% set randIndex = random(0, partenaires|length - 1) %}
                                            {% set sponsor = partenaires[randIndex] %}
                                                    <div class="d-flex align-items-center justify-content-between p-2 border rounded bg-light mt-1">
                                                        <div class="text-muted small">
                                                            <span>Sponsorisé par <strong><a href="{{ sponsor.lien_web }}" target="_blank" rel="noopener" style="text-decoration: none; outline: none;">{{ sponsor.nom }}</a></strong></span>
