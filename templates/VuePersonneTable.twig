<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <title>Gestion de la table</title>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://unpkg.com/htmx.org@latest/dist/htmx.min.js"></script>
    <style>
        body {
            background-color: #f8f9fa;
        }
        .container-fluid {
            padding: 20px;
        }
        .table th, .table td {
            vertical-align: middle;
        }
        .table img {
            max-width: 50px;
        }
        .btn-success, .btn-danger {
            margin: 2px;
        }
        .badge {
            font-size: 14px;
        }
        .lead {
            font-size: 16px;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row justify-content-center mb-4">
            <div class="col text-center">
                <h2><i class="fas fa-user-check"></i> Bonjour {{ prenom }},</h2>
                <p>vous êtes en charge d'insérer les scores pour le terrain <b>{{ terrain }}</b>.</p>
            </div>
        </div>

        <div class="row">
            <div class="col-12" id="scoreRefresh">
                <table class="table table-striped table-responsive" id="myTable">
                    <thead>
                        <tr>
                            <th scope="col" class="text-center"><i class="fas fa-clock"></i> Heure</th>
                            <th scope="col order-2" class="w-25 text-center"><i class="fas fa-futbol"></i> Score équipe 1</th>
                            <th scope="col order-1" class="w-25 text-center"><i class="fas fa-futbol"></i> Score équipe 2</th>
                            <th scope="col"><i class="fas fa-info-circle"></i> Informations</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for planification in AffichagePlanification %}
                            <tr id="planification-{{ planification.rencontre_id }}">
                                {% if planification.rencontre_id is not null %}
                                    <td class="text-center">
                                        <h3><i class="fas fa-clock"></i> {{ planification.creneau_nom }}</h3>
                                    </td>
                                    <form action="vuePersonneTable_traitement.php" method="get" hx-target="#row-{{ planification.rencontre_id }}">
                                        <input type="hidden" name="return_id" value="row-{{ planification.rencontre_id }}">
                                        <td class="text-center order-2">
                                            <img src="{{ planification.club1_logo }}" class="img-fluid rounded">
                                            <p class="lead text-uppercase">{{ planification.equipe1_nom }}</p>
                                            <input type="hidden" name="scoreEquipe1" value="{{ planification.score1 }}" id="scoreEquipe1{{ planification.rencontre_id }}">
                                            <p>Score: <span id="displayScoreEquipe1{{ planification.rencontre_id }}">{{ planification.score1 }}</span></p>
                                            {% if planification.isTerminated == 0 or planification.isTerminated == 2 %}
                                                <button type="button" class="btn btn-success btn-lg" hx-post="vuePersonneTable_traitement.php?action=addGoal&idRencontre={{ planification.rencontre_id }}&team=1" hx-trigger="click" hx-on="htmx:afterRequest:vibrate(50)" hx-swap="innerHTML" hx-target="#displayScoreEquipe1{{ planification.rencontre_id }}" {% if planification.est_premier_zero == false %} disabled {% endif %}><i class="fas fa-plus"></i> But +</button>
                                                <button type="button" class="btn btn-danger btn-sm order-md-last" hx-post="vuePersonneTable_traitement.php?action=removeGoal&idRencontre={{ planification.rencontre_id }}&team=1" hx-on="htmx:afterRequest:vibrate(200)" hx-trigger="click" hx-swap="innerHTML" hx-target="#displayScoreEquipe1{{ planification.rencontre_id }}" {% if planification.est_premier_zero == false %} disabled {% endif %}><i class="fas fa-minus"></i> But -</button>
                                            {% endif %}
                                        </td>
                                        <td class="text-center order-1">
                                            <img src="{{ planification.club2_logo }}" class="img-fluid rounded">
                                            <p class="lead text-uppercase">{{ planification.equipe2_nom }}</p>
                                            <input type="hidden" name="scoreEquipe2" value="{{ planification.score2 }}" id="scoreEquipe2{{ planification.rencontre_id }}">
                                            <p>Score: <span id="displayScoreEquipe2{{ planification.rencontre_id }}">{{ planification.score2 }}</span></p>
                                            {% if planification.isTerminated == 0 or planification.isTerminated == 2 %}
                                                <button type="button" class="btn btn-success btn-lg" hx-post="vuePersonneTable_traitement.php?action=addGoal&idRencontre={{ planification.rencontre_id }}&team=2" hx-trigger="click" hx-on="htmx:afterRequest:vibrate(50)" hx-swap="innerHTML" hx-target="#displayScoreEquipe2{{ planification.rencontre_id }}" {% if planification.est_premier_zero == false %} disabled {% endif %}><i class="fas fa-plus"></i> But +</button>
                                                <button type="button" class="btn btn-danger btn-sm order-md-last" hx-post="vuePersonneTable_traitement.php?action=removeGoal&idRencontre={{ planification.rencontre_id }}&team=2" hx-trigger="click" hx-on="htmx:afterRequest:vibrate(200)" hx-swap="innerHTML" hx-target="#displayScoreEquipe2{{ planification.rencontre_id }}" {% if planification.est_premier_zero == false %} disabled {% endif %}><i class="fas fa-minus"></i> But -</button>
                                            {% endif %}
                                        </td>
                                        <td class="align-left">
                                            <table class="table table-borderless mb-0">
                                                <tbody>
                                                    <tr>
                                                        <td><strong>Status :</strong></td>
                                                        <td>
                                                            {% if planification.isTerminated == 1 %}
                                                                <span class="badge bg-danger"><i class="fas fa-times-circle"></i> Rencontre terminée</span>
                                                            {% else %}
                                                                {% if planification.est_premier_zero == true %}
                                                                    {% if planification.isTerminated == 0 %}
                                                                        <span class="badge bg-danger"><i class="fas fa-exclamation-circle"></i> Saisir le score</span>
                                                                    {% elseif planification.isTerminated == 2 %}
                                                                        <a class="badge bg-primary" id="State{{ planification.rencontre_id }}" role="button" onclick="updateStatus({{ planification.rencontre_id }})"><i class="fas fa-sync-alt"></i> En cours</a>
                                                                    {% endif %}
                                                                {% endif %}
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td><strong>Catégorie:</strong></td>
                                                        <td>
                                                            <span class="badge" style="background-color: {{ planification.Couleur }}; color: #000;"><i class="fas fa-tag"></i> {{ planification.categorie_equipe1_nom }}</span>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td><strong>Arbitre:</strong></td>
                                                        <td><i class="fas fa-user-tie"></i> {{ planification.arbitre_nom }} {{planification.arbitre_club_nom}} </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </td>
                                    </form>
                                {% elseif planification.label_description is not null %}
                                    <td class="w-25 text-center">
                                        <h3><i class="fas fa-clock"></i> {{ planification.creneau_nom }}</h3>
                                    </td>
                                    <td class="w-25 text-center"><p>{{ planification.label_description }}</p></td>
                                    <td>
                                        
                                    </td>
                                    <td></td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
       function updateStatus(idRencontre) {
    if (confirm('Es-tu sûr de vouloir mettre à jour le statut ?')) {
        const target = `#State${idRencontre}`;

        const handler = function(evt) {
            if (evt.target.id === `State${idRencontre}`) {
                document.body.removeEventListener('htmx:afterSwap', handler);
                location.reload();
            }
        };

        document.body.addEventListener('htmx:afterSwap', handler);

        htmx.ajax('POST', `vuePersonneTable_traitement.php?action=updateStatus&idRencontre=${idRencontre}`, {
            target: target,
            swap: 'outerHTML'
        });
    }
}


        function vibrate(temps) {
            if (navigator.vibrate) {
                navigator.vibrate(temps);
            }
        }

        $(document).ready(function () {
            setTimeout(function () {
                location.reload(true);
            }, 30000);
        });
    </script>
</body>
</html>
