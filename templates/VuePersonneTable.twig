<script>
    function updateStatus(idRencontre) {
        if (confirm('Es-tu sûr de vouloir mettre à jour le statut ?')) {
            const target = `#State${idRencontre}`;

            const handler = function(evt) {
                if (evt.target.id === `State${idRencontre}`) {
                    document.body.removeEventListener('htmx:afterSwap', handler);
                    location.reload();
                }
            };

            document.body.addEventListener('htmx:afterSwap', handler);

            htmx.ajax('POST', `vuePersonneTable_traitement.php?action=updateStatus&idRencontre=${idRencontre}`, {
                target: target,
                swap: 'outerHTML'
            });
        }
    }

    function vibrate(temps) {
       

        if (navigator.vibrate) {
            navigator.vibrate(temps);
           
        }
        

    }
  $(document).ready(function () {
    // Restaure la position si elle a été sauvegardée
    const savedScroll = sessionStorage.getItem('scrollPos');
    if (savedScroll) {
        window.scrollTo(0, parseInt(savedScroll));
        sessionStorage.removeItem('scrollPos');
    }

    // Sauvegarde la position avant le rechargement automatique
    setTimeout(function () {
        sessionStorage.setItem('scrollPos', window.scrollY);
        location.reload(true);
    }, 30000);
});
    
