<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if infoTournoi %}{{ infoTournoi.nom }} — Brackito TV{% else %}Brackito TV{% endif %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;900&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <style>
        :root {
            --bg:        #f0f4f8;
            --surface:   #ffffff;
            --surface2:  #e8eef5;
            --border:    rgba(0,0,0,0.10);
            --accent:    #1d4ed8;
            --accent2:   #7c3aed;
            --win:       #16a34a;
            --loss:      #dc2626;
            --draw:      #64748b;
            --gold:      #d97706;
            --text:      #0f172a;
            --muted:     #475569;
            --radius:    14px;
            --font-head: 'Barlow Condensed', sans-serif;
            --font-body: 'Barlow', sans-serif;
            --cat-color: {{ donneesCat.categorie.Couleur ?? '#1d4ed8' }};
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            width: 100%; height: 100%;
            background: var(--bg);
            color: var(--text);
            font-family: var(--font-body);
            overflow: hidden;
        }

        /* ── LAYOUT ─────────────────────────────────────────── */
        .tv-shell {
            display: grid;
            grid-template-rows: 72px 1fr 56px;
            height: 100vh;
            width: 100vw;
        }

        /* ── HEADER ─────────────────────────────────────────── */
        .tv-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
            background: var(--surface);
            border-bottom: 2px solid var(--border);
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
            gap: 20px;
        }
        .header-left {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
            flex: 1;
        }
        .header-logo {
            width: 44px; height: 44px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--cat-color);
            flex-shrink: 0;
        }
        .header-title {
            font-family: var(--font-head);
            font-size: 1.7rem;
            font-weight: 900;
            letter-spacing: 0.04em;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: var(--text);
        }
        .header-center {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }
        .cat-badge {
            font-family: var(--font-head);
            font-size: 1.3rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            padding: 5px 20px;
            border-radius: 30px;
            border: 2px solid var(--cat-color);
            color: var(--cat-color);
            white-space: nowrap;
            background: rgba(0,0,0,0.03);
        }
        .cat-dots { display: flex; gap: 7px; align-items: center; }
        .cat-dot {
            width: 9px; height: 9px;
            border-radius: 50%;
            background: #cbd5e1;
            flex-shrink: 0;
            transition: transform 0.3s;
        }
        .cat-dot.active {
            background: var(--cat-color);
            transform: scale(1.4);
        }
        .progress-ring { width: 38px; height: 38px; flex-shrink: 0; }
        .progress-ring circle { fill: none; stroke-width: 3; stroke-linecap: round; }
        .progress-ring .bg   { stroke: #cbd5e1; }
        .progress-ring .fill {
            stroke: var(--cat-color);
            stroke-dasharray: 94.2;
            stroke-dashoffset: 94.2;
        }
        .header-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
        .header-clock {
            font-family: var(--font-head);
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text);
            letter-spacing: 0.08em;
            min-width: 90px;
            text-align: right;
        }

        /* ── MAIN ────────────────────────────────────────────── */
        .tv-main {
            display: grid;
            grid-template-columns: 280px 1fr 500px;
            overflow: hidden;
        }

        /* ── PANNEAU GAUCHE ──────────────────────────────────── */
        .panel-matches {
            display: flex;
            flex-direction: column;
            overflow: hidden;
            padding: 14px 14px 14px 20px;
            border-right: 2px solid var(--border);
            gap: 12px;
        }

        .section-title {
            font-family: var(--font-head);
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .section-title::after {
            content: ''; flex: 1; height: 1px; background: var(--border);
        }

        /* EN COURS */
        .matches-live { flex-shrink: 0; }

        .match-live-card {
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding: 12px 16px;
            background: var(--surface);
            border-radius: var(--radius);
            border: 2px solid rgba(220,38,38,0.30);
            margin-bottom: 8px;
            box-shadow: 0 2px 8px rgba(220,38,38,0.08);
        }

        .match-live-top {
            display: grid;
            grid-template-columns: 1fr 100px 1fr;
            align-items: center;
            gap: 8px;
        }

        .match-live-bottom {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
        }

        .live-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-family: var(--font-head);
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            color: var(--loss);
            padding: 2px 8px;
            border-radius: 20px;
            border: 1px solid rgba(220,38,38,0.35);
            margin-bottom: 3px;
        }
        .live-dot {
            width: 6px; height: 6px;
            border-radius: 50%;
            background: var(--loss);
            animation: livePulse 1.2s infinite;
        }
        @keyframes livePulse {
            0%,100% { opacity:1; transform:scale(1); }
            50%     { opacity:0.3; transform:scale(0.65); }
        }

        /* À VENIR */
        .matches-upcoming {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
            overflow: hidden;
        }

        .progress-bar-mini {
    width: 60px;
    height: 6px;
    background: var(--border);
    border-radius: 3px;
    overflow: hidden;
}
.progress-bar-fill {
    height: 100%;
    background: var(--win);
    border-radius: 3px;
    transition: width 0.3s ease;
}


        .scroll-container {
            flex: 1;
            overflow: hidden;
            position: relative;
        }
        .scroll-fade-top {
            position: absolute; top:0; left:0; right:0; height:24px;
            background: linear-gradient(to bottom, var(--bg), transparent);
            z-index: 2; pointer-events: none;
        }
        .scroll-fade-bot {
            position: absolute; bottom:0; left:0; right:0; height:24px;
            background: linear-gradient(to top, var(--bg), transparent);
            z-index: 2; pointer-events: none;
        }
        .scroll-track {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        .scroll-track.scrolling {
            animation: scrollUp var(--dur, 20s) linear infinite;
        }
        @keyframes scrollUp {
            0%   { transform: translateY(0); }
            100% { transform: translateY(var(--dist, -50%)); }
        }

        .match-row {
            display: grid;
            grid-template-columns: 52px 1fr 60px 1fr;
            align-items: center;
            gap: 10px;
            padding: 9px 14px;
            background: var(--surface);
            border-radius: 10px;
            border: 1px solid var(--border);
            flex-shrink: 0;
        }
        .match-row:nth-child(even) { background: var(--surface2); }

        /* Équipes */
        .team-block { display:flex; align-items:center; gap:8px; min-width:0; }
        .team-block.right { flex-direction:row-reverse; text-align:right; }
        .team-logo-sm {
            width:26px; height:26px; border-radius:50%;
            object-fit:cover; flex-shrink:0; border:1px solid var(--border);
        }
        .team-logo-lg {
            width:32px; height:32px; border-radius:50%;
            object-fit:cover; flex-shrink:0; border:1px solid var(--border);
        }
        .team-name-sm {
            font-family:var(--font-head); font-size:0.95rem; font-weight:600;
            white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
        }
        .team-name-lg {
            font-family:var(--font-head); font-size:0.95rem; font-weight:700;
            white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
        }

        /* Scores live */
        .score-live { display:flex; flex-direction:column; align-items:center; gap:4px; flex-shrink:0; }
        .scores-row {
            display:flex; align-items:center; gap:4px;
            font-family:var(--font-head); font-size:1.6rem; font-weight:900;
        }
        .score-bubble {
            min-width:36px; text-align:center;
            padding:2px 7px; border-radius:8px; border:1.5px solid;
        }
        .s-win  { background:#dcfce7; color:var(--win);  border-color:#86efac; }
        .s-lose { background:#fee2e2; color:var(--loss); border-color:#fca5a5; }
        .s-draw { background:#f1f5f9; color:var(--muted); border-color:#cbd5e1; }
        .score-sep { color:var(--muted); font-size:1.1rem; }

        .terrain-chip {
            font-family:var(--font-head); font-size:1rem; font-weight:600;
            color:var(--muted); background:var(--surface2);
            padding:2px 8px; border-radius:10px;
        }
        .time-badge {
            font-family:var(--font-head); font-size:0.85rem; font-weight:700;
            color:var(--accent); letter-spacing:0.04em;
        }
        .score-vs {
            font-family:var(--font-head); font-size:0.8rem; font-weight:700;
            color:var(--muted); text-align:center;
        }

        /* ── PANNEAU DROIT ───────────────────────────────────── */
        .panel-right {
            display:flex; flex-direction:column;
            overflow:hidden;
            padding:14px 20px 14px 14px;
            gap:12px;
        }
        .ranking-block {
            flex:1; overflow:hidden;
            display:flex; flex-direction:column; min-height:0;
        }
        .ranking-scroll-container {
            flex:1; overflow:hidden; position:relative;
        }
        .ranking-fade-top {
            position:absolute; top:0; left:0; right:0; height:24px;
            background: linear-gradient(to bottom, var(--bg), transparent);
            z-index:2; pointer-events:none;
        }
        .ranking-fade-bot {
            position:absolute; bottom:0; left:0; right:0; height:24px;
            background: linear-gradient(to top, var(--bg), transparent);
            z-index:2; pointer-events:none;
        }
        .ranking-scroll-track {
            display:flex; flex-direction:column;
        }
        .ranking-scroll-track.scrolling {
            animation: scrollUp var(--dur, 20s) linear infinite;
        }

        table.ranking { width:100%; border-collapse:collapse; font-size:0.84rem; }
        table.ranking thead th {
            font-family:var(--font-head); font-size:0.7rem; font-weight:700;
            letter-spacing:0.1em; text-transform:uppercase;
            color:var(--muted); padding:0 6px 8px;
            border-bottom:2px solid var(--border);
            text-align:center;
        }
        table.ranking thead th:nth-child(2) { text-align:left; }
        table.ranking tbody tr { border-bottom:1px solid var(--border); }
        table.ranking tbody tr:last-child { border-bottom:none; }
        table.ranking tbody tr.rank-1 { background:rgba(217,119,6,0.09); }
        table.ranking tbody tr.rank-2 { background:rgba(100,116,139,0.06); }
        table.ranking tbody tr.rank-3 { background:rgba(180,120,60,0.06); }
        table.ranking td { padding:7px 6px; text-align:center; vertical-align:middle; }
        table.ranking td:nth-child(2) { text-align:left; }

        .rank-pos { font-family:var(--font-head); font-weight:900; font-size:1.05rem; }
        .rank-pos.gold   { color:var(--gold); }
        .rank-pos.silver { color:#64748b; }
        .rank-pos.bronze { color:#cd7f32; }

        .rank-team { display:flex; align-items:center; gap:8px; }
        .rank-team-name {
            font-family:var(--font-head); font-size:0.95rem; font-weight:600;
            white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:140px;
        }
        .pts-badge {
            display:inline-block; background:var(--accent); color:#fff;
            font-family:var(--font-head); font-weight:700; font-size:0.85rem;
            padding:2px 9px; border-radius:6px; min-width:30px; text-align:center;
        }
        .poule-divider {
            font-family:var(--font-head); font-size:0.7rem; font-weight:700;
            letter-spacing:0.1em; text-transform:uppercase;
            color:var(--accent2); padding:6px 6px 4px;
            border-bottom:1px solid rgba(124,58,237,0.2);
            background:rgba(124,58,237,0.05);
        }

        /* SPONSORS */
        .sponsors-strip { flex-shrink:0; }
        .sponsors-title {
            font-family:var(--font-head); font-size:0.68rem; font-weight:700;
            letter-spacing:0.12em; text-transform:uppercase;
            color:var(--muted); margin-bottom:6px;
        }
        .sponsors-list { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
        .sponsor-item {
            display:flex; align-items:center; gap:6px;
            background:var(--surface2); border:1px solid var(--border);
            border-radius:8px; padding:4px 10px;
            font-size:0.78rem; font-weight:600;
            color:var(--text); text-decoration:none;
        }
        .sponsor-logo-sm { height:20px; object-fit:contain; border-radius:3px; }

        /* ── FOOTER ──────────────────────────────────────────── */
        .tv-footer {
            display:flex; align-items:center; justify-content:space-between;
            padding:0 24px; background:var(--surface);
            border-top:2px solid var(--border);
            box-shadow:0 -2px 12px rgba(0,0,0,0.07);
            gap:16px; overflow:hidden;
        }
        .footer-brand {
            font-family:var(--font-head); font-size:1rem; font-weight:900;
            letter-spacing:0.12em; color:var(--accent); flex-shrink:0;
        }
        .ticker-wrap {  overflow:hidden; position:relative; }
        .ticker-wrap::before,
        .ticker-wrap::after {
            content:''; position:absolute; top:0; bottom:0; width:40px; z-index:2;
        }
        .ticker-wrap::before { left:0;  background:linear-gradient(90deg,  var(--surface), transparent); }
        .ticker-wrap::after  { right:0; background:linear-gradient(270deg, var(--surface), transparent); }
        .ticker {
            display:flex; gap:56px; white-space:nowrap;
            animation:tickerAnim 40s linear infinite;
        }
        .ticker-item {
            font-family:var(--font-head); font-size:0.9rem; font-weight:600;
            letter-spacing:0.05em; color:var(--muted);
            display:inline-flex; align-items:center; gap:7px;
        }
        .ticker-item i { color:var(--gold); }
        @keyframes tickerAnim {
            0%   { transform:translateX(0); }
            100% { transform:translateX(-50%); }
        }
        .footer-date {
            font-family:var(--font-head); font-size:0.9rem; font-weight:600;
            color:var(--muted); flex-shrink:0;
        }

        /* PICKER */
        .tournoi-picker {
            display:flex; flex-direction:column;
            align-items:center; justify-content:center;
            height:100vh; gap:28px; padding:40px;
        }
        .tournoi-picker h1 {
            font-family:var(--font-head); font-size:2.5rem; font-weight:900;
            letter-spacing:0.06em; color:var(--accent);
        }
        .tournoi-list { display:flex; flex-wrap:wrap; gap:14px; justify-content:center; max-width:800px; }
        .tournoi-link {
            padding:16px 28px; background:var(--surface);
            border:2px solid var(--border); border-radius:var(--radius);
            text-decoration:none; color:var(--text);
            font-family:var(--font-head); font-size:1.15rem; font-weight:700;
            letter-spacing:0.04em; transition:all 0.2s;
            display:flex; align-items:center; gap:10px;
        }
        .tournoi-link:hover { background:var(--accent); border-color:var(--accent); color:#fff; }

        .empty-state {
            display:flex; flex-direction:column;
            align-items:center; justify-content:center;
            gap:10px; color:var(--muted);
            font-family:var(--font-head); font-size:0.95rem;
            padding:20px; height:100%;
        }
        .empty-state i { font-size:1.8rem; opacity:0.35; }

        * { scrollbar-width:none; }
        *::-webkit-scrollbar { display:none; }
    </style>
</head>
<body>

{% if infoTournoi is null %}
{# ── Sélecteur de tournoi ── #}
<div class="tournoi-picker">
    <h1><i class="fas fa-trophy"></i> &nbsp;Brackito TV</h1>
    <p style="color:var(--muted);font-family:var(--font-head);font-size:1.1rem;">Sélectionnez un tournoi :</p>
    <div class="tournoi-list">
        {% for t in listeTournois %}
            {% if t.isVisible == 1 and t.isArchived == 0 %}
            <a href="tv_display.php?id_tournoi={{ t.id }}" class="tournoi-link">
                <i class="fas fa-calendar-alt"></i>{{ t.nom }}
            </a>
            {% endif %}
        {% endfor %}
    </div>
</div>

{% else %}

{% set cat     = donneesCat.categorie %}
{% set couleur = cat.Couleur ?? '#1d4ed8' %}

<div class="tv-shell">

    {# ══ HEADER ══════════════════════════════════════════ #}
    <header class="tv-header">

        <div class="header-left">
            {% if infoTournoi.logo_club %}
                <img src="{{ infoTournoi.logo_club }}" alt="{{ infoTournoi.nom_club }}" class="header-logo">
            {% endif %}
            <div style="display: flex; align-items: center; gap: 12px;">
    <span class="header-title">{{ infoTournoi.nom|upper }}</span>
    <div style="display: flex; align-items: center; gap: 8px;">
        <span class="matches-badge">
            <i class="fas fa-calendar-alt"></i>
            {{ nombreRencontresTerminees }} / {{ nombreRencontresPlanifiees }}
        </span>
        <div class="progress-bar-mini">
 <div class="progress-bar-fill"
     style="width: {{ nombreRencontresPlanifiees > 0
        ? ((nombreRencontresTerminees / nombreRencontresPlanifiees) * 100)|round(1)
        : 0 }}%;">
</div>

        </div>
    </div>
</div>
        </div>

        <div class="header-center">
            <span class="cat-badge">{{ cat.Nom_categorie|upper }}</span>

            <div class="cat-dots">
                {% for d in donneesCategories %}
                    <div class="cat-dot{% if loop.index0 == catIndex %} active{% endif %}"></div>
                {% endfor %}
            </div>

            <svg class="progress-ring" viewBox="0 0 38 38">
                <circle class="bg"   cx="19" cy="19" r="15"/>
                <circle class="fill" cx="19" cy="19" r="15"
                        id="progressRing"
                        transform="rotate(-90 19 19)"
                        stroke-dasharray="94.2"
                        stroke-dashoffset="94.2"/>
            </svg>
        </div>

        <div class="header-right">
            <span class="header-clock" id="clock">--:--:--</span>
        </div>

    </header>

    {# ══ MAIN ═════════════════════════════════════════════ #}
    <main class="tv-main">

        {# ── Panneau gauche : matchs EN COURS ── #}
        <div class="panel-matches" style="border-right: 2px solid var(--border); border-left: none;">

            {% if donneesCat.enCours|length > 0 %}
            <div class="matches-live">
                <div class="section-title">
                    <span style="display:inline-flex;align-items:center;gap:5px;color:var(--loss);">
                        <span class="live-dot"></span>EN COURS
                    </span>
                </div>
                {% for r in donneesCat.enCours %}
                <div class="match-live-card">
                    {# Ligne 1 : équipe 1 — score — équipe 2 #}
                    <div class="match-live-top">
                        <div class="team-block">
                            {% if r.club1_logo %}<img src="{{ r.club1_logo }}" class="team-logo-lg" alt="{{ r.equipe1_nom }}" loading="lazy">{% endif %}
                            <div style="min-width:0;">
                                <div class="team-name-lg">{{ r.equipe1_nom|upper }}</div>
                                {% if r.equipe1_coach_nom %}<div style="font-size:0.7rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ r.equipe1_coach_nom }}</div>{% endif %}
                            </div>
                        </div>

                        <div class="score-live">
                            <div class="live-pill"><span class="live-dot"></span>LIVE</div>
                            <div class="scores-row">
                                <span class="score-bubble {% if r.score1 > r.score2 %}s-win{% elseif r.score1 < r.score2 %}s-lose{% else %}s-draw{% endif %}">{{ r.score1 ?? 0 }}</span>
                                <span class="score-sep">–</span>
                                <span class="score-bubble {% if r.score2 > r.score1 %}s-win{% elseif r.score2 < r.score1 %}s-lose{% else %}s-draw{% endif %}">{{ r.score2 ?? 0 }}</span>
                            </div>
                        </div>

                        <div class="team-block right">
                            {% if r.club2_logo %}<img src="{{ r.club2_logo }}" class="team-logo-lg" alt="{{ r.equipe2_nom }}" loading="lazy">{% endif %}
                            <div style="min-width:0;text-align:right;">
                                <div class="team-name-lg">{{ r.equipe2_nom|upper }}</div>
                                {% if r.equipe2_coach_nom %}<div style="font-size:0.7rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ r.equipe2_coach_nom }}</div>{% endif %}
                            </div>
                        </div>
                    </div>

                    {# Ligne 2 : terrain centré #}
                    {% if r.terrain_nom %}
                    <div class="match-live-bottom">
                        <span class="terrain-chip"><i class="fas fa-location-dot"></i> {{ r.terrain_nom }}</span>
                    </div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
            {% else %}
            <div class="empty-state">
                <i class="fas fa-futbol"></i>
                Aucun match en cours
            </div>
            {% endif %}

        </div>{# /panneau gauche #}

        {# ── Panneau centre : classement ── #}
        <div class="panel-right" style="border-right: 2px solid var(--border);">

            <div class="ranking-block">
