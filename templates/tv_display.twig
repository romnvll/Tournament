{# ══════════════════════════════════════════════════════════
   JAVASCRIPT — effets uniquement
   1. Horloge
   2. Anneau de progression + redirection PHP (changement de catégorie)
   3. Défilement vertical rencontres & classement
══════════════════════════════════════════════════════════ #}
<script>
const ROTATION_TIME = {{ rotationTime }};
const IS_LAST_CAT   = {{ isLastCat ? 'true' : 'false' }};
const NEXT_URL      = "tv_display.php?id_tournoi={{ idTournoi }}&cat={{ nextCatIndex }}&rotation={{ rotationTime }}";
const RELOAD_URL    = "tv_display.php?id_tournoi={{ idTournoi }}&cat=0&rotation={{ rotationTime }}";

/* ── 1. Horloge ─────────────────────────────────────────── */
function updateClock() {
    const now = new Date();
    const p   = n => String(n).padStart(2,'0');
    document.getElementById('clock').textContent =
        `${p(now.getHours())}:${p(now.getMinutes())}:${p(now.getSeconds())}`;
    const jours = ['Dim','Lun','Mar','Mer','Jeu','Ven','Sam'];
    const mois  = ['jan','fév','mar','avr','mai','juin','juil','août','sep','oct','nov','déc'];
    document.getElementById('footerDate').textContent =
        `${jours[now.getDay()]} ${p(now.getDate())} ${mois[now.getMonth()]} ${now.getFullYear()}`;
}
setInterval(updateClock, 1000);
updateClock();

/* ── 2. Anneau de progression + redirection ─────────────── */
(function () {
    const ring = document.getElementById('progressRing');
    if (!ring) return;
    requestAnimationFrame(() => {
        ring.style.transition = `stroke-dashoffset ${ROTATION_TIME}s linear`;
        ring.style.strokeDashoffset = '0';
    });
    setTimeout(() => {
        window.location.href = IS_LAST_CAT ? RELOAD_URL : NEXT_URL;
    }, ROTATION_TIME * 1000);
})();

/* ── 3. Défilement vertical ─────────────────────────────── */
const SCROLL_PX_PER_SEC = 40; // vitesse en px/s — ajuster si besoin

function initScroll(trackId, cloneId, containerId) {
    const track     = document.getElementById(trackId);
    const clone     = document.getElementById(cloneId);
    const container = track ? track.closest('.scroll-container, .ranking-scroll-container') : null;
    if (!track || !clone || !container) return;

    // Attendre que le layout soit calculé
    requestAnimationFrame(() => {
        const containerH = container.clientHeight;
        const contentH   = track.scrollHeight;

        if (contentH <= containerH) return; // Rien à défiler

        // Afficher et injecter le clone à la suite
        clone.style.display = '';
        const singleH = contentH;
        const dur     = Math.round(singleH / SCROLL_PX_PER_SEC);

        track.style.setProperty('--dist', `-${singleH}px`);
        track.style.setProperty('--dur',  `${dur}s`);
        track.classList.add('scrolling');
    });
}

window.addEventListener('load', () => {
    initScroll('upcomingTrack', 'upcomingClone');
    initScroll('rankingTrack',  'rankingClone');
});
</script>

