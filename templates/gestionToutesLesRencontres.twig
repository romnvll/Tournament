				}
				/* Masquer le bouton lors de l'impression */
				.no-print {
					display: none !important;
				}

                 

			}


            .touch-friendly {
                    width: 40px;
                    height: 40px;
                    border-radius: 50%;
                    cursor: pointer;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    margin: 5px;
                    touch-action: manipulation;
                }
		</style>

	</head>

	<body>
