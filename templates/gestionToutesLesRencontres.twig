 {% if tournoiInfo.gestionVoix == 1 %}
	<button onclick="ouvrirLectureAudio({{creneau.creneau_id }})" class="btn btn-primary">
    🎧 Lancer la lecture audio
</button>
{% endif %}

										</td>
										{% set Displayed = false %}
										{% for j in 0..terrains|length - 1 %}
