			</script>
		
<script>
document.querySelectorAll('div[data-terrain-id]').forEach(container => {
    let mediaRecorder;
    let audioChunks = [];

    const recordBtn = container.querySelector('.btn-record');
    const stopBtn = container.querySelector('.btn-stop');
    const playBtn = container.querySelector('.btn-play');
    const audioElement = container.querySelector('.audio-preview');

    const idTournoi = container.dataset.tournoiId;
    const idTerrain = container.dataset.terrainId;

    recordBtn.addEventListener('click', async () => {
        try {
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            mediaRecorder = new MediaRecorder(stream);
            audioChunks = [];

            mediaRecorder.ondataavailable = event => {
                audioChunks.push(event.data);
            };

            mediaRecorder.onstop = async () => {
                const audioBlob = new Blob(audioChunks, { type: 'audio/wav' });
                const formData = new FormData();
                formData.append('audio', audioBlob, 'audio.wav');
                formData.append('idTournoi', idTournoi);
                formData.append('idTerrain', idTerrain);

                const response = await fetch('upload_audio.php', {
                    method: 'POST',
                    body: formData
                });

                if (response.ok) {
                    // Recharge la source audio avec un timestamp pour forcer le rechargement
                    const timestamp = new Date().getTime();
                    audioElement.src = `Audio/${idTournoi}/Terrain/${idTerrain}.wav?${timestamp}`;
                    playBtn.disabled = false;
                } else {
                    alert("Erreur lors de l'enregistrement");
                }
            };

            mediaRecorder.start();
            recordBtn.disabled = true;
            stopBtn.disabled = false;
            playBtn.disabled = true;
        } catch (err) {
            alert("Impossible d'accéder au microphone : " + err.message);
        }
    });

    stopBtn.addEventListener('click', () => {
        if (mediaRecorder && mediaRecorder.state !== 'inactive') {
            mediaRecorder.stop();
            recordBtn.disabled = false;
            stopBtn.disabled = true;
        }
    });

    playBtn.addEventListener('click', () => {
        audioElement.play();
    });
});

</script>


<script>
function ouvrirLectureAudio(idCreneau) {
    const url = `lectureAudio.php?idCreneau=${idCreneau}`;
    const options = 'width=400,height=200,menubar=no,location=no,resizable=no,scrollbars=no,status=no';
    window.open(url, '_blank', options);
}
</script>


<script>
function majHorloge() {
    const maintenant = new Date();
    const heures = String(maintenant.getHours()).padStart(2, '0');
    const minutes = String(maintenant.getMinutes()).padStart(2, '0');
    const secondes = String(maintenant.getSeconds()).padStart(2, '0');
    document.getElementById("horloge").textContent = `${heures}:${minutes}:${secondes}`;
}

// Met à jour immédiatement puis toutes les secondes
majHorloge();
setInterval(majHorloge, 1000);
</script>


