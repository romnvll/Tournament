							</tbody>
						</table>
					</div>
				</div>
			</div>


			<script>
				$(document).ready(function () {
$('.rencontreLabel .form-select').on('change', function () {
var $form = $(this).closest('form');
var formAction = $form.attr('action');
var formData = $form.serialize();

$.post(formAction, formData, function () {
location.reload();
});
});
});
			</script>

<script>
  // Stocker la position de défilement avant de quitter la page
  window.onload = function() {
    if (typeof(sessionStorage) !== 'undefined') {
      var scrollPosition = sessionStorage.getItem('scrollPosition');
      if (scrollPosition !== null) {
        window.scrollTo(0, scrollPosition);
      }
    }
  };

  window.onbeforeunload = function() {
    if (typeof(sessionStorage) !== 'undefined') {
      sessionStorage.setItem('scrollPosition', window.scrollY);
    }
  };
</script>
			


			<script>
				// Initialiser tous les tooltips sur la page
var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
tooltipTriggerList.forEach(function (tooltipTriggerEl) {
new bootstrap.Tooltip(tooltipTriggerEl);
});
			</script>
		
<script>
document.querySelectorAll('.btn-record').forEach(button => {
    button.addEventListener('click', async function () {
        const container = this.closest('div');
        const idTournoi = container.dataset.tournoiId;
        const idTerrain = container.dataset.terrainId;

        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        const mediaRecorder = new MediaRecorder(stream);
        const audioChunks = [];

        mediaRecorder.ondataavailable = event => {
            audioChunks.push(event.data);
        };

        mediaRecorder.onstop = async () => {
            const audioBlob = new Blob(audioChunks, { type: 'audio/wav' });
            const formData = new FormData();
            formData.append('audio', audioBlob, 'audio.wav');
            formData.append('idTournoi', idTournoi);
            formData.append('idTerrain', idTerrain);

            const response = await fetch('upload_audio.php', {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                const audioElement = container.querySelector('.audio-preview');
                const playButton = container.querySelector('.btn-play');

                // Forcer le rechargement du fichier
                const timestamp = new Date().getTime();
                audioElement.src = `Audio/${idTournoi}/Terrain/${idTerrain}.wav?${timestamp}`;
                playButton.disabled = false;
            } else {
                alert("Erreur lors de l'enregistrement");
            }
        };

        mediaRecorder.start();
        setTimeout(() => mediaRecorder.stop(), 3000); // 3 secondes
    });
});

// Lecture
document.querySelectorAll('.btn-play').forEach(button => {
    button.addEventListener('click', function () {
        const audio = this.closest('div').querySelector('.audio-preview');
        audio.play();
    });
});
</script>


<script>
function ouvrirLectureAudio(idCreneau) {
    const url = `lectureAudio.php?idCreneau=${idCreneau}`;
    const options = 'width=400,height=200,menubar=no,location=no,resizable=no,scrollbars=no,status=no';
    window.open(url, '_blank', options);
}
</script>


	</body>

