<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <title>Gestion rencontre</title>
    <style>
        :root {
            --primary-color: #4f46e5;
            --primary-hover: #4338ca;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            --info-color: #06b6d4;
            --body-bg: #f3f4f6;
            --card-bg: #ffffff;
            --text-main: #1f2937;
        }

        body {
            background-color: var(--body-bg);
            color: var(--text-main);
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            font-size: 0.95rem;
        }

        .main-container {
            padding: 2rem 1rem;
        }

        .section-card {
            background: var(--card-bg);
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            margin-bottom: 1.5rem;
            padding: 1.5rem;
        }

        .poule-nav-btn {
            margin: 0.25rem;
            transition: all 0.2s ease;
            font-weight: 500;
        }

        .table-custom {
            margin-top: 1rem;
            vertical-align: middle;
        }

        .table-custom thead th {
            background-color: #f9fafb;
            color: #4b5563;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.05em;
        }

        .action-zone-yellow {
            background-color: #fef3c7;
            border-left: 4px solid var(--warning-color);
            border-radius: 6px;
            padding: 1rem;
        }

        .action-zone-blue {
            background-color: #e0f2fe;
            border-left: 4px solid var(--info-color);
            border-radius: 6px;
            padding: 1rem;
        }

        /* Responsive Mobile tweaks */
        @media (max-width: 767px) {
            .table-desktop-view { display: none; }
            .mobile-team-cards { display: block; }
        }
        @media (min-width: 768px) {
            .mobile-team-cards { display: none; }
            .table-desktop-view { display: table; }
        }
    </style>
</head>
<body>
    {{ include('header.twig') }}
    
    {% set dateFin = licence.date_fin|date('Y-m-d')|date %}
    {% set today = "now"|date('Y-m-d')|date %}

    <div class="container-fluid main-container">
        
        <!-- BARRE TOP : Sélection des tournois -->
        <div class="section-card d-flex flex-wrap gap-2 align-items-center">
            <span class="fw-bold me-2 text-muted text-uppercase small">Tournois :</span>
            {% set lastTournoiIdParent = null %}
            {% for tournoi in TournoisDeBase %}
                {% if tournoi.isArchived == 0 %}
                    {% set lastTournoiIdParent = tournoi.id %}
                    <a href="gestionRencontresPhaseClassement.php?idTournoiBase={{ tournoi.id }}" 
                       class="btn {% if idTournoi == tournoi.id %}btn-danger shadow-sm{% else %}btn-outline-secondary{% endif %} btn-sm rounded-pill px-3">
                        <i class="fas fa-trophy me-1"></i> {{ tournoi.nom }}
                    </a>
                {% endif %}
            {% endfor %}
        </div>


        
        <div class="row g-4">
            
            <!-- COLONNE GAUCHE : Poules & Classement Équipes -->
            <div class="col-lg-7">
                <div class="section-card">
                    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
                        <h4 class="mb-0 fw-bold">
                            <i class="fas fa-cubes text-primary me-2"></i>Sélection des poules
                        </h4>
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                            Total : <strong>{{ NombreEquipeParPoules }}</strong> Équipes
                        </span>
                    </div>
                  
                    <!-- Boutons des poules -->
                    <div class="mb-4">
                        {% for poule in afficherLesPoules %}
                            <a href="gestionRencontresPhaseClassement.php?idTournoiBase={{ idTournoi }}&idPoule={{ poule.id }}&idCategorie={{ poule.fk_idcategorie }}" 
                               class="btn poule-nav-btn {% if pouleEnCours == poule.id %}btn-primary shadow{% else %}btn-light border text-secondary{% endif %} btn-sm rounded" 
                               role="button">
                                {{ poule.nom }}
                            </a>
                        {% endfor %}
                    </div>
                    {% if (idCategorieEnCours) %}
                    <!-- Zone Actions Automatiques Contextuelles : deux carrés côte à côte -->
                    {% set categoriesDejaAffichees = [] %}
                    <div class="row g-3 mb-4">
                        <!-- Carré 1 : Répartition par classement (1ers ensemble, 2èmes ensemble...) -->
                        <div class="col-md-6">
                            <div class="action-zone-yellow h-100">
                                <div class="small text-amber-800 fw-bold mb-2">
                                    <i class="fas fa-robot me-1"></i> <strong>Répartition par classement :</strong>
                                </div>
                                <p class="text-muted small mb-3">
                                    En un clic, le système va basculer automatiquement les équipes de cette catégorie vers les poules finales à droite, en regroupant les équipes selon leur position au classement (les 1ers ensemble, les 2èmes ensemble, etc.).
                                </p>
                                <div class="d-flex flex-wrap gap-2">
                                    {% for poule in afficherLesPoules %}
                                        {% if poule.fk_idcategorie not in categoriesDejaAffichees %}
                                            <a href="gestionRencontrePhaseClassement_traitement.php?autoClassement=1&tournoiId={{ idTournoi }}&categorieId={{ poule.fk_idcategorie }}"
                                            class="btn btn-warning btn-sm text-dark fw-semibold shadow-sm"
                                            onclick="return confirm('Voulez-vous dispatcher automatiquement toutes les équipes de cette catégorie dans les poules de classement selon leurs résultats actuels ?')">
                                                <i class="fas fa-magic me-1"></i> Répartir la catégorie {{ poule.nom | split(' ')[0] }}
                                            </a>
                                            {% set categoriesDejaAffichees = categoriesDejaAffichees|merge([poule.fk_idcategorie]) %}
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                        </div>

                        <!-- Carré 2 : Répartition Haute / Basse -->
                        <div class="col-md-6">
                            <div class="action-zone-blue h-100">
                                <div class="small text-info-800 fw-bold mb-2">
                                    <i class="fas fa-arrows-alt-v me-1"></i> <strong>Répartition Haute / Basse :</strong>
                                </div>
                                <p class="text-muted small mb-3">
                                    En un clic, le système va répartir chaque poule en deux : les meilleures équipes en <strong>Poule Haute</strong>, les autres en <strong>Poule Basse</strong>.
                                </p>
                                <div class="d-flex flex-wrap gap-2">
                                    {% set categoriesDejaAfficheesHB = [] %}
                                    {% for poule in afficherLesPoules %}
                                        {% if poule.fk_idcategorie not in categoriesDejaAfficheesHB %}
                                            <a href="gestionRencontrePhaseClassement_traitement.php?autoHauteBasse=1&tournoiId={{ idTournoi }}&categorieId={{ poule.fk_idcategorie }}"
                                            class="btn btn-info btn-sm text-dark fw-semibold shadow-sm"
                                            onclick="return confirm('Voulez-vous répartir automatiquement les équipes de cette catégorie en Poule Haute / Poule Basse selon leurs résultats actuels ?')">
                                                <i class="fas fa-arrows-alt-v me-1"></i> Haute/Basse {{ poule.nom | split(' ')[0] }}
                                            </a>
                                            {% set categoriesDejaAfficheesHB = categoriesDejaAfficheesHB|merge([poule.fk_idcategorie]) %}
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
                    <!-- Tableau de classement (Desktop) -->
                    <div class="table-responsive">
                        <table class="table table-custom table-hover border align-middle table-desktop-view">
                            <thead>
                                <tr>
                                    <th>Nom de l'équipe</th>
                                    <th class="text-center">Points</th>
                                    <th class="text-center">BP</th>
                                    <th class="text-center">BC</th>
                                    <th class="text-center">Diff</th>
                                    <th>Ajouter à la phase</th>
                                    <th>Poule Actuelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for equipe in ResultatDesPoules %}
                                    <tr>
                                        <td class="fw-bold text-dark">{{ equipe.nom }}</td>
                                        <td class="text-center fw-bold text-primary">{{ equipe.TotalDesPoints }}</td>
                                        <td class="text-center text-muted">{{ equipe.nombreButsMarque }}</td>
                                        <td class="text-center text-muted">{{ equipe.nombreButsEncaisse }}</td>
                                        <td class="text-center fw-bold {% if equipe.DifferenceButs >= 0 %}text-success{% else %}text-danger{% endif %}">
                                            {{ equipe.DifferenceButs > 0 ? '+' : '' }}{{ equipe.DifferenceButs }}
                                        </td>
                                        <td id="section-{{ equipe.id }}">
                                            <div class="d-flex flex-wrap gap-1">
                                                {% for poule in afficherLespoulesFinales %}
                                                    {% if equipe.categorie == poule.fk_idcategorie %}
                                                        <a href="gestionRencontrePhaseClassement_traitement.php?addpoule=1&idequipe={{ equipe.id }}&pouleId={{ poule.id }}&tournoiId={{ idTournoi }}#section-{{ equipe.id }}" 
                                                           class="btn btn-xs btn-outline-success py-1 px-2 rounded-pill small" style="font-size: 0.8rem;">
                                                            <i class="fas fa-plus me-1"></i>{{ poule.nom }}
                                                        </a>
                                                    {% endif %}
                                                {% endfor %}
                                            </div>
                                        </td>
                                        <td>
                                            {% for poule in equipe.poules %}
                                                {% if poule.is_classement == 1 %}
                                                    <a href="gestionRencontrePhaseClassement_traitement.php?delete=1&idequipe={{ equipe.id }}&pouleId={{ poule.id }}&tournoiId={{ idTournoi }}"
                                                       class="btn btn-outline-danger btn-sm py-1 px-2"
                                                       onclick="return confirm('Retirer l\'équipe de la poule ?')">
                                                        <i class="fas fa-times me-1"></i> {{ poule.nom }}
                                                    </a>
                                                {% endif %}
                                            {% endfor %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <!-- Mode Mobile Cards -->
                    <div class="mobile-team-cards mt-3">
                        {% for equipe in ResultatDesPoules %}
                            <div class="card border mb-3 shadow-sm rounded-3" id="section-mobile-{{ equipe.id }}">
                                <div class="card-header bg-light fw-bold d-flex justify-content-between">
                                    <span>{{ equipe.nom }}</span>
                                    <span class="text-primary">{{ equipe.TotalDesPoints }} Pts</span>
                                </div>
                                <div class="card-body py-2 px-3 small">
                                    <div class="row text-center text-muted border-bottom pb-2 mb-2">
                                        <div class="col-4">Marqués: <strong>{{ equipe.nombreButsMarque }}</strong></div>
                                        <div class="col-4">Encaissés: <strong>{{ equipe.nombreButsEncaisse }}</strong></div>
                                        <div class="col-4">Diff: <strong class="{% if equipe.DifferenceButs >= 0 %}text-success{% else %}text-danger{% endif %}">{{ equipe.DifferenceButs }}</strong></div>
                                    </div>
                                    <div class="mb-2">
                                        <div class="text-muted mb-1"><i class="fas fa-plus-circle me-1"></i> Ajouter à :</div>
                                        {% for poule in afficherLespoulesFinales %}
                                            {% if equipe.categorie == poule.fk_idcategorie %}
                                                <a href="gestionRencontrePhaseClassement_traitement.php?addpoule=1&idequipe={{ equipe.id }}&pouleId={{ poule.id }}&tournoiId={{ idTournoi }}#section-{{ equipe.id }}" class="btn btn-sm btn-light border text-success m-1">
                                                    {{ poule.nom }}
                                                </a>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                    {% if equipe.poules|length > 0 %}
                                        <div class="border-top pt-2">
                                            {% for poule in equipe.poules %}
                                                {% if poule.is_classement == 1 %}
                                                    <a href="gestionRencontrePhaseClassement_traitement.php?delete=1&idequipe={{ equipe.id }}&pouleId={{ poule.id }}#section-{{ equipe.id }}"
                                                       class="btn btn-sm btn-danger text-white w-100" onclick="return confirm('Retirer de la poule ?')">
                                                        <i class="fas fa-trash-alt me-1"></i> Quitter {{ poule.nom }}
                                                    </a>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- COLONNE DROITE : Création & Visualisation des Poules Finales -->
            <div class="col-lg-5">
                
                <!-- Bloc Création de Poule -->
                <div class="section-card">
                    <h4 class="fw-bold mb-3"><i class="fas fa-folder-plus text-success me-2"></i>Poules de classement</h4>
                    {% if pouleEnCours is not empty %}
                        <form action="GestionRencontresPhasesFinalesCreationPoules_traitement.php" method="GET" class="row g-2">
                            <input type="hidden" name="idtournoi" value="{{ idTournoi }}">
                            <input type="hidden" name="categorie" value="{{ idCategorieEnCours }}">
                            <div class="col-sm-8">
                                <input type="text" class="form-control" placeholder="Ex: Poule1erU15" name="pouledeClassement" required>
                            </div>
                            <div class="col-sm-4">
                                <button type="submit" class="btn btn-success w-100 text-nowrap">Créer la poule</button>
                            </div>
                        </form>
                    {% else %}
                        <div class="alert alert-info py-2 mb-0" role="alert">
                            <i class="fas fa-arrow-left me-2"></i> Veuillez d'abord choisir une poule à gauche.
                        </div>
                    {% endif %}
                </div>

                <!-- Liste des Poules Finales Existantes -->
                <div class="d-flex flex-column gap-3">
                    {% for poule in afficherLespoulesFinales %}
                        {% set nbEquipes = poule.contenu|length %}
                        {% set nbRencontresAttendu = (nbEquipes * (nbEquipes - 1)) / 2 %}
                        {% set nbLabelsPlaces = 0 %}
                        {% set poNom = poule.nom|trim %}

                        {% for label in nombreLabelsFinal %}
                            {% set parts = label.description|split(' - ', 2) %}
                            {% set labelSuffixe = parts[1]|default('')|trim %}
                            {% if labelSuffixe == poNom %}
                                {% set nbLabelsPlaces = nbLabelsPlaces + 1 %}
                            {% endif %}
                        {% endfor %}

                        <div class="card border-0 shadow-sm rounded-3 {% if poule.fk_idcategorie != idCategorieEnCours %}d-none{% endif %}">
                            <div class="card-header bg-white border-bottom py-3 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <span class="badge bg-indigo bg-primary fs-6 px-3 py-2 rounded shadow-sm">{{ poule.nom }}</span>

                                <span class="text-nowrap">
                                    Labels placés : {{ nbLabelsPlaces }} / <span id="nbRencontresAttendu_{{ poule.id }}" data-base="{{ nbRencontresAttendu }}">{{ nbRencontresAttendu }}</span>
                                </span>

                                <div class="d-flex align-items-center gap-2">
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input checkbox-retour" type="checkbox" id="switch_{{ poule.id }}" data-target="btnCreer_{{ poule.id }}" data-poule="{{ poule.id }}">
                                        <label class="form-check-label small text-muted" for="switch_{{ poule.id }}">Matches retour</label>
                                    </div>

                                    <a class="btn btn-primary btn-sm px-3" id="btnCreer_{{ poule.id }}"
                                       data-base-href="gestionRencontrePhaseClassement_traitement.php?CreerRencontre=1&pouleId={{ poule.id }}&tournoiId={{ idTournoi }}"
                                       href="gestionRencontrePhaseClassement_traitement.php?CreerRencontre=1&pouleId={{ poule.id }}&tournoiId={{ idTournoi }}&idCategorie={{idCategorieEnCours}}">
                                        <i class="fas fa-play me-1"></i> Générer matches
                                    </a>
                                </div>
                            </div>

                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        {% if poule.hasRencontres %}
                                            <span class="badge bg-success-soft text-success px-2 py-1 rounded"><i class="fas fa-check-circle me-1"></i> Rencontres générées</span>
                                        {% else %}
                                            <span class="badge bg-danger-soft text-danger px-2 py-1 rounded"><i class="fas fa-exclamation-triangle me-1"></i> En attente de génération</span>
                                        {% endif %}
                                    </div>
                                    {% if poule.contenu|length == 0 %}
                                        <a href="gestionRencontrePhaseClassement_traitement.php?suppressionPoule=1&pouleId={{ poule.id }}&tournoiId={{ idTournoi }}" 
                                           class="btn btn-link link-danger p-0" title="Supprimer la poule vide">
                                            <i class="fas fa-trash-alt"></i> Supprimer la poule
                                        </a>
                                    {% endif %}
                                </div>

                                {% if poule.contenu|length > 0 %}
                                    <table class="table table-sm table-borderless align-middle mb-0">
                                        <thead class="table-light">
                                            <tr style="font-size: 0.8rem;">
                                                <th>Équipe</th>
                                                <th class="text-center">Pts</th>
                                                <th class="text-center">Buts Diff</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for equipe in poule.contenu %}
                                                <tr class="border-bottom-dashed">
                                                    <td class="small fw-semibold">{{ equipe.nom }}</td>
                                                    <td class="text-center small">{{ equipe.TotalDesPoints }}</td>
                                                    <td class="text-center small text-muted">{{ equipe.DifferenceButs }}</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                {% else %}
                                    <p class="text-muted text-center my-3 small">Aucune équipe affectée à cette poule.</p>
                                {% endif %}
                            </div>
                        </div>
                    {% else %}
                        <p class="text-muted small">Aucune poule finale trouvée pour ce tournoi.</p>
                    {% endfor %}
                    
                    <!-- Gros Bouton Principal Tout en Bas à droite -->
                    <a href="PlacementDesRencontres.php?id_tournoi={{idTournoi}}" class="btn btn-indigo btn-primary py-3 shadow mt-3 fw-bold rounded-3">
                        <i class="fas fa-random me-2"></i> Placer et Planifier les rencontres
                    </a>
                </div>

            </div>
        </div>
    </div>

    <!-- SCRIPTS CONSERVÉS POUR LE PARCOURS UTILISATEUR -->
    <script>
        window.onload = function() {
            if (typeof(sessionStorage) !== 'undefined') {
                var scrollPosition = sessionStorage.getItem('scrollPosition');
                if (scrollPosition !== null) { window.scrollTo(0, scrollPosition); }
            }
        };
        window.onbeforeunload = function() {
            if (typeof(sessionStorage) !== 'undefined') {
                sessionStorage.setItem('scrollPosition', window.scrollY);
            }
        };

        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('checkbox-retour')) {
                const checkbox = e.target;
                const btn = document.getElementById(checkbox.dataset.target);
                const baseHref = btn.dataset.baseHref;
                btn.href = baseHref + (checkbox.checked ? '&creerRencontresRetour=true' : '');

                // Mise à jour du nombre de rencontres attendu
                const span = document.getElementById('nbRencontresAttendu_' + checkbox.dataset.poule);
                if (span) {
                    const base = parseInt(span.dataset.base, 10);
                    span.textContent = checkbox.checked ? base * 2 : base;
                }
            }
        });
    </script>
</body>
</html>
