<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Messagerie – {{ tournoiInfo.nom }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,500;0,9..40,700;1,9..40,300&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary:       #4f46e5;
            --primary-light: rgba(79,70,229,.08);
            --primary-glow:  rgba(79,70,229,.18);
            --danger:        #ef4444;
            --success:       #10b981;
            --info:          #06b6d4;
            --bg:            #f4f3ff;
            --surface:       #ffffff;
            --surface-2:     #f9f8ff;
            --border:        #e8e6fb;
            --text:          #1e1b4b;
            --text-muted:    #6b7280;
            --radius:        14px;
            --radius-sm:     8px;
            --shadow:        0 2px 12px rgba(79,70,229,.07);
            --shadow-md:     0 6px 24px rgba(79,70,229,.12);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: var(--bg);
            min-height: 100vh;
            font-family: 'DM Sans', sans-serif;
            color: var(--text);
        }

        .page-wrap {
            max-width: 960px;
            margin: 0 auto;
            padding: 32px 20px 60px;
        }

        .page-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 32px;
            flex-wrap: wrap;
        }

        .header-badge {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 10px 22px;
            border-radius: 99px;
            font-weight: 700;
            font-size: .92rem;
            background: var(--primary);
            color: #fff;
            letter-spacing: .01em;
        }

        .stats-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 14px;
            margin-bottom: 28px;
        }

        .stat-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 18px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: var(--shadow);
        }

        .stat-icon {
            width: 44px; height: 44px;
            border-radius: 10px;
            background: var(--primary-light);
            color: var(--primary);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .stat-label { font-size: .75rem; color: var(--text-muted); margin-bottom: 2px; }
        .stat-value { font-size: 1.3rem; font-weight: 700; }

        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 28px 30px;
            margin-bottom: 22px;
            box-shadow: var(--shadow);
        }

        .card-title {
            font-size: .7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .12em;
            color: var(--primary);
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .alert {
            border-radius: var(--radius-sm);
            padding: 14px 18px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 16px;
            font-size: .9rem;
        }
        .alert-success { background: rgba(16,185,129,.07); border: 1px solid rgba(16,185,129,.25); }
        .alert-danger  { background: rgba(239,68,68,.07);  border: 1px solid rgba(239,68,68,.25); }
        .alert-success i { color: var(--success); font-size: 1.1rem; margin-top: 1px; }
        .alert-danger  i { color: var(--danger);  font-size: 1.1rem; margin-top: 1px; }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 22px;
            margin-bottom: 24px;
        }

        .form-group { display: flex; flex-direction: column; gap: 8px; }

        .form-label {
            font-size: .84rem;
            font-weight: 600;
            color: var(--text);
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .form-label i { color: var(--primary); font-size: .9rem; }

        .form-select, .form-textarea {
            width: 100%;
            padding: 11px 14px;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            background: var(--surface);
            font-family: inherit;
            font-size: .9rem;
            color: var(--text);
            outline: none;
            transition: border-color .18s, box-shadow .18s;
        }
        .form-select:focus, .form-textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-glow);
        }

        .form-textarea {
            min-height: 110px;
            resize: vertical;
            margin-bottom: 20px;
        }

        .scope-hint {
            font-size: .78rem;
            color: var(--text-muted);
            margin-top: -16px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .scope-hint i { color: var(--info); }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 11px 26px;
            border-radius: var(--radius-sm);
            font-weight: 700;
            font-size: .9rem;
            border: none;
            cursor: pointer;
            transition: all .2s;
            font-family: inherit;
            letter-spacing: .01em;
        }
        .btn:hover { transform: translateY(-1px); }
        .btn:active { transform: translateY(0); }

        .btn-primary {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 3px 12px rgba(79,70,229,.3);
        }
        .btn-primary:hover {
            background: #4338ca;
            box-shadow: 0 6px 20px rgba(79,70,229,.4);
            color: #fff;
        }

        .btn-danger {
            background: rgba(239,68,68,.09);
            color: var(--danger);
            border: 1px solid rgba(239,68,68,.25);
            padding: 7px 14px;
            font-size: .8rem;
            box-shadow: none;
        }
        .btn-danger:hover {
            background: var(--danger);
            color: #fff;
            box-shadow: 0 4px 14px rgba(239,68,68,.35);
        }

        .btn-outline {
            background: var(--surface);
            color: var(--primary);
            border: 1px solid var(--border);
            padding: 7px 14px;
            font-size: .8rem;
            box-shadow: none;
        }
        .btn-outline:hover {
            background: var(--primary-light);
            color: var(--primary);
        }

        /* ── Liste des messages (historique) ──────────────── */
        .message-item {
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 18px 20px;
            margin-bottom: 14px;
            background: var(--surface-2);
        }

        .message-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 10px;
        }

        .scope-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 99px;
            font-size: .76rem;
            font-weight: 700;
            color: #fff;
        }
        .scope-categorie { background: var(--primary); }
        .scope-poule     { background: var(--info); }
        .scope-equipe    { background: var(--success); }

        .message-date {
            font-size: .76rem;
            color: var(--text-muted);
            white-space: nowrap;
        }

        .message-content {
            font-size: .92rem;
            color: var(--text);
            line-height: 1.5;
            margin-bottom: 12px;
            white-space: pre-wrap;
        }

        .message-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
        }

        .read-progress {
            font-size: .78rem;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .read-progress i { color: var(--success); }

        .message-actions { display: flex; gap: 8px; }

        /* ── Détail des destinataires ──────────────────────── */
        .recipient-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 14px;
            border-bottom: 1px solid var(--border);
            font-size: .86rem;
        }
        .recipient-row:last-child { border-bottom: none; }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 99px;
            font-size: .74rem;
            font-weight: 600;
        }
        .status-lu       { background: rgba(16,185,129,.1);  color: var(--success); }
        .status-recu     { background: rgba(6,182,212,.1);   color: var(--info); }
        .status-non_recu { background: rgba(107,114,128,.1); color: var(--text-muted); }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-muted);
        }
        .empty-state i { font-size: 2.2rem; opacity: .25; display: block; margin-bottom: 10px; }
        .empty-state p { font-size: .9rem; }

        @media (max-width: 700px) {
            .form-row { grid-template-columns: 1fr; }
            .card { padding: 20px 18px; }
        }
    </style>
</head>
<body>
    {{ include('header.twig') }}

    <div class="page-wrap">

        <div class="page-header">
            <span class="header-badge">
                <i class="fas fa-bell"></i> Messagerie
            </span>
        </div>

        {% for msg in messages %}
            <div class="alert alert-success">
                <i class="bi bi-check-circle-fill"></i>
                <span>{{ msg }}</span>
            </div>
        {% endfor %}
        {% for err in erreurs %}
            <div class="alert alert-danger">
                <i class="bi bi-x-circle-fill"></i>
                <span>{{ err }}</span>
            </div>
        {% endfor %}

        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-chat-dots-fill"></i></div>
                <div>
                    <div class="stat-label">Messages envoyés</div>
                    <div class="stat-value">{{ historiqueMessages | length }}</div>
                </div>
            </div>
        </div>

        <!-- Formulaire d'envoi -->
        <div class="card">
            <div class="card-title">
                <i class="bi bi-send"></i> Envoyer un message
            </div>

            <form method="POST" action="gestionMessages.php?id_tournoi={{ idTournoi }}" id="formMessage">
                <input type="hidden" name="action" value="envoyer_message">

                <div class="form-row">
                    <!-- Catégorie -->
                    <div class="form-group">
                        <label class="form-label" for="categorie_id">
                            <i class="bi bi-tag"></i> Catégorie
                        </label>
                        <select class="form-select" id="categorie_id" name="categorie_id">
                            <option value="">Toutes les catégories</option>
                            {% for cat in categories %}
                                <option value="{{ cat.id_categorie }}">{{ cat.Nom_categorie }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <!-- Poule -->
                    <div class="form-group">
                        <label class="form-label" for="poule_id">
                            <i class="bi bi-layer-group"></i> Poule
                        </label>
                        <select class="form-select" id="poule_id" name="poule_id">
                            <option value="">Toutes les poules</option>
                            {% for poule in poules %}
                                <option value="{{ poule.id }}" data-categorie="{{ poule.categorie_id }}">
                                    {{ poule.nom_categorie }} – {{ poule.nom }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <!-- Équipe -->
                    <div class="form-group">
                        <label class="form-label" for="equipe_id">
                            <i class="bi bi-person-badge"></i> Équipe
                        </label>
                        <select class="form-select" id="equipe_id" name="equipe_id">
                            <option value="">Toutes les équipes</option>
                            {% for equipe in equipes %}
                                <option value="{{ equipe.id }}"
                                        data-categorie="{{ equipe.categorie_id }}"
                                        data-poules="{{ equipe.poule_ids }}">
                                    {{ equipe.nom_categorie }} – {{ equipe.nom }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="scope-hint" id="scopeHint">
                    <i class="bi bi-info-circle"></i>
                    <span>Aucun filtre sélectionné : le message sera envoyé à <strong>toutes les équipes du tournoi</strong>.</span>
                </div>

                <div class="form-group">
                    <label class="form-label" for="contenu">
                        <i class="bi bi-chat-left-text"></i> Message
                    </label>
                    <textarea class="form-textarea" id="contenu" name="contenu" placeholder="Écrivez votre message ici…" required></textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-send-fill"></i> Envoyer le message
                </button>
            </form>
        </div>

        <!-- Historique des messages -->
        <div class="card">
            <div class="card-title">
                <i class="bi bi-clock-history"></i> Historique des messages envoyés
            </div>

            {% if historiqueMessages | length > 0 %}
                {% for msg in historiqueMessages %}
                    <div class="message-item">
                        <div class="message-top">
                            {% if msg.categorie_id %}
                                <span class="scope-pill scope-categorie">
                                    <i class="bi bi-tag-fill"></i> {{ msg.nom_categorie }}
                                </span>
                            {% elseif msg.poule_id %}
                                <span class="scope-pill scope-poule">
                                    <i class="bi bi-layer-group"></i> {{ msg.nom_categorie_poule }} – {{ msg.nom_poule }}
                                </span>
                            {% elseif msg.equipe_id %}
                                <span class="scope-pill scope-equipe">
                                    <i class="bi bi-person-badge-fill"></i> {{ msg.nom_categorie_equipe }} – {{ msg.nom_equipe }}
                                </span>
                            {% else %}
                                <span class="scope-pill" style="background: var(--text-muted);">
                                    <i class="bi bi-megaphone-fill"></i> Tout le tournoi
                                </span>
                            {% endif %}
                            <span class="message-date">{{ msg.date_creation|date('d/m/Y à H:i') }}</span>
                        </div>

                        <div class="message-content">{{ msg.contenu }}</div>

                        <div class="message-footer">
                            <span class="read-progress">
                                <i class="bi bi-eye-fill"></i>
                                {{ msg.nb_lu }} / {{ msg.nb_destinataires }} équipe(s) ont lu ce message
                            </span>
                            <div class="message-actions">
                                <a href="gestionMessages.php?id_tournoi={{ idTournoi }}&detail_message={{ msg.id }}" class="btn btn-outline">
                                    <i class="bi bi-people"></i> Voir le détail
                                </a>
                                <form method="POST" action="gestionMessages.php?id_tournoi={{ idTournoi }}" style="display:inline;">
                                    <input type="hidden" name="action" value="supprimer_message">
                                    <input type="hidden" name="message_id" value="{{ msg.id }}">
                                    <button type="submit" class="btn btn-danger"
                                            onclick="return confirm('Confirmer la suppression de ce message ?')">
                                        <i class="bi bi-trash"></i> Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>

                        {% if detailMessageId == msg.id and detailDestinataires is not null %}
                            <div style="margin-top: 16px; border-top: 1px solid var(--border); padding-top: 14px;">
                                <div style="font-size: .8rem; font-weight: 700; color: var(--primary); margin-bottom: 8px; text-transform: uppercase; letter-spacing: .08em;">
                                    Détail par équipe
                                </div>
                                {% for dest in detailDestinataires %}
                                    <div class="recipient-row">
                                        <span>{{ dest.nom_equipe }} <span style="color: var(--text-muted);">({{ dest.nom_club }})</span></span>
                                        {% if dest.statut == 'lu' %}
                                            <span class="status-badge status-lu">
                                                <i class="bi bi-check2-all"></i> Lu {% if dest.date_lu %}le {{ dest.date_lu|date('d/m H:i') }}{% endif %}
                                            </span>
                                        {% elseif dest.statut == 'recu' %}
                                            <span class="status-badge status-recu">
                                                <i class="bi bi-check2"></i> Reçu (non lu)
                                            </span>
                                        {% else %}
                                            <span class="status-badge status-non_recu">
                                                <i class="bi bi-dash-circle"></i> Pas encore vu
                                            </span>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            {% else %}
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <p>Aucun message envoyé pour le moment.</p>
                </div>
            {% endif %}
        </div>

    </div><!-- /.page-wrap -->

    <script>
    // Cascade : sélectionner une poule filtre/colore le choix équipe ;
    // sélectionner une catégorie filtre les poules et équipes proposées.
    // Les 3 sélecteurs restent indépendants au niveau du formulaire (un seul
    // sera réellement transmis comme "portée" — géré côté serveur), mais on
    // aide visuellement l'utilisateur en désactivant les choix incohérents.

    const categorieSelect = document.getElementById('categorie_id');
    const pouleSelect     = document.getElementById('poule_id');
    const equipeSelect    = document.getElementById('equipe_id');
    const scopeHint       = document.getElementById('scopeHint');

    function updateScopeHint() {
        const catText    = categorieSelect.options[categorieSelect.selectedIndex]?.text;
        const pouleText  = pouleSelect.options[pouleSelect.selectedIndex]?.text;
        const equipeText = equipeSelect.options[equipeSelect.selectedIndex]?.text;

        let html = '<i class="bi bi-info-circle"></i> <span>';

        if (equipeSelect.value) {
            html += `Le message sera envoyé uniquement à l'équipe <strong>${equipeText}</strong>.`;
        } else if (pouleSelect.value) {
            html += `Le message sera envoyé à toutes les équipes de la poule <strong>${pouleText}</strong>.`;
        } else if (categorieSelect.value) {
            html += `Le message sera envoyé à toutes les équipes de la catégorie <strong>${catText}</strong>.`;
        } else {
            html += `Aucun filtre sélectionné : le message sera envoyé à <strong>toutes les équipes du tournoi</strong>.`;
        }

        html += '</span>';
        scopeHint.innerHTML = html;
    }

    function filterPoulesByCategorie() {
        const catId = categorieSelect.value;
        Array.from(pouleSelect.options).forEach(opt => {
            if (!opt.value) return; // option "Toutes les poules"
            opt.hidden = catId !== '' && opt.dataset.categorie !== catId;
        });
        // Réinitialise la poule choisie si elle ne correspond plus à la catégorie
        if (pouleSelect.value && pouleSelect.options[pouleSelect.selectedIndex].hidden) {
            pouleSelect.value = '';
        }
    }

    function filterEquipesByCategorieOrPoule() {
        const catId   = categorieSelect.value;
        const pouleId = pouleSelect.value;

        Array.from(equipeSelect.options).forEach(opt => {
            if (!opt.value) return; // option "Toutes les équipes"
            const matchCategorie = catId === '' || opt.dataset.categorie === catId;
            const poules = (opt.dataset.poules || '').split(',');
            const matchPoule = pouleId === '' || poules.includes(pouleId);
            opt.hidden = !(matchCategorie && matchPoule);
        });
        if (equipeSelect.value && equipeSelect.options[equipeSelect.selectedIndex].hidden) {
            equipeSelect.value = '';
        }
    }

    categorieSelect.addEventListener('change', () => {
        // Choisir une catégorie efface le ciblage équipe/poule précédent
        pouleSelect.value = '';
        equipeSelect.value = '';
        filterPoulesByCategorie();
        filterEquipesByCategorieOrPoule();
        updateScopeHint();
    });

    pouleSelect.addEventListener('change', () => {
        equipeSelect.value = '';
        filterEquipesByCategorieOrPoule();
        updateScopeHint();
    });

    equipeSelect.addEventListener('change', updateScopeHint);

    filterPoulesByCategorie();
    filterEquipesByCategorieOrPoule();
    updateScopeHint();
    </script>
</body>
</html>
