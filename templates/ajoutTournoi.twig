<!DOCTYPE html>

<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Charger jQuery en premier -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Puis charger Bootstrap -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>

  
    <title>Gestion rencontre</title>
</head>
<body class="bg-light">
    {{ include('header.twig') }}

    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card shadow-lg">
                    <div class="card-header bg-primary text-white text-center">
                        <h4>Créer un Tournoi</h4>
                    </div>
                    <div class="card-body">
                        <form action="ajoutTournoi_traitement.php" method="post">
                            <div class="mb-3">
                                <label for="nomTournoi" class="form-label">Nom du tournoi</label>
                                <input type="text" class="form-control" name="nomTournoi" id="nomTournoi" placeholder="Ex: Tournoi d'été">
                            </div>

                            <div class="mb-3">
                                <label for="heuredebut" class="form-label">Heure de lancement</label>
                                <input type="time" class="form-control" name="heuredebut" id="heuredebut">
                            </div>

                            <div class="mb-3">
                                <label for="nbrterrain" class="form-label">Nombre de terrain(s)</label>
                                <input type="number" class="form-control" name="nbrterrain" id="nbrterrain" min="1" max="20" value="1">
                            </div>

                            <div class="mb-3">
                                <label for="PasHoraire" class="form-label">Durée d'une rencontre (en minutes)</label>
                                <input type="number" class="form-control" id="PasHoraire" name="pasHoraire" value="{{ infotournoi.pasHoraire }}">
                            </div>

                            <div class="mb-3">
                                <label for="dateTournoi" class="form-label">Date du tournoi</label>
                                <input type="date" class="form-control" id="dateTournoi" name="dateTournoi">
                            </div>

                            <button type="submit" class="btn btn-primary w-100 btn-lg">
                                <i class="fa-solid fa-check-circle"></i> Créer le tournoi
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.3/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.min.js"></script>
</body>
</html>
