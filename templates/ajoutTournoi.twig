<!DOCTYPE html>

<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Charger jQuery en premier -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Puis charger Bootstrap -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>

  
    <title>Gestion rencontre</title>
</head>
<body class="bg-light">
    {{ include('header.twig') }}

    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card shadow-lg">
                    <div class="card-header bg-primary text-white text-center">
                 
                    
                      <h4>{{ t('CreateTournament')}}</h4>
                    </div>
                    <div class="card-body">
                    
                     {% if tousLesTournois|length >= licence['0'].limite_tournois %}
                        <form action="" method="post">
                    {% else %}
                        <form action="ajoutTournoi_traitement.php" method="post">
                    {% endif %}
                  <div class="form-floating mb-3 position-relative">
                        <span class="position-absolute top-50 start-0 translate-middle-y ps-3 text-muted">
                            <i class="fa-solid fa-basketball-ball mt-4"></i> {# tu peux changer l'icône selon le sport #}
                        </span>
                        <select class="form-select ps-5" name="typeDeSport" id="typeDeSport" required>
                            <option value="" disabled selected> </option>
                            {% for sport in typeDeSport %}
                                <option value="{{ sport.id }}">{{ sport.nom }}</option>
                            {% endfor %}
                        </select>
                         <label for="typeDeSport">{{ t('typeDeSport') }}</label>
                        
                    </div>



                            <div class="mb-3 position-relative">
                                <span class="position-absolute top-50 start-0 translate-middle-y ps-3 text-muted">
                                    <i class="fa-solid fa-trophy"></i>
                                </span>
                                <input type="text" class="form-control ps-5" name="nomTournoi" id="nomTournoi" placeholder="{{ t('nameOfTournament') }}">
                            </div>


                            <div class="form-floating mb-3 position-relative">
                            <span class="position-absolute top-50 start-0 translate-middle-y ps-3 text-muted ">
                                <i class="fa-regular fa-clock mt-4"></i>
                            </span>
                            <input type="time" class="form-control ps-5" name="heuredebut" id="heuredebut" placeholder="{{ t('hourStart') }}">
                            <label for="heuredebut">{{ t('hourStart') }}</label>
                        </div>


                         <div class="form-floating mb-3 position-relative">
                        <span class="position-absolute top-50 start-0 translate-middle-y ps-3 text-muted">
                            <img src="img/football.png" alt="terrain" style="width:1.2em; height:1.2em;filter: grayscale(100%);" class="mt-4">
                        </span>
                        <input type="number" class="form-control ps-5" name="nbrterrain" id="nbrterrain" min="1" max="20" value="1" placeholder="{{ t('numberOfFields') }}">
                        <label for="nbrterrain">{{ t('numberOfFields') }}</label>
                    </div>



                            <div class="form-floating mb-3 position-relative">
                            <span class="position-absolute top-50 start-0 translate-middle-y ps-3 text-muted">
                                <i class="fa-regular fa-clock mt-4"></i> {# icône horloge pour la durée #}
                            </span>
                            <input type="number" class="form-control ps-5" 
                                id="PasHoraire" name="pasHoraire" 
                                value="{{ infotournoi.pasHoraire }}" 
                                
                                required>
                            <label for="PasHoraire">{{ t('dureeRencontre') }}</label>
                        </div>


                            <div class="form-floating mb-3 position-relative">
                            <span class="position-absolute top-50 start-0 translate-middle-y ps-3 text-muted">
                                <i class="fa-regular fa-calendar mt-3"></i>
                            </span>
                            <input type="date" class="form-control ps-5" 
                                id="dateTournoi" name="dateTournoi">
                            <label for="dateTournoi">{{ t('dateDuTournoi') }}</label>
                        </div>

                            
                             {% if tousLesTournois|length >= licence['0'].limite_tournois %}
                            <div class="alert alert-warning">
                                {{ t('limit_tournament_warning', {'%limit%': licence['0'].limite_tournois}) }}
                            </div>
                            {% else %}
                            <button type="submit" class="btn btn-primary w-100 btn-lg">
                                <i class="fa-solid fa-check-circle"></i> {{ t('createTournament') }}
                            </button>
                            {% endif %}
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.3/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.min.js"></script>
</body>
</html>
