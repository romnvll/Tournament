<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
         <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Ma licence</title>
</head>
<!-- Scripts à placer juste avant la balise </body> -->

<!-- jQuery d'abord -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Bootstrap JS ensuite -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- htmx (si tu l’utilises dans la page) -->
<script src="https://unpkg.com/htmx.org@latest/dist/htmx.min.js"></script>

<!-- Font Awesome (de préférence dans le <head>) -->
<script src="https://kit.fontawesome.com/0315b9fc45.js" crossorigin="anonymous"></script>

<body>
   {{ include('header.twig') }}

</body>


<div class="container mt-5">
    <h1 class="text-center mb-4">Ma licence</h1>
    <p class="text-center mb-4">Bienvenue sur votre page de licence. Vous pouvez consulter les détails de votre licence ci-dessous.</p>

    <div class="row">
    {% if licenceDetails %}
        <div class="col-md-12 mb-4">
            <div class="card shadow-sm p-4">
                <h5 class="text-center mb-3">Détails de votre licence</h5>
                <p><strong>Type de licence :</strong> {{ licenceDetails.type_licence|capitalize }}</p>
                <p><strong>Numéro de licence :</strong> {{ licenceDetails.licence_id }}</p>
                <p><strong>Date d'activation :</strong> {{ licenceDetails.date_debut|date('d/m/Y') }}</p>
                <p><strong>Date d'expiration :</strong> {% if licence.prix != 0 %}{{ licenceDetails.date_fin|date('d/m/Y') }} {% else %} Aucune  {% endif %}</p>
                <div class="mt-3 text-center text-success">{% if licence.prix != 0 %} Licence active pendant {{ jourRestant }} jours{% else %}   {% endif %}</div>

            </div>
        </div>
    {% else %}
        <div class="col-md-12 mb-4">
            <div class="alert alert-warning text-center">Vous n'avez pas de licence active.</div>
        </div>
    {% endif %}
    {% for licence in TypesDeLicences %}
 
    
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm p-4 h-100 {% if licence.nom == licenceDetails.type_licence %}border-primary border-3{% endif %}">
                <h5 class="text-center mb-3">
                    {{ licence.nom|capitalize }}
                    {% if licence.nom == licenceDetails.type_licence %}
                        <span class="badge bg-primary ms-2">En cours</span>
                    {% endif %}
                </h5>

                
                <p><strong>prix : </strong>{{ licence.prix }} €</p>
                    
                <p><strong>Limite de tournois :</strong> {{ licence.limite_tournois }}</p>
                <p><strong>Limite d'équipes (par tournoi) :</strong> {{ licence.limite_equipes }}</p>
                {% if licence.prix != 0 %}
                <p><strong>Durée de la licence :</strong> {{ licence.duree_jours }} jours</p>
                {% else %}
                <p><strong>Durée de la licence :</strong> Illimitée</p
                {% endif %}
                {% if licence.nom == licenceDetails.type_licence %}
                    {% if licence.prix == 0 %}
                        <p class="text-success">Licence gratuite </p>
                   {% else %}
                        <p class="text-success">{{ licenceDetails.date_fin|date('d/m/Y') }}</p>
                    {% endif %}
                {% else %}
                    <p class="text-danger">Licence inactive</p>
                {% endif %}
                
                {% if licence.prix > licenceDetails.prix %}
                    <form action="checkOut.php" method="POST" class="mt-3">
                        <input type="hidden" name="type_licence" value="{{ licence.nom }}">
                        <input type="hidden" name="limite_tournois" value="{{ licence.limite_tournois }}">
                        <input type="hidden" name="limite_equipes" value="{{ licence.limite_equipes }}">
                        <input type="hidden" name="idUtilisateur" value="{{ idUtilisateur }}">
                        
                        <button type="submit" class="btn btn-outline-primary w-100">Choisir cette licence</button>
                    </form>
                {% endif %}
                
            </div>
        </div>
    {% endfor %}
</div>

</div>



</html>
