<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gérer les Labels</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://unpkg.com/htmx.org@2.0.4" integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+" crossorigin="anonymous"></script>
</head>
<body class="container py-4">
  <h1 class="mb-4">Gérer les Labels</h1>

  <!-- Affichage des messages -->
  {% if error is not null %}
    <div class="alert alert-danger" role="alert">
      {{ error }}
    </div>
  {% endif %}

  {% if message is not null %}
    <div class="alert alert-success" role="alert">
      {{ message }}
    </div>
  {% endif %}

  <!-- Formulaire pour ajouter un label -->
  <div class="card mb-4">
    <div class="card-body">
      <h2 class="card-title">Ajouter un Label</h2>
      <form method="GET" action="GererLabels.php">
        <div class="mb-3">
          <label for="description" class="form-label">Description : (touche windows + ; pour une icône)</label>
          <input type="text" id="description" name="description" class="form-control" required>
        </div>
        <div class="mb-3">
  <label for="couleur" class="form-label">Couleur :</label>
  <div class="d-flex flex-wrap gap-2">
    <label>
      <input type="radio" name="couleur" value="#000000" required checked>
      <span class="d-inline-block rounded-circle" style="background-color:rgb(0, 0, 0); width: 30px; height: 30px; border: 1px solid #ccc;"></span>
    </label>
    <label>
      <input type="radio" name="couleur" value="#FFB3BA" required>
      <span class="d-inline-block rounded-circle" style="background-color: #FFB3BA; width: 30px; height: 30px; border: 1px solid #ccc;"></span>
    </label>
    <label>
      <input type="radio" name="couleur" value="#FFDFBA" required>
      <span class="d-inline-block rounded-circle" style="background-color: #FFDFBA; width: 30px; height: 30px; border: 1px solid #ccc;"></span>
    </label>
    <label>
      <input type="radio" name="couleur" value="#FFFFBA" required>
      <span class="d-inline-block rounded-circle" style="background-color: #FFFFBA; width: 30px; height: 30px; border: 1px solid #ccc;"></span>
    </label>
    <label>
      <input type="radio" name="couleur" value="#BAFFC9" required>
      <span class="d-inline-block rounded-circle" style="background-color: #BAFFC9; width: 30px; height: 30px; border: 1px solid #ccc;"></span>
    </label>
    <label>
      <input type="radio" name="couleur" value="#BAE1FF" required>
      <span class="d-inline-block rounded-circle" style="background-color: #BAE1FF; width: 30px; height: 30px; border: 1px solid #ccc;"></span>
    </label>
  </div>
</div>

        <input type="hidden" name="id_tournoi" value="{{ tournoi_id }}">
        <input type="hidden" name="action" value="addLabel">
        <button type="submit" class="btn btn-primary">Ajouter</button>
      </form>
    </div>
  </div>

  <!-- Liste des labels -->
  <h2>Liste des Labels</h2>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th scope="col">Description</th>
        <th scope="col">Couleur</th>
        <th scope="col">Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for label in labels %}
        <tr>
          <td>
          <input 
            type="text" 
            name="description" 
            value="{{ label.description }}" 
            hx-post="GererLabels.php" 
            hx-trigger="change"
            hx-vals='{"labelId": "{{ label.label_id }}", "labelModif": true, "couleur": "{{ label.couleur }}"}'
          >
        </td>
          <td>
            <span style="background-color: {{ label.couleur }}; display: inline-block; width: 20px; height: 20px; border-radius: 50%;"></span>
          </td>
          <td>
            <a href="GererLabels.php?action=delLabel&labelId={{ label.label_id }}" 
               class="btn btn-danger btn-sm" 
               onclick="return confirm('Supprimer ce label ?');">
              Supprimer
            </a>
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
<a href="{{urlRetour}}">Retour</a>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>