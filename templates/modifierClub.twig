<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous" />
  <!-- Inclure la bibliothèque htmx via CDN -->
  <script src="https://unpkg.com/htmx.org@latest/dist/htmx.min.js"></script>

  <title>Modifier Club</title>
  <style>
    .card {
      /* Ajout d'une ombre pour un effet de relief */
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      transition: box-shadow 0.3s ease-in-out;
    }

    .card:hover {
      /* Ombre plus marquée au survol pour un effet interactif */
      box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
    }

    .img-thumbnail {
      /* Taille uniforme pour les logos */
      width: 100px;
      height: 100px;
      object-fit: cover;
    }
  </style>
</head>

<body>
  {{ include('header.twig') }}

  <div class="container mt-5">
    <div class="row">

      {% if idClub is not null %}
      <div class="col-12 col-md-6">
        <div class="card">
          <div class="card-header">
            <h5 class="card-title">Modifier Club</h5>
          </div>
          <div class="card-body">
            <form action="modifierClub_traitement.php" method="POST" enctype="multipart/form-data">
              <input type="hidden" name="idclub" value="{{ idClub }}">
            
            <div class="mb-3">
    <label for="typeSport" class="form-label">Type de sport</label>
    <select class="form-select" id="typeSport" name="typeSport" required>
        <option value="" disabled>-- Choisir un type de sport --</option>
        {% for type in listeSports %}
            <option value="{{ type.id }}"
                {% if type.id == afficheclub.type_sport_id %}selected{% endif %}>
                {{ type.nom }}
            </option>
        {% endfor %}
    </select>
</div>



              <div class="mb-3">
                <label for="nomduclub" class="form-label">Nom du club</label>
                <input type="text" class="form-control" name="nomduclub" id="nomduclub" placeholder="Nom du club"
                  {% if isModify == true %} value="{{ afficheclub.nom }}" {% endif %} />
              </div>
              
             

              <div class="mb-3">
                <label for="logo" class="form-label">Logo du club</label>
                <input type="file" class="form-control" name="logo" id="logo" />
              </div>

              <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-2"></i> Sauvegarder
              </button>
            </form>
          </div>
        </div>
      </div>
      {% endif %}

      <div class="col-12 col-md-6">
        <h3>Liste des Clubs</h3>
        <table class="table table-bordered table-striped">
          <thead>
            <tr>
              <th scope="col">Nom</th>
              <th scope="col">Logo</th>
              <th scope="col">Sport</th>
            </tr>
          </thead>
          <tbody>
            
            {% for club in ListeDesClubs %}
            <tr>
              <td>
                {% if idUser == club.utilisateur_id %}
                
                  <a class="btn btn-success" href="modifierClub.php?idclub={{ club.id }}">
                    <i class="fas fa-edit"></i> {{ club.nom }}
                  </a>
                {% else %}

               
                  <button type="button" class="btn btn-secondary" disabled>
                    <i class="fas fa-lock"></i> {{ club.nom }} créé a été par un autre utilisateur
                  </button>
                    
                 
                {% endif %}
              </td>
              <td>
                <img src="{{ club.logo }}" alt="Logo {{ club.nom }}" class="img-thumbnail" />
              </td>

              <td>
                {% if club.nom_type_sport %}
                  <span class="badge bg-primary">{{ club.nom_type_sport }}</span>
                {% else %}
                  <span class="badge bg-secondary">Non spécifié</span>
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

    </div>
  </div>

  <script src="https://kit.fontawesome.com/a076d05399.js"></script> <!-- FontAwesome for icons -->
</body>

</html>
