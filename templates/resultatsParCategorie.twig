<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<link
		href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous"/>

		<!-- Inclure la bibliothèque htmx via CDN -->
		<script src="https://unpkg.com/htmx.org@latest/dist/htmx.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

		<title>Gestion rencontre</title>
	</head>
	<body>

		{{ include('header.twig') }}

		<div class="container">
			<div class="row">
				<div class="col">
					{% for tournoi in afficherLesTournois %}
						{% if tournoi.isArchived == 0 %}
							{% if tournoi.id == idTournoi %}
								<a href="resultatsParCategorie.php?id_tournoi={{ tournoi.id }}" class="btn btn-success btn-lg">{{ tournoi.nom }}</a>
							{% else %}
								<a href="resultatsParCategorie.php?id_tournoi={{ tournoi.id }}" class="btn btn-secondary">{{ tournoi.nom }}
								</a>
							{% endif %}
						{% endif %}
					{% endfor %}
			    </div>
            </div>

            <div class="row">
			<div class="container mt-4">
    {% for categorie in classementParCategorie %}
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Catégorie : {{ categorie.categorie_nom }}</h5>
            </div>
            <div class="card-body">
                {% if categorie.equipes is not empty %}
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover text-center align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Équipe</th>
                                    <th><i class="bi bi-bar-chart-line"></i> Joués</th>
                                    <th><i class="bi bi-trophy-fill text-success"></i> Gagnés</th>
                                    <th><i class="bi bi-handshake text-primary"></i> Nuls</th>
                                    <th><i class="bi bi-x-circle text-danger"></i> Défaites</th>
                                    <th><i class="bi bi-emoji-sunglasses"></i> Buts</th>
                                    <th><i class="bi bi-shield-fill-exclamation text-warning"></i> Encaissés</th>
                                    <th><i class="bi bi-award-fill text-warning"></i> Points</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for equipe in categorie.equipes %}
                                    <tr>
                                        <td>{{ loop.index }}</td>
                                        <td>{{ equipe.nom }}</td>
                                        <td>{{ equipe.matchsJoues }}</td>
                                        <td>{{ equipe.rencontresGagnees }}</td>
                                        <td>{{ equipe.matchsNuls }}</td>
                                        <td>{{ equipe.matchsPerdus }}</td>
                                        <td>{{ equipe.nombreButsMarque }}</td>
                                        <td>{{ equipe.nombreButsEncaisse }}</td>
                                        <td><strong>{{ equipe.TotalDesPoints }}</strong></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="alert alert-warning mb-0" role="alert">
                        Aucune équipe classée pour cette catégorie.
                    </div>
                {% endif %}
            </div>
        </div>
    {% endfor %}
</div>


            </div>

				
		</div>

			
			
		