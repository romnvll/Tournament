<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Panneau d'administration</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container mt-4">
    <h1 class="mb-4">Panneau d'administration</h1>
    <p class="text-muted">Connecté en tant que <strong>{{ user.nom }}</strong> ({{ user.role }})</p>

    <!-- Utilisateurs -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">Utilisateurs</div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th>last connexion</th>
                    </tr>
                </thead>
                <tbody>
                {% for u in utilisateurs %}
                    <tr>
                        <td>{{ u.id }}</td>
                        <td>{{ u.nom }}</td>
                        <td>{{ u.email }}</td>
                        <td>{{ u.role }}</td>
                        <td>{{ u.dernier_login ?? '—' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="text-center">Aucun utilisateur trouvé</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Tournois en cours -->
    <div class="card mb-4">
        <div class="card-header bg-success text-white">Tournois en cours</div>
        <div class="card-body">
            {% if tournoisEnCours|length > 0 %}
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom tu tournoi</th>
                            <th>Date début</th>
                            <th>Créé par (email)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for t in tournoisEnCours %}
                            <tr>
                                <td>{{ t.id }}</td>
                                <td>{{ t.nom }}</td>
                                <td>{{ t.dateDebut }}</td>
                                <td> {{ t.email_utilisateur }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p>Aucun tournoi en cours.</p>
            {% endif %}
        </div>
    </div>

    <!-- Licences -->
    <div class="card mb-4">
        <div class="card-header bg-warning text-dark">Licences</div>
        <div class="card-body">
            {% if licences|length > 0 %}
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID Licence</th>
                            <th>Utilisateur</th>
                            <th>Email</th>
                            <th>Type</th>
                            <th>Date début</th>
                            <th>Date fin</th>
                            <th>Prix</th>
                            <th>Limite tournois</th>
                            <th>Limite équipes</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for l in licences %}
                            <tr>
                                <td>{{ l.licence_id }}</td>
                                <td>{{ l.nom_utilisateur }}</td>
                                <td>{{ l.email_utilisateur }}</td>
                                <td>{{ l.type_licence }}</td>
                                <td>{{ l.date_debut }}</td>
                                <td>{{ l.date_fin ?? '—' }}</td>
                                <td>{{ l.prix }} €</td>
                                <td>{{ l.limite_tournois }}</td>
                                <td>{{ l.limite_equipes }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p>Aucune licence trouvée.</p>
            {% endif %}
        </div>
    </div>

</div>

</body>
</html>
