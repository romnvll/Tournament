ALTER TABLE Planification DROP FOREIGN KEY Planification_ibfk_5;
ALTER TABLE Planification DROP COLUMN arbitre_id;

CREATE TABLE Planification_Arbitres (
    planification_id INT NOT NULL,
    arbitre_id       INT NOT NULL,
    role             VARCHAR(50) DEFAULT NULL,
    PRIMARY KEY (planification_id, arbitre_id),
    FOREIGN KEY (planification_id) REFERENCES Planification(planification_id),
    FOREIGN KEY (arbitre_id)       REFERENCES Arbitres(arbitre_id)
);
